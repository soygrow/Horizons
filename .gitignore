# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
**/.next/
**/out/

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars
.dev.vars.*

# 采集产物：官网截图落在 apps/site/public/screenshots，但**不入库**。
# 线上由 apps/site/src/worker.ts 从 R2（桶 horizons-archive）读取，
# URL 仍是 /screenshots/<domain>.png；本地文件仅供开发和人工核对。
# 上传用 scripts/admin/upload-screenshots-r2.ts。
apps/site/public/screenshots/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.ph-token.json

# typescript
*.tsbuildinfo
next-env.d.ts

# 采集缓存与本地快照（体积大、可重建，不入库）
content/cache/
content/backup/

# 前端派生数据（由 scripts/build/web-data.mjs 生成）
content/github-web.json

# AI 工具榜：唯一真源是 D1 的当前版本快照（board_listed + board_listed_details）。
# 这里的文件只是构建缓存，每次 `pnpm data` 由 scripts/admin/hydrate-tools.ts
# 从库里还原，不入库 —— 否则后台改库与仓库文件会变成两份会分叉的真源。
content/aitools.json
# 发布脚本写给 CI 的报告（判断要不要重建站点），不是数据
content/tools-publish.json

# 趋势词榜：同上，唯一真源是 D1 的当前版本快照（board_listed 含 variant_of 别名）。
# 每次 `pnpm data` 由 scripts/admin/hydrate-trends.ts 还原，不入库。
# 注意 content/trends-policy.json 仍然入库：那是采集侧的准入判定账本，不是榜单数据。
content/trends.json

# Astro 静态站（apps/site）构建产物与类型缓存
apps/site/dist/
apps/site/.astro/

# 本地部署运行态（pnpm local 的日志与 pid）
.local/

# 榜单产物（由 scripts/build/artifacts.ts 生成，pnpm deploy 时自动重算）
content/dist/
apps/site/public/data/

# 本地 MCP 配置（含 Paddle API 密钥，绝不入库）
.mcp.json
.codebuddy/mcp.json
.codebuddy/mcp.json*

# D1 线上备份（含真实用户数据，绝不入库）
apps/api/backup-*.sql
