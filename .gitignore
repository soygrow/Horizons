# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
**/.next/
**/out/

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars
.dev.vars.*

# 采集产物：官网截图落在 apps/site/public/screenshots，但**不入库**。
# 线上由 apps/site/src/worker.ts 从 R2（桶 horizons-archive）读取，
# URL 仍是 /screenshots/<domain>.png；本地文件仅供开发和人工核对。
# 上传用 scripts/admin/upload-screenshots-r2.ts。
apps/site/public/screenshots/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
.ph-token.json

# typescript
*.tsbuildinfo
next-env.d.ts

# 采集缓存与本地快照（体积大、可重建，不入库）
content/cache/
content/backup/

# 前端派生数据（由 scripts/build/web-data.mjs 生成）
content/github-web.json

# Astro 静态站（apps/site）构建产物与类型缓存
apps/site/dist/
apps/site/.astro/

# 本地部署运行态（pnpm local 的日志与 pid）
.local/

# 榜单产物（由 scripts/build/artifacts.ts 生成，pnpm deploy 时自动重算）
content/dist/
apps/site/public/data/

# 本地 MCP 配置（含 Paddle API 密钥，绝不入库）
.mcp.json
.codebuddy/mcp.json
.codebuddy/mcp.json*

# D1 线上备份（含真实用户数据，绝不入库）
apps/api/backup-*.sql
