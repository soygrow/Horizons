{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizons-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "horizons.tools/api/*",
      "zone_name": "horizons.tools"
    }
  ],
  // 非敏感配置；密钥用 `wrangler secret put` 写（PADDLE_API_KEY / PADDLE_WEBHOOK_SECRET /
  // PADDLE_PRICE_MONTH / PADDLE_PRICE_YEAR）。切正式环境把 PADDLE_ENV 改成 production。
  "vars": {
    "PADDLE_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horizons-db",
      "database_id": "355e5cca-29ca-4b37-90a5-6c88d94e7a4b",
      "migrations_dir": "migrations"
    }
  ],
  // 对象存储：readme 全文 / 原始采集响应 / 每周 D1 导出
  // 桶保持私有，只能通过 ARCHIVE binding 访问，不要开 Public Access
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "horizons-archive"
    }
  ]
}
