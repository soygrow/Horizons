{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizons-site",
  // 截图已迁到 R2（桶 horizons-archive），Worker 拦截 /screenshots/* 从桶里取，
  // 其余请求原样交给静态资产。数据里的路径仍是 /screenshots/<domain>.png，未改动。
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  // 2026-10-29 切换：新站接管主域，旧 Next 站（horizons-web）不再持有该路由
  "routes": [
    {
      "pattern": "horizons.tools/*",
      "zone_name": "horizons.tools"
    }
  ],
  "assets": {
    "directory": "./dist",
    // 保持与现有站一致的 URL 形态（无尾斜杠，不做 301）
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // 必须让 Worker 先接这两类路径，静态资产一旦命中就不会再走到 Worker：
    //   /screenshots/*  dist 里可能还留着历史截图，不走 Worker 就永远读不到 R2
    //   /preview/*      未发布的预览页，Worker 里校验管理员 session 后才放行
    "run_worker_first": ["/screenshots/*", "/preview/*"]
  },
  // 只读 admin_sessions 做预览页鉴权（和 apps/api 同一个库、同一张表）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horizons-db",
      "database_id": "355e5cca-29ca-4b37-90a5-6c88d94e7a4b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "horizons-archive"
    }
  ]
}