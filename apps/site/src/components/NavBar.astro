---
const channels = [
  { label: "AI工具榜", href: "/tools" },
  { label: "GitHub榜", href: "/github" },
  { label: "AI模型榜", href: "/models" },
  { label: "AI趋势词榜单", href: "/trends" },
  { label: "机会榜", href: "/opportunity", isNew: true },
  { label: "每日情报", href: "/daily" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-canvas/90 backdrop-blur">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px opacity-40"
    style="background-image: var(--brand-gradient);">
  </div>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-2" aria-label="Horizons.tools 首页">
        <img
          src="/brand/mark.png"
          alt=""
          width="239"
          height="112"
          class="h-7 w-auto transition-transform duration-200 group-hover:scale-[1.04]"
        />
        <span class="text-base font-semibold tracking-tight text-ink"
          >Horizons<span class="hidden text-ink-muted sm:inline">.tools</span></span
        >
      </a>

      <nav class="hidden items-center gap-1 lg:flex">
        {channels.map((c) => (
          <a
            href={c.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm transition",
              path.startsWith(c.href)
                ? "bg-surface-2 text-ink"
                : "text-ink-secondary hover:bg-surface-2 hover:text-ink",
            ]}
          >
            <span class="flex items-center gap-1.5">
              {c.label}
              {c.isNew && (
                <span class="rounded bg-primary-soft px-1 py-px text-[9px] font-semibold leading-[1.4] text-primary">
                  NEW
                </span>
              )}
            </span>
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-ink-secondary transition hover:text-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 3.78a1 1 0 010 1.41l-.71.71a1 1 0 11-1.41-1.41l.7-.71a1 1 0 011.42 0zM18 9a1 1 0 110 2h-1a1 1 0 110-2h1zM10 6a4 4 0 100 8 4 4 0 000-8zm-6.51 8.09a1 1 0 011.41 0l.71.71a1 1 0 11-1.41 1.41l-.71-.7a1 1 0 010-1.42zM10 16a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM4.51 3.51a1 1 0 010 1.41l-.7.71A1 1 0 012.4 4.22l.7-.71a1 1 0 011.41 0z" />
        </svg>
      </button>

      <a
        href="/account"
        class="rounded-lg border border-border px-3 py-2 text-sm text-ink-secondary transition hover:text-ink"
      >
        登录
      </a>

      <a
        href="/#submit"
        class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white transition hover:bg-primary-hover"
      >
        提交产品
      </a>
    </div>
  </div>

  <!-- 移动端频道入口：PC 导航在 lg 以下隐藏，这里保证手机上也能进「每日情报」 -->
  <div class="border-t border-border/60 lg:hidden">
    <nav
      aria-label="频道"
      class="mx-auto flex max-w-7xl items-center gap-1 overflow-x-auto px-4 py-1.5 sm:px-6"
    >
      {channels.map((c) => (
        <a
          href={c.href}
          class:list={[
            "flex shrink-0 items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-[13px] transition",
            path.startsWith(c.href) ? "bg-surface-2 text-ink" : "text-ink-secondary",
          ]}
        >
          {c.label}
          {c.isNew && (
            <span class="rounded bg-primary-soft px-1 py-px text-[9px] font-semibold leading-[1.4] text-primary">
              NEW
            </span>
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var KEY = "theme";
    var btn = document.getElementById("theme-toggle");
    var root = document.documentElement;
    btn &&
      btn.addEventListener("click", function () {
        var next = root.classList.contains("dark") ? "light" : "dark";
        root.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem(KEY, next);
        } catch (e) {}
      });
  })();
</script>