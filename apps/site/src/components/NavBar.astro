---
import LoginDialog from "./LoginDialog.astro";

const channels = [
  { label: "机会榜", href: "/opportunity", isNew: true },
  { label: "AI工具榜", href: "/tools" },
  { label: "GitHub榜", href: "/github" },
  { label: "AI趋势词榜", href: "/trends" },
  { label: "AI模型榜", href: "/models" },
  { label: "每日情报", href: "/daily" },
  { label: "定价", href: "/pricing" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-canvas/90 backdrop-blur">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px opacity-40"
    style="background-image: var(--brand-gradient);">
  </div>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <div class="flex min-w-0 flex-1 items-center gap-4 sm:gap-6 lg:gap-9">
      <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="Horizons.tools 首页">
        <img
          src="/brand/mark.png"
          alt=""
          width="239"
          height="112"
          class="h-7 w-auto transition-transform duration-200 group-hover:scale-[1.04]"
        />
        <span class="text-base font-semibold tracking-tight text-ink"
          >Horizons<span class="hidden text-ink-muted sm:inline">.tools</span></span
        >
      </a>

      <nav class="hidden items-center gap-2 xl:flex">
        {channels.map((c) => (
          <a
            href={c.href}
            class:list={[
              "whitespace-nowrap rounded-lg px-3 py-2 text-[15px] transition",
              path.startsWith(c.href)
                ? "bg-surface-2 text-ink"
                : "text-ink-secondary hover:bg-surface-2 hover:text-ink",
            ]}
          >
            <span class="flex items-center gap-1.5">
              {c.label}
              {c.isNew && (
                <span class="rounded bg-primary-soft px-1 py-px text-[9px] font-semibold leading-[1.4] text-primary">
                  新
                </span>
              )}
            </span>
          </a>
        ))}
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-ink-secondary transition hover:text-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4.22 3.78a1 1 0 010 1.41l-.71.71a1 1 0 11-1.41-1.41l.7-.71a1 1 0 011.42 0zM18 9a1 1 0 110 2h-1a1 1 0 110-2h1zM10 6a4 4 0 100 8 4 4 0 000-8zm-6.51 8.09a1 1 0 011.41 0l.71.71a1 1 0 11-1.41 1.41l-.71-.7a1 1 0 010-1.42zM10 16a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM4.51 3.51a1 1 0 010 1.41l-.7.71A1 1 0 012.4 4.22l.7-.71a1 1 0 011.41 0z" />
        </svg>
      </button>

      <!-- 未登录：打开登录弹窗；已登录时由 nav-auth 换成下面的头像入口 -->
      <a
        id="nav-login"
        href="/account"
        data-login-open
        class="whitespace-nowrap rounded-lg border border-border px-3.5 py-2 text-[15px] text-ink-secondary transition hover:text-ink"
      >
        登录
      </a>

      <!-- 已登录：头像 + 用户名，点击进账户页（默认隐藏，避免静态产物泄露登录态） -->
      <a
        id="nav-user"
        href="/account"
        hidden
        class="flex items-center gap-2 rounded-lg border border-border p-1 transition hover:bg-surface-2 sm:py-1.5 sm:pl-1.5 sm:pr-2.5"
      >
        <span
          id="nav-user-avatar"
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-white"
        ></span>
        <span
          id="nav-user-name"
          class="hidden max-w-[8rem] truncate text-[15px] text-ink sm:inline"
        ></span>
      </a>
    </div>
  </div>

  <!-- 移动端频道入口：PC 导航在 xl 以下隐藏，这里保证窄屏也能进全部频道 -->
  <div class="border-t border-border/60 xl:hidden">
    <nav
      aria-label="频道"
      class="mx-auto flex max-w-7xl items-center gap-1 overflow-x-auto px-4 py-1.5 sm:px-6"
    >
      {channels.map((c) => (
        <a
          href={c.href}
          class:list={[
            "flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm transition",
            path.startsWith(c.href) ? "bg-surface-2 text-ink" : "text-ink-secondary",
          ]}
        >
          {c.label}
          {c.isNew && (
            <span class="rounded bg-primary-soft px-1 py-px text-[9px] font-semibold leading-[1.4] text-primary">
              新
            </span>
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- 登录弹窗：全站只此一份，导航上的「登录」与页面内 [data-login-open] 共用 -->
<LoginDialog />

<script>
  import { initNavAuth } from "../scripts/nav-auth";
  initNavAuth();
</script>

<script is:inline>
  (function () {
    var KEY = "theme";
    var btn = document.getElementById("theme-toggle");
    var root = document.documentElement;
    btn &&
      btn.addEventListener("click", function () {
        var next = root.classList.contains("dark") ? "light" : "dark";
        root.classList.toggle("dark", next === "dark");
        try {
          localStorage.setItem(KEY, next);
        } catch (e) {}
      });
  })();
</script>