---
/**
 * 首页「机会引擎」：解释机会怎么被算出来，不展示具体机会条目。
 * 五路信号 → 汇流母线 → Horizons 内核 → 一条机会的骨架。
 * 纯 CSS 动画，无脚本、无外部依赖。
 */
interface Props {
  tools: number;
  repos: number;
  trends: number;
  models: number;
}

const { tools, repos, trends, models } = Astro.props;

/**
 * 五路信号：颜色彼此拉得开（蓝 / 紫 / 琥珀 / 青 / 绿），
 * 流动光点用同一色，速度各不相同，看起来像真的在并行推送。
 */
const inputs = [
  { label: "AI 工具榜", value: String(tools), unit: "个工具", href: "/tools", color: "#0866fa", dur: "1.4s", delay: "0s" },
  { label: "GitHub 榜", value: String(repos), unit: "个仓库", href: "/github", color: "#703ff4", dur: "2.0s", delay: "0.4s" },
  { label: "趋势词榜", value: String(trends), unit: "个词", href: "/trends", color: "#f0a020", dur: "1.6s", delay: "0.85s" },
  { label: "AI 模型榜", value: String(models), unit: "个模型", href: "/models", color: "#0ea5c4", dur: "2.4s", delay: "0.2s" },
  { label: "每日情报", value: "每天", unit: "", href: "/daily", color: "#17a34a", dur: "1.8s", delay: "0.6s" },
];

/** 输出侧只给结构：让读者知道一条机会里有什么，而不是现在就替他们决定 */
const outputs = [
  { key: "bolt", text: "为什么现在成立" },
  { key: "who", text: "谁已经卡在这条路上" },
  { key: "start", text: "第一周先做什么" },
  { key: "stop", text: "什么条件下放弃" },
];
---

<section
  class="relative mt-14 overflow-hidden rounded-2xl border border-border bg-surface sm:mt-16"
  aria-labelledby="opp-engine-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(78%_58%_at_10%_-8%,rgba(8,102,250,0.09),transparent)]"
  >
  </div>

  <div class="relative px-5 pt-7 sm:px-8 sm:pt-9">
    <!-- 眉标：同心弧图标呼应品牌穹顶，比一个圆点更有辨识度 -->
    <span
      class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/[0.06] py-1 pl-2 pr-2.5"
    >
      <svg
        class="h-3.5 w-3.5 text-primary"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <circle cx="12" cy="12" r="5.2"></circle>
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
      </svg>
      <span class="text-[11.5px] font-semibold tracking-[0.06em] text-primary">机会引擎</span>
    </span>

    <h2
      id="opp-engine-title"
      class="mt-3.5 max-w-2xl text-[1.3rem] font-bold leading-[1.4] tracking-tight text-ink sm:text-[1.7rem]"
    >
      一张榜是热闹，几张榜叠起来才是窗口
    </h2>
    <p class="mt-2.5 max-w-2xl text-[13px] leading-[1.8] text-ink-secondary sm:text-sm">
      工具、仓库、趋势词、模型，任何一张单独看都是噪音。叠在一起还同时发亮的那一处，才是窗口。
    </p>
  </div>

  <!-- 数据流：lg 一行五段横铺，小屏竖排 -->
  <div
    class="relative mt-7 grid gap-y-4 px-5 sm:px-8 lg:mt-9 lg:grid-cols-[224px_48px_88px_48px_260px_28px_132px] lg:items-center lg:justify-center lg:gap-y-0 xl:grid-cols-[250px_48px_92px_48px_292px_28px_152px]"
  >
    <!-- 技术底纹：极淡网格，向四周淡出 -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background-image: linear-gradient(to right, var(--c-border) 1px, transparent 1px), linear-gradient(to bottom, var(--c-border) 1px, transparent 1px); background-size: 30px 30px; opacity: 0.75; mask-image: radial-gradient(62% 74% at 50% 50%, black, transparent 80%); -webkit-mask-image: radial-gradient(62% 74% at 50% 50%, black, transparent 80%);"
    >
    </div>

    <ul class="relative flex flex-wrap justify-center gap-2 lg:flex-col lg:flex-nowrap lg:justify-start lg:gap-1.5">
      {
        inputs.map((it) => (
          <li
            class="chip-line relative flex w-[calc(50%-0.25rem)] items-center justify-between gap-2 rounded-lg border border-border bg-surface px-3 py-2 sm:w-[calc(33.333%-0.375rem)] lg:w-full lg:px-3.5 lg:py-2.5"
            style={`--dot:${it.color}`}
          >
            <a href={it.href} class="flex min-w-0 items-center gap-2 transition hover:text-primary">
              <span
                aria-hidden="true"
                class="h-1.5 w-1.5 shrink-0 rounded-full"
                style={`background:${it.color}; box-shadow:0 0 7px ${it.color}66`}
              />
              <span class="truncate text-[11.5px] font-medium text-ink-secondary">{it.label}</span>
            </a>
            <!-- 小屏用虚线把名称与条数接起来；宽屏靠两端对齐 -->
            <span
              aria-hidden="true"
              class="mx-1 h-px min-w-2 flex-1 border-t border-dashed border-border-strong lg:hidden"
            />
            <span class="shrink-0 font-mono text-[11.5px] tabular-nums text-ink">
              {it.value}
              {it.unit && <span class="ml-0.5 hidden text-[10px] text-ink-muted sm:inline">{it.unit}</span>}
            </span>
            <!-- 光点从方块右沿顺着连接线汇入母线，颜色与本条信号一致 -->
            <span
              aria-hidden="true"
              class="flow dot-lane absolute right-0 top-1/2 hidden h-1.5 w-1.5 rounded-full lg:block"
              style={`--dot:${it.color}; animation-duration:${it.dur}; animation-delay:${it.delay};`}
            />
          </li>
        ))
      }
    </ul>

    <!-- 汇流母线：五路并到一条竖线上，再横向送入内核 -->
    <div class="relative hidden self-stretch lg:block">
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-[24px] w-[2px] rounded-full bg-gradient-to-b from-transparent via-primary/55 to-transparent"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-[24px] top-1/2 h-[2px] w-[24px] rounded-full bg-gradient-to-r from-primary/30 to-primary/70"
      ></span>
    </div>

    <!-- 内核：用 Horizons 自己的标记，而不是一个 AI 字样 -->
    <div class="relative mx-auto grid h-[88px] w-[88px] place-items-center xl:h-[92px] xl:w-[92px]">
      <span aria-hidden="true" class="core-glow absolute -inset-1 rounded-full"></span>
      <span aria-hidden="true" class="spin-slow absolute inset-0 rounded-full border border-dashed border-primary/30"
      ></span>
      <div
        class="relative grid h-[66px] w-[66px] place-items-center overflow-hidden rounded-full border border-primary/20 bg-surface xl:h-[68px] xl:w-[68px]"
      >
        <span
          aria-hidden="true"
          class="spin-slow absolute inset-[-40%] bg-[conic-gradient(from_0deg,transparent_0deg,rgba(8,102,250,0.20)_60deg,transparent_120deg)]"
        ></span>
        <img
          src="/brand/mark.png"
          alt=""
          width="239"
          height="112"
          class="relative h-[24px] w-auto xl:h-[26px]"
          loading="lazy"
        />
      </div>
      <span
        class="pointer-events-none absolute -bottom-7 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-surface px-2 text-[10px] tracking-[0.08em] text-ink-muted lg:block"
        >Horizons 引擎</span
      >
    </div>

    <!-- 内核 → 输出 -->
    <div class="relative flex h-6 items-center justify-center lg:h-[88px] lg:w-[48px] xl:h-[92px]">
      <span aria-hidden="true" class="absolute h-full w-px bg-gradient-to-b from-primary/60 via-primary/30 to-transparent lg:hidden"></span>
      <span aria-hidden="true" class="flow dot-down absolute h-1.5 w-1.5 rounded-full bg-primary lg:hidden"></span>
      <span aria-hidden="true" class="absolute hidden h-[2px] w-full rounded-full bg-gradient-to-r from-[#e0478a]/55 to-[#e0478a]/25 lg:block"></span>
      <span aria-hidden="true" class="flow dot-right absolute hidden h-1.5 w-1.5 rounded-full bg-[#e0478a] lg:block"></span>
    </div>

    <!-- 输出：一条机会的骨架 -->
    <div class="relative overflow-hidden rounded-xl border border-primary/25 bg-surface">
      <!-- 左侧品牌渐变边：与 logo 穹顶同源，标记这是「产物」 -->
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 w-[3px]"
        style="background-image: var(--brand-gradient)"></span>

      <div class="px-3.5 pb-2.5 pl-4 pt-3">
        <div class="flex items-center justify-between gap-2">
          <span class="flex items-center gap-1.5 text-[11px] font-semibold text-ink">
            <span class="relative flex h-1.5 w-1.5">
              <span aria-hidden="true" class="absolute inset-0 animate-ping rounded-full bg-accent/60"></span>
              <span class="relative h-1.5 w-1.5 rounded-full bg-accent"></span>
            </span>
            一条机会
          </span>
          <span class="font-mono text-[10px] text-ink-muted">每周 5 条</span>
        </div>

        <ul class="mt-2.5 space-y-2">
          {
            outputs.map((o) => (
              <li class="flex items-center gap-2 text-[11.5px] leading-[1.5] text-ink-secondary">
                <span
                  aria-hidden="true"
                  class="grid h-[18px] w-[18px] shrink-0 place-items-center rounded-md bg-primary/[0.07] text-primary/80"
                >
                  {o.key === "bolt" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 3 5 13.5h5.5L10 21l8-11h-5.5L13 3Z" />
                    </svg>
                  )}
                  {o.key === "who" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="8" r="3.2" />
                      <path d="M3.5 19v-1.2A4.3 4.3 0 0 1 7.8 13.5h2.4a4.3 4.3 0 0 1 4.3 4.3V19" />
                      <path d="M16.5 12.6a3.2 3.2 0 1 0-.6-6.3M20.5 19v-1a4 4 0 0 0-2.8-3.8" />
                    </svg>
                  )}
                  {o.key === "start" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5.5 21V4" />
                      <path d="M5.5 4.5h9.6l-1.3 3.4 1.3 3.4H5.5" />
                    </svg>
                  )}
                  {o.key === "stop" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="8.6" />
                      <path d="m9.4 9.4 5.2 5.2M14.6 9.4l-5.2 5.2" />
                    </svg>
                  )}
                </span>
                <span class="truncate">{o.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 来源：把输出与左侧输入对上，让人看懂这是几路信号拼出来的 -->
      <div class="flex flex-wrap items-center gap-[3px] border-t border-border/70 px-2.5 py-2 pl-3.5">
        {
          inputs.map((it) => (
            <span class="flex items-center gap-1 rounded bg-surface-2/80 px-1 py-[3px] text-[9px] text-ink-muted">
              <span aria-hidden="true" class="h-1 w-1 rounded-full" style={`background:${it.color}`} />
              {it.label.replace("AI ", "").replace("榜", "")}
            </span>
          ))
        }
      </div>

      <span
        aria-hidden="true"
        class="flow sweep pointer-events-none absolute inset-0 bg-[linear-gradient(105deg,transparent_38%,rgba(8,102,250,0.10)_50%,transparent_62%)]"
      ></span>
    </div>

    <!-- 机会 → 动手：这一步是人做的，所以不给它加流光 -->
    <div class="relative hidden items-center lg:flex" aria-hidden="true">
      <span class="h-[2px] w-full rounded-full bg-gradient-to-r from-[#e0478a]/25 to-accent/45"></span>
      <svg
        class="-ml-1 h-2.5 w-2.5 shrink-0 text-accent/60"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg
      >
    </div>

    <!-- 尝试：失败居多，但每试一次就更近一点 -->
    <div
      class="relative mx-auto w-full max-w-[260px] rounded-xl border border-dashed border-border-strong bg-surface-2/60 px-3 py-3 lg:mx-0 lg:max-w-none lg:px-2.5 xl:px-3"
    >
      <p class="text-[10.5px] font-semibold leading-none text-ink">动手试，才知道</p>

      <div
        class="mt-2.5 flex items-end justify-between gap-1"
        role="img"
        aria-label="尝试五次，四次推翻，一次成立"
      >
        <span class="h-[8px] w-3 rounded-[2px] bg-ink/10"></span>
        <span class="h-[13px] w-3 rounded-[2px] bg-ink/15"></span>
        <span class="h-[19px] w-3 rounded-[2px] bg-ink/20"></span>
        <span class="h-[26px] w-3 rounded-[2px] bg-ink/25"></span>
        <span class="h-[34px] w-3 rounded-[2px] bg-accent shadow-[0_0_10px_rgba(23,163,74,0.45)]"></span>
      </div>

      <p class="mt-2 text-[9.5px] leading-[1.4] text-ink-muted">4 次推翻，1 次成立</p>
      <p class="mt-1 text-[9.5px] font-medium leading-[1.4] text-primary">试得越多，离那一个越近</p>
    </div>
  </div>

  <!-- 收尾：一句话戳人 + 入口 -->
  <div class="relative mt-7 border-t border-border bg-surface-2/60 px-5 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0 max-w-xl">
        <p class="text-[14px] font-semibold leading-[1.6] text-ink sm:text-[15px]">
          别等准备好，先做能跑起来的那一版。
        </p>
        <p class="mt-1.5 text-[12.5px] leading-[1.75] text-ink-secondary sm:text-[13px]">
          看见就动手。先跑一个最糙的版本，用真实反馈换掉猜测——停在收藏夹里的，永远只是线索。
        </p>
      </div>
      <a
        href="/opportunity"
        class="shrink-0 rounded-lg bg-primary px-4 py-2.5 text-[13px] font-medium text-white transition hover:bg-primary-hover"
      >
        看看这批机会 →
      </a>
    </div>
  </div>
</section>

<style>
  .flow,
  .chip-line,
  .core-glow,
  .spin-slow {
    will-change: transform, opacity;
  }

  /* 输入侧的引导线：宽屏下从方块右沿伸出手，接到汇流竖线 */
  @media (min-width: 1024px) {
    .chip-line::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -24px;
      width: 24px;
      height: 1px;
      background: linear-gradient(to right, var(--dot), color-mix(in srgb, var(--dot) 55%, transparent));
      opacity: 0.7;
    }
  }

  /* 光点颜色跟着所属信号走，drop-shadow 用 currentColor 保持同色辉光 */
  .dot-lane {
    background: var(--dot);
    color: var(--dot);
    filter: drop-shadow(0 0 4px currentColor);
    animation: lane-out 2.2s cubic-bezier(0.42, 0, 0.58, 1) infinite;
  }
  .dot-right {
    animation: dot-right 2.8s cubic-bezier(0.42, 0, 0.58, 1) infinite;
    box-shadow: 0 0 8px rgba(224, 71, 138, 0.55);
  }
  .dot-down {
    animation: dot-down 2.4s ease-in-out infinite;
    box-shadow: 0 0 6px rgba(8, 102, 250, 0.55);
  }
  .core-glow {
    animation: core-glow 4s ease-in-out infinite;
  }
  .spin-slow {
    animation: spin-slow 9s linear infinite;
  }
  .sweep {
    animation: sweep 5.5s ease-in-out infinite;
  }

  @keyframes lane-out {
    0% {
      opacity: 0;
      transform: translate(-2px, -50%) scale(0.45);
    }
    18% {
      opacity: 1;
      transform: translate(4px, -50%) scale(1);
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(24px, -50%) scale(0.7);
    }
  }
  @keyframes dot-right {
    0% {
      opacity: 0;
      transform: translateX(4px) scale(0.5);
    }
    22% {
      opacity: 1;
      transform: translateX(14px) scale(1);
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(52px) scale(0.75);
    }
  }
  @keyframes dot-down {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes core-glow {
    0%,
    100% {
      box-shadow: 0 0 18px rgba(8, 102, 250, 0.12);
    }
    50% {
      box-shadow: 0 0 32px rgba(8, 102, 250, 0.26);
    }
  }
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes sweep {
    0% {
      transform: translateX(-110%);
    }
    55%,
    100% {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .core-glow,
    .spin-slow {
      animation: none;
    }
  }
</style>