---
/**
 * 首页「机会引擎」：解释机会怎么被算出来，不展示具体机会条目。
 * 五路信号 → 汇流母线 → Horizons 内核 → 一条机会的骨架。
 * 纯 CSS 动画，无脚本、无外部依赖。
 */
interface Props {
  tools: number;
  repos: number;
  trends: number;
  models: number;
}

const { tools, repos, trends, models } = Astro.props;

/**
 * 五路信号：颜色彼此拉得开（蓝 / 紫 / 琥珀 / 青 / 绿），
 * 流动光点用同一色，速度各不相同，看起来像真的在并行推送。
 */
const inputs = [
  { label: "AI 工具榜", value: String(tools), unit: "个工具", href: "/tools", color: "#0866fa", dur: "1.7s", delay: "0s" },
  { label: "GitHub 榜", value: String(repos), unit: "个仓库", href: "/github", color: "#703ff4", dur: "2.5s", delay: "0.4s" },
  { label: "趋势词榜", value: String(trends), unit: "个词", href: "/trends", color: "#f0a020", dur: "2.0s", delay: "0.85s" },
  { label: "AI 模型榜", value: String(models), unit: "个模型", href: "/models", color: "#0ea5c4", dur: "2.9s", delay: "0.2s" },
  { label: "每日情报", value: "每天", unit: "", href: "/daily", color: "#17a34a", dur: "2.2s", delay: "0.6s" },
];

/** 输出侧只给结构：让读者知道一条机会里有什么，而不是现在就替他们决定 */
const outputs = [
  { key: "bolt", text: "为什么现在成立" },
  { key: "who", text: "谁已经卡在这条路上" },
  { key: "start", text: "第一周先做什么" },
  { key: "stop", text: "什么条件下放弃" },
];
---

<section
  class="relative mt-14 overflow-hidden rounded-2xl border border-border bg-surface sm:mt-16"
  aria-labelledby="opp-engine-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(78%_58%_at_10%_-8%,rgba(8,102,250,0.09),transparent)]"
  >
  </div>

  <div class="relative px-5 pt-7 sm:px-8 sm:pt-9">
    <!-- 眉标：同心弧图标呼应品牌穹顶，比一个圆点更有辨识度 -->
    <span
      class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/[0.06] py-1 pl-2 pr-2.5"
    >
      <svg
        class="h-3.5 w-3.5 text-primary"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <circle cx="12" cy="12" r="5.2"></circle>
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
      </svg>
      <span class="text-[11.5px] font-semibold tracking-[0.06em] text-primary">机会引擎</span>
    </span>

    <h2
      id="opp-engine-title"
      class="mt-3.5 max-w-2xl text-[1.3rem] font-bold leading-[1.4] tracking-tight text-ink sm:text-[1.7rem]"
    >
      一张榜是热闹，几张榜叠起来才是窗口
    </h2>
    <p class="mt-2.5 max-w-2xl text-[13px] leading-[1.8] text-ink-secondary sm:text-sm">
      工具、仓库、趋势词、模型，任何一张单独看都是噪音。叠在一起还同时发亮的那一处，才是窗口。
    </p>
  </div>

  <!-- 数据流：lg 一行五段横铺，小屏竖排 -->
  <div
    class="relative mt-7 grid gap-y-4 px-5 sm:px-8 lg:mt-9 lg:grid-cols-[232px_38px_92px_38px_352px] lg:items-center lg:justify-center lg:gap-y-0"
  >
    <!-- 技术底纹：极淡网格，向四周淡出 -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background-image: linear-gradient(to right, var(--c-border) 1px, transparent 1px), linear-gradient(to bottom, var(--c-border) 1px, transparent 1px); background-size: 30px 30px; opacity: 0.75; mask-image: radial-gradient(62% 74% at 50% 50%, black, transparent 80%); -webkit-mask-image: radial-gradient(62% 74% at 50% 50%, black, transparent 80%);"
    >
    </div>

    <ul class="relative flex flex-wrap justify-center gap-2 lg:flex-col lg:flex-nowrap lg:justify-start lg:gap-1.5">
      {
        inputs.map((it) => (
          <li
            class="chip-line relative flex w-[calc(50%-0.25rem)] items-center justify-between gap-2 rounded-lg border border-border bg-surface px-2.5 py-2 sm:w-[calc(33.333%-0.375rem)] lg:w-full lg:py-1.5"
            style={`--dot:${it.color}`}
          >
            <a href={it.href} class="flex min-w-0 items-center gap-1.5 transition hover:text-primary">
              <span
                aria-hidden="true"
                class="h-[5px] w-[5px] shrink-0 rounded-full"
                style={`background:${it.color}; box-shadow:0 0 6px ${it.color}66`}
              />
              <span class="truncate text-[11px] font-medium text-ink-secondary">{it.label}</span>
            </a>
            <!-- 小屏用虚线把名称与条数接起来；宽屏空间紧，靠对齐就够 -->
            <span
              aria-hidden="true"
              class="mx-1 h-px min-w-2 flex-1 border-t border-dashed border-border-strong lg:hidden"
            />
            <span class="shrink-0 font-mono text-[11px] tabular-nums text-ink">
              {it.value}
              {it.unit && <span class="ml-0.5 hidden text-[10px] text-ink-muted sm:inline">{it.unit}</span>}
            </span>
            <!-- 读取扫描：沿底边整条扫过，颜色随所属信号，快慢也各不相同 -->
            <span
              aria-hidden="true"
              class="flow scan-line absolute inset-x-1 bottom-[1px] hidden h-[2px] rounded-full lg:block"
              style={`--dot:${it.color}; animation-duration:${it.dur}; animation-delay:${it.delay};`}
            />
            <!-- 出线光点：掠过之后交给右侧母线 -->
            <span
              aria-hidden="true"
              class="flow dot-lane absolute -right-1 top-1/2 hidden h-1.5 w-1.5 rounded-full lg:block"
              style={`--dot:${it.color}; animation-duration:${it.dur}; animation-delay:${it.delay};`}
            />
          </li>
        ))
      }
    </ul>

    <!-- 汇流母线：五路并到一条竖线上，再横向送入内核 -->
    <div class="relative hidden self-stretch lg:block">
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-[18px] w-[2px] rounded-full bg-gradient-to-b from-transparent via-primary/45 to-transparent"
      ></span>
      <span
        aria-hidden="true"
        class="absolute bottom-1.5 left-[16px] h-1.5 w-1.5 rounded-full border border-primary/40 bg-surface"
      ></span>
      <span
        aria-hidden="true"
        class="absolute top-1.5 left-[16px] h-1.5 w-1.5 rounded-full border border-primary/40 bg-surface"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-[18px] top-1/2 h-[2px] w-[20px] rounded-full bg-gradient-to-r from-primary/35 to-primary/70"
      ></span>
      <span aria-hidden="true" class="flow bus-dot absolute left-[16px] top-0 h-1.5 w-1.5 rounded-full bg-primary"></span>
    </div>

    <!-- 内核：用 Horizons 自己的标记，而不是一个 AI 字样 -->
    <div class="relative mx-auto grid h-[92px] w-[92px] place-items-center">
      <span aria-hidden="true" class="core-glow absolute -inset-1 rounded-full"></span>
      <span aria-hidden="true" class="spin-slow absolute inset-0 rounded-full border border-dashed border-primary/30"
      ></span>
      <div
        class="relative grid h-[68px] w-[68px] place-items-center overflow-hidden rounded-full border border-primary/20 bg-surface"
      >
        <span
          aria-hidden="true"
          class="spin-slow absolute inset-[-40%] bg-[conic-gradient(from_0deg,transparent_0deg,rgba(8,102,250,0.20)_60deg,transparent_120deg)]"
        ></span>
        <img
          src="/brand/mark.png"
          alt=""
          width="239"
          height="112"
          class="relative h-6 w-auto"
          loading="lazy"
        />
      </div>
      <span
        class="pointer-events-none absolute -bottom-7 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-surface px-2 text-[10px] tracking-[0.08em] text-ink-muted lg:block"
        >Horizons 引擎</span
      >
    </div>

    <!-- 内核 → 输出 -->
    <div class="relative flex h-6 items-center justify-center lg:h-[84px] lg:w-9">
      <span aria-hidden="true" class="absolute h-full w-px bg-gradient-to-b from-primary/60 via-primary/30 to-transparent lg:hidden"></span>
      <span aria-hidden="true" class="flow dot-down absolute h-1.5 w-1.5 rounded-full bg-primary lg:hidden"></span>
      <span aria-hidden="true" class="absolute hidden h-[2px] w-full rounded-full bg-gradient-to-r from-primary/60 to-primary/25 lg:block"></span>
      <span aria-hidden="true" class="flow dot-right absolute hidden h-1.5 w-1.5 rounded-full bg-primary lg:block"></span>
    </div>

    <!-- 输出：一条机会的骨架 -->
    <div class="relative overflow-hidden rounded-xl border border-primary/25 bg-surface">
      <!-- 左侧品牌渐变边：与 logo 穹顶同源，标记这是「产物」 -->
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 w-[3px]"
        style="background-image: var(--brand-gradient)"></span>

      <div class="px-3.5 pb-2.5 pl-4 pt-3">
        <div class="flex items-center justify-between gap-2">
          <span class="flex items-center gap-1.5 text-[11px] font-semibold text-ink">
            <span class="relative flex h-1.5 w-1.5">
              <span aria-hidden="true" class="absolute inset-0 animate-ping rounded-full bg-accent/60"></span>
              <span class="relative h-1.5 w-1.5 rounded-full bg-accent"></span>
            </span>
            一条机会
          </span>
          <span class="font-mono text-[10px] text-ink-muted">每周 5 条</span>
        </div>

        <ul class="mt-2.5 space-y-2">
          {
            outputs.map((o) => (
              <li class="flex items-center gap-2 text-[11.5px] leading-[1.5] text-ink-secondary">
                <span
                  aria-hidden="true"
                  class="grid h-[18px] w-[18px] shrink-0 place-items-center rounded-md bg-primary/[0.07] text-primary/80"
                >
                  {o.key === "bolt" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 3 5 13.5h5.5L10 21l8-11h-5.5L13 3Z" />
                    </svg>
                  )}
                  {o.key === "who" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="8" r="3.2" />
                      <path d="M3.5 19v-1.2A4.3 4.3 0 0 1 7.8 13.5h2.4a4.3 4.3 0 0 1 4.3 4.3V19" />
                      <path d="M16.5 12.6a3.2 3.2 0 1 0-.6-6.3M20.5 19v-1a4 4 0 0 0-2.8-3.8" />
                    </svg>
                  )}
                  {o.key === "start" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5.5 21V4" />
                      <path d="M5.5 4.5h9.6l-1.3 3.4 1.3 3.4H5.5" />
                    </svg>
                  )}
                  {o.key === "stop" && (
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="8.6" />
                      <path d="m9.4 9.4 5.2 5.2M14.6 9.4l-5.2 5.2" />
                    </svg>
                  )}
                </span>
                <span class="truncate">{o.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 来源：把输出与左侧输入对上，让人看懂这是几路信号拼出来的 -->
      <div class="flex items-center gap-1 border-t border-border/70 px-3 py-2 pl-4">
        {
          inputs.slice(0, 4).map((it) => (
            <span class="flex items-center gap-1 rounded-md bg-surface-2/80 px-1.5 py-[3px] text-[9.5px] text-ink-muted">
              <span aria-hidden="true" class="h-1 w-1 rounded-full" style={`background:${it.color}`} />
              {it.label.replace("AI ", "").replace("榜", "")}
            </span>
          ))
        }
        <span class="ml-auto font-mono text-[9.5px] text-ink-muted/70">5 路汇合</span>
      </div>

      <span
        aria-hidden="true"
        class="flow sweep pointer-events-none absolute inset-0 bg-[linear-gradient(105deg,transparent_38%,rgba(8,102,250,0.10)_50%,transparent_62%)]"
      ></span>
    </div>
  </div>

  <!-- 收尾：一句话戳人 + 入口 -->
  <div class="relative mt-7 border-t border-border bg-surface-2/60 px-5 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0 max-w-xl">
        <p class="text-[14px] font-semibold leading-[1.6] text-ink sm:text-[15px]">
          别等准备好，先做能跑起来的那一版。
        </p>
        <p class="mt-1.5 text-[12.5px] leading-[1.75] text-ink-secondary sm:text-[13px]">
          看见就动手。先跑一个最糙的版本，用真实反馈换掉猜测——停在收藏夹里的，永远只是线索。
        </p>
      </div>
      <a
        href="/opportunity"
        class="shrink-0 rounded-lg bg-primary px-4 py-2.5 text-[13px] font-medium text-white transition hover:bg-primary-hover"
      >
        看看这批机会 →
      </a>
    </div>
  </div>
</section>

<style>
  .flow,
  .chip-line,
  .core-glow,
  .spin-slow {
    will-change: transform, opacity;
  }

  /* 输入侧的引导线：宽屏下从方块右沿伸出手，接到汇流竖线 */
  @media (min-width: 1024px) {
    .chip-line::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -20px;
      width: 20px;
      height: 1px;
      background: var(--dot);
      opacity: 0.45;
    }
  }

  /* 光点颜色跟着所属信号走，drop-shadow 用 currentColor 保持同色辉光 */
  .dot-lane {
    background: var(--dot);
    color: var(--dot);
    filter: drop-shadow(0 0 4px currentColor);
    animation: lane-out 2.2s cubic-bezier(0.42, 0, 0.58, 1) infinite;
  }
  /* 读取扫描：靠背景位移推进，不越出方块边界 */
  .scan-line {
    background-image: linear-gradient(90deg, transparent 0%, var(--dot) 42%, var(--dot) 58%, transparent 100%);
    background-repeat: no-repeat;
    background-size: 70px 100%;
    background-position: -70px 0;
    color: var(--dot);
    filter: drop-shadow(0 0 3px currentColor);
    animation: scan 2.2s linear infinite;
  }
  .bus-dot {
    animation: bus-fall 2.6s cubic-bezier(0.42, 0, 0.58, 1) infinite;
    box-shadow: 0 0 6px rgba(8, 102, 250, 0.55);
  }
  .dot-right {
    animation: dot-right 2.8s cubic-bezier(0.42, 0, 0.58, 1) infinite;
    box-shadow: 0 0 6px rgba(8, 102, 250, 0.55);
  }
  .dot-down {
    animation: dot-down 2.4s ease-in-out infinite;
    box-shadow: 0 0 6px rgba(8, 102, 250, 0.55);
  }
  .core-glow {
    animation: core-glow 4s ease-in-out infinite;
  }
  .spin-slow {
    animation: spin-slow 9s linear infinite;
  }
  .sweep {
    animation: sweep 5.5s ease-in-out infinite;
  }

  @keyframes scan {
    0% {
      background-position: -70px 0;
      opacity: 0;
    }
    12% {
      opacity: 0.9;
    }
    86% {
      opacity: 0.9;
    }
    100% {
      background-position: 240px 0;
      opacity: 0;
    }
  }
  @keyframes lane-out {
    0% {
      opacity: 0;
      transform: translate(0, -50%) scale(0.5);
    }
    22% {
      opacity: 1;
      transform: translate(6px, -50%) scale(1);
    }
    84% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(20px, -50%) scale(0.85);
    }
  }
  @keyframes bus-fall {
    0% {
      opacity: 0;
      transform: translateY(-4px) scale(0.5);
    }
    18% {
      opacity: 1;
      transform: translateY(14px) scale(1);
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(158px) scale(0.8);
    }
  }
  @keyframes dot-right {
    0% {
      opacity: 0;
      transform: translateX(2px) scale(0.5);
    }
    25% {
      opacity: 1;
      transform: translateX(10px) scale(1);
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(34px) scale(0.8);
    }
  }
  @keyframes dot-down {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes core-glow {
    0%,
    100% {
      box-shadow: 0 0 18px rgba(8, 102, 250, 0.12);
    }
    50% {
      box-shadow: 0 0 32px rgba(8, 102, 250, 0.26);
    }
  }
  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes sweep {
    0% {
      transform: translateX(-110%);
    }
    55%,
    100% {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow,
    .core-glow,
    .spin-slow {
      animation: none;
    }
  }
</style>