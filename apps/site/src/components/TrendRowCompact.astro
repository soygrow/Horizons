---
/** 首页趋势词榜行：显示榜单真实名次 + 状态 / 增长 / 为什么值得关注 */
import Sparkline from "./Sparkline.astro";
import type { TrendRow } from "../lib/types";

interface Props {
  trend: TrendRow;
  rank: number;
}

const { trend, rank } = Astro.props;
---

<a
  href={`/trends/${trend.slug}`}
  class="group flex items-center gap-3 border-b border-border px-4 py-3 transition last:border-b-0 hover:bg-surface-2 sm:px-5"
>
  <span class="w-9 shrink-0 text-sm font-semibold text-ink-muted tabular-nums">
    #{rank}
  </span>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="truncate text-sm font-semibold text-ink group-hover:text-primary">
        {trend.normalizedName}
      </h3>
      <span
        class:list={[
          "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-medium",
          trend.statusCls,
        ]}
        title={trend.statusHint}
      >
        <span class:list={["h-1.5 w-1.5 rounded-full", trend.statusDot]}></span>
        {trend.statusLabel}
      </span>
      <span class="hidden shrink-0 rounded-md border border-border bg-surface-2 px-1.5 py-0.5 text-[10px] leading-4 text-ink-secondary sm:inline">
        {trend.catLabel}
      </span>
    </div>
    <p class="mt-0.5 line-clamp-1 text-xs leading-snug text-ink-secondary">{trend.why}</p>
  </div>

  <div class="hidden shrink-0 lg:block">
    <Sparkline points={trend.spark} width={64} height={24} />
  </div>

  <div class="shrink-0 text-right">
    <div class:list={["text-sm font-semibold tabular-nums", trend.growthCls]}>
      {trend.growthText}
    </div>
    <div class="text-[11px] text-ink-muted tabular-nums">
      {trend.scored ? `趋势 ${trend.tv} · 机会 ${trend.op}` : "数据不足"}
    </div>
  </div>
</a>