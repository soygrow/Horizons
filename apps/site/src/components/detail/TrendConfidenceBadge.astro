---
/** 趋势可信度：自定义证据等级，非 Google 官方指标 */
import { trendConfidenceMeta } from "../../../../web/src/lib/trends";

interface Props {
  confidence: keyof typeof trendConfidenceMeta;
  showLabel?: boolean;
}

const { confidence, showLabel = true } = Astro.props;
const meta = trendConfidenceMeta[confidence];
---

<span
  title={meta.hint}
  class={`inline-flex w-fit items-center rounded-full border px-2 py-0.5 text-[11px] font-medium ${meta.cls}`}
>
  {showLabel ? `可信度 ${meta.label}` : meta.label}
</span>