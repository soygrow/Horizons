---
/** 04 差异化与风险 */
import RepoSection from "../RepoSection.astro";

interface Props {
  insight: Record<string, any> | undefined;
}

const { insight } = Astro.props;
const differentiators: string[] = insight?.differentiators ?? [];
const risks: string[] = insight?.risks ?? [];
---

<RepoSection no="04" title="差异化与风险" desc="怎样避开同质化，以及要提前想清楚的坑">
  <div class="grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-border bg-surface-2/40 p-4">
      <h3 class="text-xs font-medium text-ink-muted">差异化切入点</h3>
      <ul class="mt-2 space-y-1.5">
        {
          differentiators.map((d) => (
            <li class="flex gap-2 text-sm text-ink-secondary">
              <span class="text-emerald-500">+</span>
              {d}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4">
      <h3 class="text-xs font-medium text-ink-muted">风险与门槛</h3>
      <ul class="mt-2 space-y-1.5">
        {
          risks.map((risk) => (
            <li class="flex gap-2 text-sm text-ink-secondary">
              <span class="text-amber-500">!</span>
              {risk}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  {
    insight?.techNotes ? (
      <div class="mt-3 rounded-xl border border-border px-3.5 py-2.5">
        <span class="text-xs text-ink-muted">技术要点：</span>
        <span class="text-sm text-ink-secondary">{insight.techNotes}</span>
      </div>
    ) : null
  }
</RepoSection>