---
/** 01 能用来做出什么产品 */
import RepoSection from "../RepoSection.astro";

interface Props {
  insight: Record<string, any> | undefined;
}

const { insight } = Astro.props;
const ideas: any[] = insight?.buildIdeas ?? [];
---

<RepoSection no="01" title="能用来做出什么产品" desc="面向个人 / 小团队，基于它的能力可落地的方向">
  {
    ideas.length ? (
      <div class="grid gap-3 sm:grid-cols-2">
        {ideas.map((idea, i) => (
          <div class="rounded-xl border border-border bg-surface-2/40 p-4">
            <div class="flex items-center gap-2">
              <span class="text-[11px] tabular-nums text-ink-muted">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="text-sm font-semibold text-ink">{idea.title}</h3>
            </div>
            <p class="mt-1 text-xs text-ink-muted">适合：{idea.audience}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{idea.product}</p>
            <dl class="mt-3 space-y-1 text-xs">
              <div class="flex gap-1.5">
                <dt class="shrink-0 text-ink-muted">变现</dt>
                <dd class="text-ink-secondary">{idea.monetization}</dd>
              </div>
              <div class="flex gap-1.5">
                <dt class="shrink-0 text-ink-muted">人力</dt>
                <dd class="text-ink-secondary">{idea.effort}</dd>
              </div>
              {idea.stackHint ? (
                <div class="flex gap-1.5">
                  <dt class="shrink-0 text-ink-muted">技术</dt>
                  <dd class="text-ink-secondary">{idea.stackHint}</dd>
                </div>
              ) : null}
            </dl>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-muted">情报生成中。</p>
    )
  }
</RepoSection>