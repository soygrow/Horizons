---
/** 01 产品表现 */
import SectionHeader from "../SectionHeader.astro";
import Stat from "../Stat.astro";
import InsightCard from "../InsightCard.astro";
import Badge from "../Badge.astro";
import { getDict, format as tf } from "../../../lib/i18n";
import { formatDate, formatMom, formatNum, momCapHint, isLaunchPlausible } from "../../../lib/format";
import {
  countryLabel,
  getChannelVisits,
  getLaunchedAt,
  getOrganicShare,
  getOrganicVisits,
} from "../../../lib/data";

interface Props {
  tool: Record<string, any>;
}

const dict = getDict("zh");
const { tool } = Astro.props;

const m = tool.metrics;
const tm = tool.trafficMetrics;
const ranks = tool.ranks;
const pi = tool.performanceInsight;
const ai = tool.aiInsight;
const mi = tool.moduleInsights;
const ds = tool.dataSnapshot;
const collectedAt = tool.collectedAt;
const fmtTime = (s?: string) => (s ? s.slice(0, 19).replace("T", " ") : "");

/*
 * 7 格指标统一走 lib/data 的口径函数。
 * 原先手写 `m.organicVisits` / `m.countryName` / `tool.launchedAt`，
 * 而采集链路实际写的是 `trafficMetrics.organicSearchVisits` / `geoDistribution` /
 * `metrics.registeredAt` —— 键名对不上，数据齐了也显示「—」。
 */
const visits = tm?.monthlyVisits ?? m?.monthlyVisits;
const mom = tm?.monthlyVisitsGrowth ?? m?.momGrowth;
const organicVisits = getOrganicVisits(tool as never);
const organicShareRaw = getOrganicShare(tool as never);
const organicShare =
  organicShareRaw !== undefined ? Math.round(organicShareRaw * 10) / 10 : undefined;

/**
 * 直接访问量 = 月访问量 × direct 渠道占比。
 * 库里存的 trafficMetrics.directVisits 是「0.42 当百分数」算出来的（小 100 倍），
 * 按占比重算才能和渠道结构那块对上，也才有 8,073 这个量级。
 */
const directVisits =
  getChannelVisits(tool as never, "direct") ?? (tm?.directVisits as number | undefined);

/** 所属国家：ISO 码转中文（ID → 印度尼西亚），无代码时回退采集到的国名 */
const country =
  countryLabel(m?.country ?? (tool.geoDistribution?.[0]?.country as string | undefined)) ??
  m?.countryName;

/** 上线时间：Wayback 首快照优先，回退域名注册时间；早于 2017 视为域名前史 */
const launchedRaw: string | undefined = getLaunchedAt(tool as never);
const launchedAt = isLaunchPlausible(launchedRaw) ? launchedRaw : undefined;
const launchedEstimated = launchedAt !== undefined && tool.launchedAtEstimated === true;
const launchedUnknown = !!launchedRaw && !launchedAt;

/** aiInsight 的「以前 / 现在 / 相比之下」三格与「增长 / 获客 / 壁垒 / 收费」四卡 */
const aiTriad = [
  { k: dict.aiInsight.before, v: ai?.before },
  { k: dict.aiInsight.now, v: ai?.now },
  { k: dict.aiInsight.comparison, v: ai?.comparison },
].filter((x) => x.v);

const aiCards: { k: string; v?: string; badge?: string }[] = [
  { k: dict.aiInsight.growthDriver, v: ai?.growthDriver },
  { k: dict.aiInsight.acquisition, v: ai?.acquisition },
  { k: dict.aiInsight.moat, v: ai?.moat, badge: ai?.moatBadge },
  { k: dict.aiInsight.monetization, v: ai?.monetization, badge: ai?.monetizationBadge },
].filter((x) => x.v);
---

<section id="performance" class="flex scroll-mt-36 flex-col gap-10">
  <SectionHeader
    no={dict.sections.performance.no}
    title={dict.sections.performance.title}
    desc={dict.sections.performance.desc}
  />

  {
    (ds?.period || collectedAt) && (
      <div class="-my-5 flex flex-wrap items-center gap-x-6 gap-y-1 text-xs text-ink-muted">
        {ds?.period && (
          <span class="inline-flex items-center gap-1.5">
            <span class="text-ink-secondary">{dict.sections.performance.snapshot}</span>
            {ds.period}
          </span>
        )}
        {collectedAt && (
          <span class="inline-flex items-center gap-1.5">
            <span class="text-ink-secondary">{dict.sections.performance.updated}</span>
            {fmtTime(collectedAt)}
          </span>
        )}
      </div>
    )
  }

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
    <Stat
      label={dict.metrics.monthlyVisits}
      value={visits !== undefined ? formatNum(visits) : undefined}
    />
    <Stat
      label={dict.metrics.monthlyVisitsGrowth}
      value={mom !== undefined ? formatMom(mom) : undefined}
      success={(mom ?? 0) > 0}
      hint={momCapHint(mom)}
    />
    <Stat
      label={dict.metrics.organicSearchVisits}
      value={organicVisits !== undefined ? formatNum(organicVisits) : undefined}
    />
    <Stat
      label={dict.metrics.organicShare}
      value={organicShare !== undefined ? `${organicShare}%` : undefined}
      hint="Similarweb 全渠道口径：自然搜索访问 ÷ 总访问"
    />
    <Stat
      label={dict.metrics.directVisits}
      value={directVisits !== undefined ? formatNum(directVisits) : undefined}
    />
    <Stat
      label={dict.metrics.country}
      value={country}
      hint={
        ranks?.country
          ? `${dict.traffic.countryRank} #${formatNum(ranks.country)}`
          : "Similarweb 判定的主要流量来源国家"
      }
    />
    <Stat
      label={dict.metrics.launchedAt}
      value={launchedAt ? `${formatDate(launchedAt)}${launchedEstimated ? " *" : ""}` : undefined}
      hint={
        launchedUnknown
          ? "该域名更早年份已有记录（多为停放页或其他项目），无法确定产品上线时间"
          : launchedEstimated
            ? "该域名早期已有其他站点存档，产品实际上线可能更晚"
            : tool.launchConfidence
              ? `${tf(dict.traffic.launchConfidence, { level: tool.launchConfidence })} · 站点首次被 Wayback 存档的时间`
              : "站点首次被 Wayback 存档的时间"
      }
    />
  </div>

  {
    (launchedUnknown || launchedEstimated) && (
      <p class="-my-6 text-xs leading-relaxed text-ink-muted">
        * 该域名在更早年份就已有网页存档（多为域名停放页或其他项目），
        {launchedUnknown
          ? "无法据此确定产品上线时间，故未展示。"
          : "此处显示的是最早存档时间，产品实际上线可能更晚。"}
      </p>
    )
  }

  <div class="flex flex-col gap-4">
    <div class="rounded-2xl border border-border bg-surface p-6">
      <div class="mb-5 flex items-center gap-2.5">
        <span class="h-4 w-1 rounded-full bg-primary" aria-hidden="true"></span>
        <h3 class="text-sm font-semibold text-ink">{dict.performanceInsight.highlightTag}</h3>
      </div>
      <dl class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {
          [
            { k: dict.performanceInsight.what, v: pi?.overview?.what },
            { k: dict.performanceInsight.pain, v: pi?.overview?.pain },
            { k: dict.performanceInsight.can, v: pi?.overview?.can },
            { k: dict.performanceInsight.trait, v: pi?.overview?.trait },
          ].map(({ k, v }) => (
            <div class="min-w-0">
              <dt class="text-xs font-medium text-ink-muted">{k}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed break-words text-ink">
                {v ?? dict.performanceInsight.pending}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <InsightCard
        title={dict.performanceInsight.wedge}
        sub={dict.performanceInsight.wedgeSub}
        text={pi?.wedge}
      />
      <InsightCard
        title={dict.performanceInsight.model}
        sub={dict.performanceInsight.modelSub}
        text={pi?.model}
      />
      <InsightCard
        title={dict.performanceInsight.moat}
        sub={dict.performanceInsight.moatSub}
        text={pi?.moat}
      />
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <InsightCard
        title={dict.performanceInsight.trafficTruth}
        sub={dict.performanceInsight.trafficTruthSub}
        text={pi?.trafficTruth}
      />
      <InsightCard
        title={dict.performanceInsight.growthEdge}
        sub={dict.performanceInsight.growthEdgeSub}
        text={pi?.growthEdge}
      />
      <InsightCard
        title={dict.performanceInsight.newPlayerEntry}
        sub={dict.performanceInsight.newPlayerEntrySub}
        text={pi?.newPlayerEntry}
        tag={pi?.entryTag}
      />
    </div>
  </div>

  {/*
    各模块 AI 补充分析（moduleInsights）。
    同样是「有数据、无渲染位」的那批字段：performance / growth 归 01 区，
    keywords / competition 归 03 区，各取各的。
  */}
  {
    [mi?.performance, mi?.growth].some((x) => x?.analysis) ? (
      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-semibold text-ink">{dict.moduleInsight.label}</h3>
        <div class="grid gap-4 md:grid-cols-2">
          {[mi?.performance, mi?.growth]
            .filter((x) => x?.analysis)
            .map((x: { analysis?: string; soWhat?: string }) => (
              <div class="rounded-xl border border-border bg-surface p-5">
                <p class="text-xs font-medium text-ink-muted">{dict.moduleInsight.analysis}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-secondary">{x.analysis}</p>
                {x.soWhat ? (
                  <>
                    <p class="mt-3 text-xs font-medium text-ink-muted">
                      {dict.moduleInsight.soWhat}
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-ink">{x.soWhat}</p>
                  </>
                ) : null}
              </div>
            ))}
        </div>
      </div>
    ) : null
  }

  {/*
    AI 解读（aiInsight）。
    历史数据里 209 条全部有这块内容，但此前只进了 site-markdown 给 AI 爬虫读，
    人类页面从来没有渲染过 —— 数据白存。这里补上渲染位，无内容时整块不出现。
  */}
  {
    ai && (ai.question || ai.intro || ai.growthDriver) ? (
      <div class="rounded-2xl border border-border bg-surface p-6">
        <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="h-4 w-1 rounded-full bg-primary" aria-hidden="true" />
          <h3 class="text-sm font-semibold text-ink">{dict.aiInsight.label}</h3>
          {ai.analyzedAt ? (
            <span class="text-xs text-ink-muted">
              {tf(dict.aiInsight.analyzedAt, { time: ai.analyzedAt })}
            </span>
          ) : null}
          {ai.confidence !== undefined ? (
            <span class="text-xs text-ink-muted">
              {tf(dict.aiInsight.confidence, { value: ai.confidence })}
            </span>
          ) : null}
        </div>

        {ai.question ? (
          <p class="text-lg leading-relaxed font-medium text-ink">{ai.question}</p>
        ) : null}
        {ai.intro ? (
          <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{ai.intro}</p>
        ) : null}

        {
          aiTriad.length ? (
            <div class="mt-5 grid gap-4 sm:grid-cols-3">
              {aiTriad.map(({ k, v }) => (
                <div class="rounded-xl border border-border bg-surface-2 p-4">
                  <p class="text-xs font-medium text-ink-muted">{k}</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink">{v}</p>
                </div>
              ))}
            </div>
          ) : null
        }

        {
          ai.audiences?.length ? (
            <div class="mt-5">
              <p class="text-xs font-medium text-ink-muted">{dict.aiInsight.audiences}</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {ai.audiences.map((a: string) => (
                  <Badge>{a}</Badge>
                ))}
              </div>
            </div>
          ) : null
        }

        {
          ai.hooks?.length ? (
            <div class="mt-5">
              <p class="text-xs font-medium text-ink-muted">{dict.aiInsight.hooks}</p>
              <ul class="mt-2 flex flex-col gap-2">
                {ai.hooks.map((h: { title?: string; desc?: string }) => (
                  <li class="text-sm leading-relaxed text-ink-secondary">
                    <span class="font-medium text-ink">{h.title}</span>
                    {h.desc ? ` · ${h.desc}` : ""}
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        {
          ai.willingness?.level ? (
            <div class="mt-5 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-xs font-medium text-ink-muted">{dict.aiInsight.willingness}</span>
              <Badge>
                {ai.willingness.level === "高"
                  ? dict.aiInsight.willingnessHigh
                  : ai.willingness.level === "中等"
                    ? dict.aiInsight.willingnessMid
                    : dict.aiInsight.willingnessLow}
              </Badge>
              {ai.willingness.reason ? (
                <span class="text-ink-secondary">{ai.willingness.reason}</span>
              ) : null}
            </div>
          ) : null
        }

        {
          aiCards.length ? (
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {aiCards.map(({ k, v, badge }) => (
                <div class="rounded-xl border border-border bg-surface-2 p-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="text-xs font-medium text-ink-muted">{k}</p>
                    {badge ? <Badge>{badge}</Badge> : null}
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink">{v}</p>
                </div>
              ))}
            </div>
          ) : null
        }
      </div>
    ) : null
  }
</section>