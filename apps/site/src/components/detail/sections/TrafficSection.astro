---
/** 03 流量情况 */
import SectionHeader from "../SectionHeader.astro";
import SubCard from "../SubCard.astro";
import Split from "../Split.astro";
import Bars from "../Bars.astro";
import Badge from "../Badge.astro";
import NoData from "../NoData.astro";
import Pending from "../Pending.astro";
import TrafficTrendChart from "../TrafficTrendChart.astro";
import { getDict, format as tf } from "../../../../../web/src/lib/i18n";
import { formatCount } from "../../../lib/format";

interface Props {
  tool: Record<string, any>;
}

const dict = getDict("zh");
const { tool } = Astro.props;

const trend: any[] = tool.trend ?? [];
const geo: any[] = tool.geoDistribution ?? [];
const ranks = tool.ranks;
const keywords: any[] = tool.keywords ?? [];
const rankDistribution: any[] = tool.rankDistribution ?? [];
const td = tool.trafficDecrypt;
const channelShares: Record<string, number> = tool.channelShares ?? {};

const channelItems = Object.entries(channelShares)
  .map(([key, value]) => ({
    label: (dict.traffic.channels as Record<string, string>)[key] ?? key,
    value: value ?? 0,
  }))
  .sort((a, b) => b.value - a.value);
---

<section id="traffic" class="flex scroll-mt-36 flex-col gap-10">
  <SectionHeader
    no={dict.sections.traffic.no}
    title={dict.sections.traffic.title}
    desc={dict.sections.traffic.desc}
  />
  <Split>
    <div slot="left" class="flex flex-col gap-5">
      <SubCard title={dict.traffic.trend}>
        <span slot="extra" class="text-sm text-ink-muted">
          {tf(dict.traffic.monthsRange, { count: trend.length })}
        </span>
        {
          trend.length >= 2 ? (
            <TrafficTrendChart points={trend as any} />
          ) : (
            <NoData note={dict.traffic.noHistory} />
          )
        }
      </SubCard>

      <SubCard title={dict.traffic.sources}>
        {
          channelItems.length ? (
            <Bars items={channelItems.map((c) => ({ label: c.label, value: c.value, suffix: "%" }))} />
          ) : (
            <NoData />
          )
        }
      </SubCard>

      <SubCard title={dict.traffic.countries}>
        {
          geo.length ? (
            <Bars items={geo.map((g: any) => ({ label: g.country, value: g.share, suffix: "%" }))} />
          ) : (
            <NoData />
          )
        }
      </SubCard>

      <SubCard title={dict.traffic.searchRanks}>
        <div class="flex flex-col gap-5">
          {
            ranks?.global || ranks?.country ? (
              <div class="grid grid-cols-2 gap-4">
                <div class="rounded-lg border border-border p-4">
                  <span class="text-xs text-ink-muted">{dict.traffic.globalRank}</span>
                  <p class="text-2xl font-semibold tabular-nums text-ink">
                    {ranks.global ? ranks.global.toLocaleString("en-US") : "—"}
                  </p>
                </div>
                <div class="rounded-lg border border-border p-4">
                  <span class="text-xs text-ink-muted">{dict.traffic.countryRank}</span>
                  <p class="text-2xl font-semibold tabular-nums text-ink">
                    {ranks.country ? ranks.country.toLocaleString("en-US") : "—"}
                  </p>
                </div>
              </div>
            ) : null
          }
          {
            keywords.some((k) => k.volume != null) ? (
              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                  <thead class="text-xs text-ink-muted">
                    <tr>
                      <th class="py-2 font-medium">{dict.keywords.term}</th>
                      <th class="whitespace-nowrap py-2 text-right font-medium">{dict.keywords.volume}</th>
                      <th class="whitespace-nowrap py-2 text-right font-medium">{dict.keywords.cpc}</th>
                      <th class="whitespace-nowrap py-2 text-right font-medium">{dict.keywords.traffic}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {keywords.slice(0, 8).map((k: any) => (
                      <tr class="border-t border-border">
                        <td class="py-2.5 text-ink">{k.term}</td>
                        <td class="whitespace-nowrap py-2.5 text-right tabular-nums text-ink-secondary">
                          {k.volume ? formatCount(k.volume) : "—"}
                        </td>
                        <td class="whitespace-nowrap py-2.5 text-right tabular-nums text-ink-secondary">
                          {k.cpc ? `$${k.cpc}` : "—"}
                        </td>
                        <td class="whitespace-nowrap py-2.5 text-right tabular-nums text-ink-secondary">
                          {k.traffic ?? "—"}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : null
          }
          {
            rankDistribution.length ? (
              <div>
                <span class="text-xs text-ink-muted">{dict.traffic.rankDistribution}</span>
                <div class="mt-2">
                  <Bars
                    items={rankDistribution.map((r: any) => ({
                      label: r.label,
                      value: r.count,
                      suffix: " 个",
                    }))}
                  />
                </div>
              </div>
            ) : null
          }
          {
            !keywords.length && !rankDistribution.length && !ranks?.global && !ranks?.country ? (
              <NoData />
            ) : null
          }
        </div>
      </SubCard>
    </div>

    <div slot="right" class="lg:sticky lg:top-32 lg:self-start">
      <div class="flex flex-col gap-4">
        {
          td ? (
            <>
              <div class="rounded-2xl border border-border bg-surface px-5 py-4">
                <div class="flex items-center gap-2">
                  <span aria-hidden="true">💡</span>
                  <h3 class="text-sm font-semibold text-ink">{dict.trafficDecrypt.overview}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{td.overview}</p>
              </div>
              {(td.sections ?? []).map((s: any) => (
                <div class="rounded-2xl border border-border bg-surface px-5 py-4">
                  <h3 class="text-sm font-semibold text-ink">{s.title}</h3>
                  {s.highlights?.length ? (
                    <div class="mt-2.5 flex flex-wrap gap-2">
                      {s.highlights.map((h: string) => (
                        <Badge>{h}</Badge>
                      ))}
                    </div>
                  ) : null}
                  <p class="mt-3 text-xs font-semibold text-ink-muted">{dict.trafficDecrypt.insight}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-secondary">{s.insight}</p>
                  <p class="mt-3 text-xs font-semibold text-ink-muted">{dict.trafficDecrypt.takeaway}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-secondary">{s.takeaway}</p>
                </div>
              ))}
            </>
          ) : (
            <Pending text={`${dict.sections.traffic.title} · ${dict.analysis.awaitingAI}`} />
          )
        }
      </div>
    </div>
  </Split>
</section>