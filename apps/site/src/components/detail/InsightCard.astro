---
/** 产品表现 · 洞察卡片（标题 + 副标题 + 正文，可选结论标签） */
import { getDict } from "../../../../web/src/lib/i18n";

interface Props {
  title: string;
  sub: string;
  text?: string;
  tag?: string;
}

const dict = getDict("zh");
const { title, sub, text, tag } = Astro.props;
---

<div class="flex h-full min-w-0 flex-col rounded-2xl border border-border bg-surface p-5">
  <div class="flex items-baseline justify-between gap-3">
    <h4 class="text-sm font-semibold text-ink">{title}</h4>
    <span class="shrink-0 text-xs text-ink-muted">{sub}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed break-words text-ink-secondary">
    {text ?? dict.performanceInsight.pending}
  </p>
  {
    tag ? (
      <span class="mt-4 inline-flex w-fit items-center rounded-full bg-success-soft px-3 py-1 text-xs font-medium text-success">
        {tag}
      </span>
    ) : null
  }
</div>