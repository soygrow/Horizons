---
/** 趋势阶段徽章：正在爆发 / 持续增长 / 新词观察 / 热度回落 */
import { trendStatusMeta } from "../../lib/trends";

interface Props {
  status: keyof typeof trendStatusMeta;
  withHint?: boolean;
}

const { status, withHint = false } = Astro.props;
const meta = trendStatusMeta[status];
---

<span
  title={meta.hint}
  class={`inline-flex w-fit items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-medium ${meta.cls}`}
>
  <span class={`h-1.5 w-1.5 rounded-full ${meta.dot}`}></span>
  {meta.label}
  {withHint ? <span class="font-normal opacity-80">{meta.hint}</span> : null}
</span>