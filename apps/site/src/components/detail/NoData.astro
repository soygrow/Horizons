---
/** 数据型空态：统一显示破折号，与内容型「待生成」区分 */
import { getDict } from "../../../../web/src/lib/i18n";

interface Props {
  note?: string;
}

const dict = getDict("zh");
const { note } = Astro.props;
const text = note ?? dict.analysis.noData;
---

<div
  title={text}
  class="flex h-32 flex-col items-center justify-center gap-1 rounded-xl border border-dashed border-border"
>
  <span class="text-sm tabular-nums text-ink-muted">—</span>
  <span class="text-xs text-ink-muted/70">{text}</span>
</div>