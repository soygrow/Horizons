---
import { formatDate } from "../../lib/format";

/** 搜索热度折线（0–100 归一化相对热度）+ 历史基线 */
interface Props {
  points: { date: string; value: number }[];
  baseline: number | null;
  peakDate: string | null;
}

const { points, baseline, peakDate } = Astro.props;

const W = 760;
const H = 240;
const PAD = { top: 18, right: 16, bottom: 26, left: 34 };

const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const x = (i: number) => PAD.left + (points.length <= 1 ? plotW / 2 : (i * plotW) / (points.length - 1));
const y = (v: number) => PAD.top + plotH - (Math.max(0, Math.min(100, v)) / 100) * plotH;

const coords = points.map((p, i) => ({ x: x(i), y: y(p.value) }));

const line = coords
  .map((c, i) => `${i === 0 ? "M" : "L"}${c.x.toFixed(1)},${c.y.toFixed(1)}`)
  .join(" ");
const area = `${line} L${x(points.length - 1).toFixed(1)},${(PAD.top + plotH).toFixed(1)} L${PAD.left},${(PAD.top + plotH).toFixed(1)} Z`;

const peakIndex = points.reduce((best, p, i) => (p.value > points[best].value ? i : best), 0);
const labelStep = Math.max(1, Math.ceil(points.length / 6));
---

<svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="搜索热度趋势">
  {
    [0, 50, 100].map((tick) => (
      <g>
        <line
          x1={PAD.left}
          x2={W - PAD.right}
          y1={y(tick)}
          y2={y(tick)}
          class="stroke-border"
          stroke-width="1"
          stroke-dasharray={tick === 0 ? undefined : "4 4"}
        />
        <text
          x={PAD.left - 6}
          y={y(tick) + 3.5}
          text-anchor="end"
          class="fill-current text-ink-muted"
          font-size="10"
        >
          {tick}
        </text>
      </g>
    ))
  }

  {
    baseline !== null && (
      <g>
        <line
          x1={PAD.left}
          x2={W - PAD.right}
          y1={y(baseline)}
          y2={y(baseline)}
          class="stroke-ink-muted"
          stroke-width="1"
          stroke-dasharray="2 3"
          opacity="0.7"
        />
        <text
          x={W - PAD.right}
          y={y(baseline) - 5}
          text-anchor="end"
          class="fill-current text-ink-muted"
          font-size="10"
        >
          基线 {baseline}
        </text>
      </g>
    )
  }

  <path d={area} class="fill-primary" opacity="0.08"></path>
  <path d={line} class="stroke-primary" fill="none" stroke-width="2" stroke-linejoin="round"></path>

  <circle
    cx={x(peakIndex)}
    cy={y(points[peakIndex].value)}
    r="3.5"
    class="fill-primary"
    stroke="white"
    stroke-width="1.5"
  />

  {
    points.map((p, i) =>
      i % labelStep === 0 || i === points.length - 1 ? (
        <text
          x={x(i)}
          y={H - 8}
          text-anchor={i === points.length - 1 ? "end" : i === 0 ? "start" : "middle"}
          class="fill-current text-ink-muted"
          font-size="10"
        >
          {formatDate(p.date)}
        </text>
      ) : null,
    )
  }
</svg>

<p class="mt-1 text-xs text-ink-muted">
  峰值 {points[peakIndex]?.value ?? "—"}{peakDate ? `（${formatDate(peakDate)}）` : ""}
</p>