---
interface Props {
  title: string;
  param: string;
  options: { value: string; label: string }[];
  current: string;
}

const { title, param, options, current } = Astro.props;
---

<label class="flex flex-col gap-1 text-xs text-ink-muted">
  <span class="font-medium">{title}</span>
  <select
    data-filter={param}
    class="rounded-lg border border-border bg-surface px-2.5 py-1.5 text-sm text-ink-secondary focus:border-primary focus:outline-none"
  >
    {options.map((o) => <option value={o.value} selected={o.value === current}>{o.label}</option>)}
  </select>
</label>