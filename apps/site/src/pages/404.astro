---
/** 404 页：Cloudflare assets 的 not_found_handling=404-page 会直出本页（状态码仍为 404） */
import Base from "../layouts/Base.astro";
import SearchInput from "../components/SearchInput.astro";

const title = "页面不存在 · Horizons";
const description = "你访问的页面不存在或已移动。可以回到首页，或从 AI 工具榜、GitHub 榜、AI 趋势词榜单继续浏览。";

const channels = [
  { label: "AI工具榜", href: "/tools" },
  { label: "GitHub榜", href: "/github" },
  { label: "AI趋势词榜单", href: "/trends" },
  { label: "AI模型榜", href: "/models" },
  { label: "机会榜", href: "/opportunity" },
  { label: "每日情报", href: "/daily" },
];
---

<Base title={title} description={description} noindex>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-xs font-medium tracking-[0.3em] text-ink-muted">404</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">这个页面不存在</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-secondary">
      链接可能已经失效，或者对应的工具 / 仓库 / 趋势词因数据不足已从当期榜单移出（下榜条目不再单独保留页面）。
      换个入口试试：
    </p>

    {/*
      从后台点进 /preview/<domain> 却撞到 404 的常见原因不是链接写错，
      而是这条待发布数据还没参与过站点构建（预览页是构建期从工作区导出的）。
      这里说明一句，省得去查链接。
    */}
    <p id="nf-preview-tip" class="mt-3 hidden max-w-xl text-sm leading-relaxed text-ink-secondary">
      <span id="nf-preview-domain" class="font-medium text-ink"></span>
      的预览页还没生成：待发布条目在站点构建时才导出，刚跑完「更新数据」的要等下一次构建。
      可以先回 <a href="/admin" class="text-primary underline underline-offset-2 hover:no-underline">后台</a> 核对字段。
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm">
      {
        channels.map((c) => (
          <a
            href={c.href}
            class="rounded-full border border-border bg-surface px-4 py-2 text-ink-secondary transition hover:text-ink"
          >
            {c.label}
          </a>
        ))
      }
      <a href="/" class="rounded-full bg-primary px-4 py-2 font-medium text-white transition hover:opacity-90">
        回到首页
      </a>
    </div>

    <div class="mt-10 w-full max-w-md">
      <SearchInput action="/tools" placeholder="搜索工具名称 / 关键词" />
    </div>
  </section>

  <script>
    // 停在 /preview/<domain> 上时，把通用 404 换成「预览还没生成」的说法
    const hit = /^\/preview\/([^/]+)\/?$/.exec(location.pathname);
    if (hit) {
      const heading = document.querySelector("h1");
      if (heading) heading.textContent = "这个预览页还没生成";
      const tip = document.getElementById("nf-preview-tip");
      const domain = document.getElementById("nf-preview-domain");
      if (domain) domain.textContent = decodeURIComponent(hit[1]);
      tip?.classList.remove("hidden");
    }
  </script>
</Base>