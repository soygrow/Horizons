---
/**
 * 每日情报首页：总结打头，详细内容跟在后面，其他信息与说明下移。
 *
 * 数据来自 content/digest/<date>.json —— 唯一真源是 D1 的 digest_issues，
 * 每次 `pnpm data` 先由 scripts/admin/hydrate-digest.ts 还原成文件。
 *
 * 阅读顺序 = 页面顺序：
 *   1. 本期总结 —— 这一期最重要的话，中文，一屏读完
 *   2. 详细内容 —— 头条全文 + 其余模块条目
 *   3. 其他信息 —— 构成、来源健康度、往期
 *
 * 只发已核验的条目（过滤在 lib/digest.ts 的 publishedDigest），
 * 所以页面不再出现「待核实」徽章与「还缺什么」。
 */
import Base from "../../layouts/Base.astro";
import {
  digests,
  latestDigest,
  digestCounts,
  MODULE_META,
  briefOf,
  categoryLabel,
  formatDate,
  formatTime,
  signalText,
  type ModuleKey,
} from "../../lib/digest";

const latest = latestDigest;
const latestCount = latest ? digestCounts(latest) : 0;
/** 期号：总期数倒排，最新一期即第 N 期 */
const issueNo = latest
  ? String(digests.length - digests.findIndex((d) => d.date === latest.date)).padStart(3, "0")
  : "—";

const brief = latest?.brief ?? null;
const headline = latest?.modules.find((m) => m.key === "headline") ?? null;
const headlineItems = (headline?.items ?? []).map((item) => ({ item, brief: briefOf(item) }));
const others = (latest?.modules ?? []).filter((m) => m.key !== "headline");
const archive = digests.slice(1, 9);

const title = "每日情报 · Horizons";
const description = latest
  ? `${formatDate(latest.date)} 的 AI 情报：${latestCount} 条，每一条都有一手出处。先读一段中文总结，再看详情。`
  : "每天 7:30 更新一份 AI 情报：新模型、能直接用的开源项目、价格与成本变化，以及今天就能动手的机会。先给总结，再给细节，每条都带原始链接。";

const MODULE_TONE = ["bg-primary", "bg-sky-500", "bg-violet-500", "bg-emerald-500"];
const composition = latest
  ? latest.modules.map((m, i) => ({
      name: MODULE_META[m.key]?.name ?? m.key,
      n: m.items.length,
      tone: MODULE_TONE[i % MODULE_TONE.length],
    }))
  : [];

/** 首屏摘要卡里的四个小数字；某类内容那天没有就是 0 */
const countOf = (key: ModuleKey): number =>
  latest?.modules.find((m) => m.key === key)?.items.length ?? 0;

const modules = [
  { no: "01", name: "今日头条", volume: "3–5 条", desc: "今天真正变了的事：模型发布、产品更新、政策与事故。讲清发生了什么、影响谁。", audience: "只想要一手资讯的人" },
  { no: "02", name: "能直接用的", volume: "2–5 条", desc: "开源项目、可自部署的工具、免费额度。标注许可证、上手成本和最近一次提交。", audience: "想低成本做出东西的人" },
  { no: "03", name: "成本与定价", volume: "1–3 条", desc: "API 降价、定价调整、融资收购、公开的商业化案例。看成本结构与收入来源，不追估值故事。", audience: "关注 AI 产品商业化的人" },
  { no: "04", name: "今天就能做", volume: "1–2 条", desc: "把资讯变成动作：试什么、拿什么验证、大概花多久。只写能测的下一步。", audience: "想立刻动手试的人" },
];

/**
 * 只发已核验：一句口径胜过两级分级表。
 * 原来这里列的是「已核验 / 待核实」两种证据状态，现在缺材料的不发，
 * 分级表也就没有意义了。
 */
const rule = {
  title: "只发能核对的",
  desc: "官方公告、原始仓库、官方文档、可复现数据 —— 四条里至少踩中一条才进榜。只有媒体转述、拿不出一手材料的内容直接不发。每一条上页面的内容都能点回原文。",
  points: [
    "每条都能点回原始出处，链接失效即视为不可引用",
    "参数、金额、用户数这类数字，没有来源就不写",
    "传闻、泄露、预告一律不收录",
  ],
};

const sources = [
  { name: "官方公告", detail: "OpenAI · DeepMind · Hugging Face" },
  { name: "代码仓库", detail: "GitHub 活跃榜与新增榜" },
  { name: "社区讨论", detail: "Hacker News" },
  { name: "科技媒体", detail: "The Verge · Ars Technica · BBC · MIT 科技评论" },
];

const faqs = [
  { q: "以后会收费吗？", a: "现在免费开放，不登录也能看完整一期。转订阅后每日正文会进入付费范围，但每条原始链接始终公开可点 —— 你随时能自己核对。" },
  { q: "会不会出现 AI 编造的内容？", a: "摘要只使用输入材料能支持的事实，参数、金额、用户数这类数字没有来源就不写。拿不出一手材料的条目直接不发，所以看到的每一条都能点回原文。" },
  { q: "和 AI 工具榜、GitHub 榜是什么关系？", a: "榜单回答「现在什么在涨」，情报回答「今天发生了什么」。情报里提到的项目和工具会链接回对应榜单条目。" },
  { q: "每天要看多久？", a: "先读总结约 30 秒；从头条扫到「今天就能做」约 3 分钟；连原始链接一起读，通常 10 分钟以内。" },
];
---

<Base title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/60">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_58%_at_30%_-10%,rgba(8,102,250,0.14),transparent),radial-gradient(50%_50%_at_92%_8%,rgba(112,63,244,0.10),transparent)]"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(12,31,80,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(12,31,80,0.05) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(60% 55% at 30% 10%, black, transparent 78%); -webkit-mask-image: radial-gradient(60% 55% at 30% 10%, black, transparent 78%);"
    ></div>

    <div class="relative mx-auto max-w-6xl px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16">
      <div class="grid items-center gap-10 lg:grid-cols-[1.06fr_0.94fr] lg:gap-12">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-[11px] font-medium text-ink-secondary">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"></span>
            </span>
            每天 07:30 更新 · 当前免费
          </span>

          <h1 class="mt-5 text-[1.7rem] font-bold leading-[1.22] tracking-tight text-ink sm:text-[2.6rem]">
            每天 7:30，<br />
            <span
              class="bg-clip-text text-transparent"
              style="background-image: linear-gradient(100deg, #0866fa 0%, #5b3cf3 55%, #703ff4 100%);"
              >一份能直接用的 AI 情报</span
            >
          </h1>

          <p class="mt-5 max-w-xl text-sm leading-[1.85] text-ink-secondary sm:text-[15px]">
            先给一段中文总结，说清今天最值得看的是什么；再按「头条 / 能直接用的 / 成本与定价 / 今天就能做」展开细节。每条都有一手出处，拿不出材料的不发。
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            {latest ? (
              <a
                href={`/daily/${latest.date}`}
                class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-white transition hover:bg-primary-hover"
              >
                读最新一期（{formatDate(latest.date)} · {latestCount} 条）→
              </a>
            ) : (
              <span class="rounded-xl border border-dashed border-border-strong px-5 py-2.5 text-sm font-medium text-ink-muted">第一期即将上线</span>
            )}
            <a href="#modules" class="rounded-xl border border-border px-5 py-2.5 text-sm font-medium text-ink-secondary transition hover:border-border-strong hover:text-ink">每天推什么</a>
          </div>

          <p class="mt-5 text-[11px] leading-relaxed text-ink-muted">
            {latest
              ? `每天 05:00 开始采集，07:30 出刊。本期读完 ${latest.stats.candidates} 条候选，留下 ${latestCount} 条。`
              : "第一期正在生成，下面是这份日报的取舍标准与更新方式。"}
          </p>
        </div>

        <!--
          首屏右卡：以前把 5 条头条的标题+两行摘要全塞进来，左列 300 多高、
          右列 600 多高，一进页面右边就拖出一条长尾巴。现在只放这一期的总结，
          高度与左列持平，具体条目往下走。
        -->
        <div class="relative">
          <div class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-[radial-gradient(60%_60%_at_60%_20%,rgba(8,102,250,0.13),transparent_70%)] blur-xl" aria-hidden="true"></div>
          <a
            href={latest ? `/daily/${latest.date}` : "/daily"}
            class="group relative block rounded-2xl border border-border bg-surface p-5 shadow-[0_18px_50px_-22px_rgba(12,31,80,0.35)] transition hover:border-border-strong sm:p-6"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <img src="/brand/mark.png" alt="" width="239" height="112" class="h-5 w-auto" />
                <span class="text-xs font-semibold text-ink">每日情报</span>
              </div>
              <span class="rounded-full bg-surface-2 px-2 py-0.5 text-[10px] text-ink-muted tabular-nums">
                {latest ? `第 ${issueNo} 期` : "待生成"}
              </span>
            </div>

            <div class="mt-3 flex items-center justify-between border-b border-border pb-3">
              <span class="text-[11px] text-ink-muted tabular-nums">{latest ? formatDate(latest.date) : "—"}</span>
              <span class="text-[11px] text-ink-muted tabular-nums">{latest ? `${latestCount} 条 · 全部可核对` : "—"}</span>
            </div>

            {brief ? (
              <p class="mt-3 line-clamp-5 text-[13px] leading-[1.9] text-ink sm:text-sm" title={brief.lead}>{brief.lead}</p>
            ) : (
              <p class="mt-3 text-[13px] leading-[1.9] text-ink-secondary">第一期还在生成，稍后这里会是一段今天的中文总结。</p>
            )}

            <dl class="mt-4 grid grid-cols-4 gap-1 rounded-lg bg-surface-2 px-2 py-2.5 text-center">
              {[
                { key: "headline" as ModuleKey, name: "头条" },
                { key: "tools" as ModuleKey, name: "能用" },
                { key: "money" as ModuleKey, name: "成本" },
                { key: "action" as ModuleKey, name: "可做" },
              ].map((m) => (
                <div>
                  <dd class="text-sm font-semibold text-ink tabular-nums">{countOf(m.key)}</dd>
                  <dt class="mt-0.5 text-[10px] text-ink-muted">{m.name}</dt>
                </div>
              ))}
            </dl>

            <p class="mt-3 flex items-center justify-end gap-1 text-[11px] font-medium text-primary">
              看这一段在讲什么
              <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. 本期总结：整页的信息中心 -->
  {
    latest && brief && (
      <section id="brief" class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
        <div class="rounded-3xl border border-border bg-surface p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-[11px] font-semibold tracking-wide text-primary">本期总结</h2>
            <span class="text-[11px] text-ink-muted tabular-nums">
              {formatDate(latest.date)} · 第 {issueNo} 期 · {latestCount} 条
            </span>
          </div>

          <p class="mt-4 max-w-[72ch] text-[17px] leading-[1.95] text-ink sm:text-lg sm:leading-[2]">{brief.lead}</p>

          {brief.points.length > 0 && (
            <ol class="mt-6 grid gap-2.5 border-t border-border pt-5 sm:grid-cols-3 sm:gap-4">
              {brief.points.map((point, i) => (
                <li class="flex gap-2.5 text-[12.5px] leading-[1.8] text-ink-secondary">
                  <span class="mt-0.5 shrink-0 font-mono text-[11px] text-ink-muted tabular-nums">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="min-w-0">{point}</span>
                </li>
              ))}
            </ol>
          )}

          <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
            <p class="text-[11px] text-ink-muted">总结只做归纳，不引入新材料；往下每一条都能点回原文核对。</p>
            <a href={`/daily/${latest.date}`} class="text-[11px] font-medium text-primary transition hover:underline">
              在单独页面读这一期 →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 2. 详细内容：头条 -->
  {
    latest && headline && (
      <section id="latest" class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-14">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border pb-4">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">详细内容 · 今日头条</h2>
            <p class="mt-1 text-[11px] text-ink-muted">
              生成于 {formatTime(latest.generatedAt)} · 只从新闻类来源里挑，Star 数不决定头条
            </p>
          </div>
          <a href={`/daily/${latest.date}`} class="text-[11px] text-ink-secondary transition hover:text-ink">完整一期（含全部模块）→</a>
        </div>

        <ul class="divide-y divide-border">
          {headlineItems.map(({ item, brief: line }, i) => (
            <li id={item.id} class="flex gap-3 py-5 sm:gap-4">
              <div class="w-7 shrink-0 text-center">
                <span class="text-[11px] font-semibold text-ink-muted tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                <div class="mt-1.5 flex flex-col items-center gap-[3px]" aria-hidden="true">
                  {Array.from({ length: 5 }, (_, k) => (
                    <span class:list={["h-[3px] w-3.5 rounded-full", k < item.heat ? "bg-primary" : "bg-ink-muted/20"]} />
                  ))}
                </div>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-ink-muted">
                  <span class="rounded-md border border-border bg-surface-2 px-1.5 py-0.5 text-ink-secondary">{categoryLabel(item.category)}</span>
                  {signalText(item).map((s) => <span class="tabular-nums">{s}</span>)}
                </div>

                <p class="mt-2 max-w-[78ch] text-[15px] leading-[1.85] text-ink">{line.fact}</p>
                <p class="mt-1.5 max-w-[78ch] text-[15px] leading-[1.85] text-ink-secondary">{line.why}</p>

                <div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-ink-muted">
                  <span class="shrink-0">原文</span>
                  {item.sources[0] ? (
                    <a
                      href={item.sources[0].url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="min-w-0 truncate text-ink-secondary underline decoration-border underline-offset-2 transition hover:text-primary"
                    >{item.title}</a>
                  ) : (
                    <span class="min-w-0 truncate text-ink-secondary">{item.title}</span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 2. 详细内容：其余模块（首页一行一条，细节在单独页面） -->
  {
    latest && others.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-14">
        <div class="flex flex-wrap items-end justify-between gap-3 border-b border-border pb-4">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">详细内容 · 其余模块</h2>
            <p class="mt-1.5 text-sm text-ink-secondary">同一天里能直接用的东西、钱在往哪流，以及半小时内可验证的动作。</p>
          </div>
          <a
            href={`/daily/${latest.date}`}
            class="rounded-lg border border-border bg-surface px-3 py-1.5 text-[11px] text-ink-secondary transition hover:border-border-strong hover:text-ink"
          >看全部 {latestCount} 条 →</a>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {others.map((mod) => (
            <article class="rounded-2xl border border-border bg-surface p-4">
              <div class="flex items-center justify-between gap-2 border-b border-border pb-2.5">
                <div class="flex items-baseline gap-2">
                  <span class="font-mono text-[11px] text-ink-muted/70">{MODULE_META[mod.key].no}</span>
                  <h3 class="text-sm font-semibold text-ink">{MODULE_META[mod.key].name}</h3>
                </div>
                <span class="text-[11px] text-ink-muted tabular-nums">{mod.items.length} 条</span>
              </div>

              <ul class="mt-1">
                {mod.items.map((item) => (
                  <li class="border-b border-border/70 py-2.5 last:border-b-0">
                    <a
                      href={`/daily/${latest.date}#${item.id}`}
                      class="line-clamp-2 text-[13px] font-medium leading-snug text-ink transition hover:text-primary"
                    >{item.summary}</a>
                    <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10px] text-ink-muted">
                      <span>{categoryLabel(item.category)}</span>
                      <span class="text-border-strong">·</span>
                      <span>{item.sources[0]?.label ?? "原文"}</span>
                    </p>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- 3. 其他信息 -->
  <section class="mt-14 border-t border-border/60 bg-surface/40">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">其他信息</h2>
          <p class="mt-1.5 text-sm text-ink-secondary">这一期是怎么拼出来的、数据从哪来、以及前面几期。</p>
        </div>
        {latest && <span class="text-[11px] text-ink-muted tabular-nums">第 {issueNo} 期 · {formatDate(latest.date)}</span>}
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-[1.12fr_0.88fr]">
        <div class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-sm font-semibold text-ink">本期构成</h3>
            <span class="text-[11px] text-ink-muted tabular-nums">
              {latest ? `从 ${latest.stats.candidates} 条候选里选出 ${latestCount} 条` : "—"}
            </span>
          </div>

          {composition.length > 0 && (
            <>
              <div class="mt-3 flex h-2 gap-px overflow-hidden rounded-full bg-surface-2">
                {composition.map((c) => (
                  <span class={c.tone} style={`width: ${(c.n / Math.max(1, latestCount)) * 100}%`} title={`${c.name} ${c.n} 条`} />
                ))}
              </div>
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
                {composition.map((c) => (
                  <li class="flex items-center gap-1.5 text-[11px] text-ink-secondary">
                    <span class:list={["h-1.5 w-1.5 rounded-full", c.tone]} />
                    {c.name}
                    <span class="text-ink-muted tabular-nums">{c.n}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          <p class="mt-4 border-t border-border pt-3 text-[11px] leading-relaxed text-ink-muted">
            删掉的每一条都记了原因：与主题无关、缺一手材料、当天已出现过、分数不够，或模块配额已满。漏报了可以回溯。
          </p>

          {latest && latest.sourceHealth.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {latest.sourceHealth.map((s) => (
                <li
                  class:list={[
                    "inline-flex items-center gap-1.5 rounded-md border px-2 py-1 text-[11px]",
                    s.ok ? "border-border bg-surface-2 text-ink-secondary" : "border-red-500/25 bg-red-500/10 text-red-600 dark:text-red-400",
                  ]}
                  title={s.error ?? s.note ?? ""}
                >
                  <span class:list={["h-1.5 w-1.5 rounded-full", s.ok ? "bg-emerald-500" : "bg-red-500"]} />
                  {s.source}
                  <span class="text-ink-muted tabular-nums">{s.items} 条</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="rounded-2xl border border-border bg-surface p-5">
          <h3 class="text-sm font-semibold text-ink">四类来源 · 每天 07:30</h3>
          <ul class="mt-3 space-y-2">
            {sources.map((s, i) => (
              <li class="flex items-start gap-2.5 rounded-lg bg-surface-2 px-3 py-2">
                <span class="mt-0.5 font-mono text-[10px] text-ink-muted/70">{String(i + 1).padStart(2, "0")}</span>
                <span class="min-w-0">
                  <span class="block text-[13px] text-ink-secondary">{s.name}</span>
                  <span class="mt-0.5 block text-[10px] leading-relaxed text-ink-muted">{s.detail}</span>
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-[11px] leading-relaxed text-ink-muted">
            按各接口的速率限制运行，不绕验证、不碰需登录的内容；源失败会在上面标红，不会让整期缺内容。
          </p>
        </div>
      </div>

      {archive.length > 0 && (
        <div class="mt-4 rounded-2xl border border-border bg-surface p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-sm font-semibold text-ink">往期</h3>
            <span class="text-[11px] text-ink-muted tabular-nums">共 {digests.length} 期</span>
          </div>
          <ul class="mt-3 grid gap-1.5 sm:grid-cols-2 lg:grid-cols-4">
            {archive.map((d) => (
              <li>
                <a
                  href={`/daily/${d.date}`}
                  class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-2 text-[12px] text-ink-secondary transition hover:text-ink"
                >
                  <span class="tabular-nums">{formatDate(d.date)}</span>
                  <span class="text-[10px] text-ink-muted tabular-nums">{digestCounts(d)} 条</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- 每天推什么 -->
  <section id="modules" class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="max-w-2xl">
      <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">四个模块，固定顺序</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-secondary">
        每一期都是这四块，顺序不变：先看变了什么，再看能用什么、钱往哪流，最后是今天能动手的下一步。
      </p>
    </div>

    <div class="mt-7 grid gap-4 sm:grid-cols-2">
      {modules.map((m) => (
        <article class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-semibold text-ink">{m.name}</h3>
            <span class="font-mono text-[11px] text-ink-muted/70">{m.no}</span>
          </div>
          <p class="mt-1 text-[10px] text-ink-muted">{m.volume} · 给{m.audience}</p>
          <p class="mt-2.5 text-[13px] leading-relaxed text-ink-secondary">{m.desc}</p>
        </article>
      ))}
    </div>

    {/* 只发能核对的：这里原来是一张两级证据分级表 */}
    <div class="mt-4 rounded-2xl border border-primary/20 bg-primary/[0.04] p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-sm font-semibold text-ink">{rule.title}</h3>
        <span class="rounded-full border border-primary/25 bg-surface px-2 py-0.5 text-[10px] font-medium text-primary">全部有一手出处</span>
      </div>
      <p class="mt-3 max-w-3xl text-[13px] leading-[1.85] text-ink-secondary">{rule.desc}</p>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
        {rule.points.map((p) => (
          <li class="flex items-start gap-1.5 text-[11px] text-ink-secondary">
            <span class="mt-[3px] shrink-0 text-primary" aria-hidden="true">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-border/60 bg-surface/40">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">开始之前，你可能想问</h2>
      <div class="mt-6 max-w-3xl space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-surface">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-ink">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-ink-muted transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-ink-secondary">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 收尾 CTA -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="rounded-3xl border border-border bg-surface px-6 py-10 text-center sm:px-10">
      <h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">先把今天这一段话读完</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink-secondary">
        总结讲清今天最重要的变化，细节留给需要的人。每天 07:30 更新，免费，不登录也能看完整一期。
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        {latest && (
          <a
            href={`/daily/${latest.date}`}
            class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-white transition hover:bg-primary-hover"
          >读最新一期（{formatDate(latest.date)}）→</a>
        )}
        <a
          href="/tools"
          class="rounded-xl border border-border px-5 py-2.5 text-sm font-medium text-ink-secondary transition hover:border-border-strong hover:text-ink"
        >看看 AI 工具榜</a>
      </div>
    </div>
  </section>
</Base>