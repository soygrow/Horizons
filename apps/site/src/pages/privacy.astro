---
/**
 * 隐私政策。正文以 docs/00-1-隐私政策.md 为准，措辞不改变原意。
 * 布局：左侧章节标题 + 右侧正文的两栏文档式排版（md 以上），窄屏自动堆叠。
 */
import Base from "../layouts/Base.astro";

const updated = "2026 年 10 月 8 日";
const contact = "308541325@qq.com";

const sections: Array<{ id: string; title: string; paragraphs: string[]; items?: string[] }> = [
  {
    id: "collect",
    title: "我们收集的信息",
    paragraphs: [],
    items: [
      "账户信息：注册或登录时提供的电子邮箱；若使用 GitHub、Google 等第三方账号登录，我们会获取其返回的基础资料（如昵称、头像、邮箱）。",
      "Cookie 及类似技术：用于维持登录状态、记住你的偏好设置，以及识别推广来源。你可以在浏览器中管理或清除 Cookie，但部分依赖 Cookie 的功能（如保持登录）可能因此无法正常使用。",
      "使用数据：你访问的页面、停留时长、浏览器类型、IP 地址等，用于统计分析与产品改进。",
      "支付信息：订阅付款由第三方支付平台（如 Paddle）处理，我们不存储你的银行卡号等敏感支付信息，仅保留必要的订单与订阅状态记录。",
    ],
  },
  {
    id: "usage",
    title: "我们如何使用信息",
    paragraphs: [],
    items: [
      "提供、维护与改进本网站的服务。",
      "维持登录状态，保障账户安全。",
      "处理订阅，并发送必要的服务通知（如支付结果、重要变更）。",
      "统计分析访问情况，优化使用体验。",
    ],
  },
  {
    id: "sharing",
    title: "信息共享",
    paragraphs: [
      "我们不会出售你的个人信息。仅在以下情形共享必要的信息：为完成服务所必需的第三方服务商（如登录认证、支付处理、邮件发送）、法律法规要求，或经你明确同意。",
    ],
  },
  {
    id: "security",
    title: "数据安全",
    paragraphs: [
      "我们采取合理的技术与管理措施保护你的个人信息，防止未经授权的访问、篡改或泄露。但请理解，互联网传输不存在绝对安全，我们无法保证信息的绝对安全性。",
    ],
  },
  {
    id: "changes",
    title: "政策变更",
    paragraphs: [
      "我们可能不时更新本政策，更新后会发布在本页面并调整顶部日期。继续使用本网站即视为接受更新后的政策。",
    ],
  },
  {
    id: "contact",
    title: "联系我们",
    paragraphs: ["如对本隐私政策有任何疑问，欢迎邮件联系管理员。"],
  },
];
---

<Base
  title="隐私政策 · Horizons"
  description="地平线（horizons.tools）隐私政策：我们收集哪些信息、如何使用、如何共享，以及你可以怎样联系我们。"
>
  <article class="relative">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_50%_-8%,rgba(8,102,250,0.09),transparent)]"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-4 pb-24 pt-14 sm:px-6 sm:pt-16">
      <header class="border-b border-border pb-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">隐私政策</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
          我们如何收集、使用与保护你的信息
        </p>
        <p
          class="mt-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-ink-muted"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
          最后更新 {updated}
        </p>
      </header>

      <section class="grid gap-3 border-b border-border py-10 md:grid-cols-[190px_1fr] md:gap-10">
        <h2 class="text-sm font-semibold text-ink md:text-base">引言</h2>
        <div class="space-y-3">
          <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">
            欢迎使用地平线（horizons.tools，下称「本网站」）。我们重视你的隐私，本政策说明我们在你使用本网站时收集哪些信息、如何使用这些信息，以及你可以怎样联系我们。
          </p>
          <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">
            当你注册或登录本网站时，即表示你已阅读并同意本隐私政策及《<a
              href="/terms"
              class="text-primary underline-offset-4 hover:underline">服务条款</a
            >》。
          </p>
        </div>
      </section>

      {
        sections.map((s, i) => (
          <section
            id={s.id}
            class="grid gap-3 border-b border-border py-10 last:border-0 md:grid-cols-[190px_1fr] md:gap-10"
          >
            <div>
              <span class="font-mono text-[11px] tracking-widest text-ink-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h2 class="mt-1 text-sm font-semibold text-ink md:text-base">{s.title}</h2>
            </div>

            <div class="space-y-3">
              {s.paragraphs.map((p) => (
                <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">{p}</p>
              ))}

              {s.items && (
                <ul class="space-y-3">
                  {s.items.map((it) => {
                    const [label, ...rest] = it.split("：");
                    const hasLabel = rest.length > 0;
                    return (
                      <li class="flex gap-3">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/70" aria-hidden="true" />
                        <span class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">
                          {hasLabel && <strong class="font-medium text-ink">{label}：</strong>}
                          {hasLabel ? rest.join("：") : it}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              )}

              {s.id === "contact" && (
                <a
                  href={`mailto:${contact}`}
                  class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-medium text-ink transition hover:border-primary/40 hover:text-primary"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M3 5a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H3zm0 1.5h14a.5.5 0 01.32.12L10 11.2 2.68 6.62A.5.5 0 013 6.5z" />
                  </svg>
                  {contact}
                </a>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>