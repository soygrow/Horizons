---
/**
 * 趋势词详情预览页（按需渲染）。
 *
 * 和线上 /trends/[slug] 用**同一个** TrendBody 渲染，只有数据来源不同。
 * 数据按「最新可见版本」取：
 *   1. 候选池里有这条词（刚更新 / 待富化 / 富化完成）→ 渲染候选池里的新版；
 *   2. 否则回落到当前线上版本（board_listed + board_listed_details）。
 *
 * 这样线上榜单每一行的「预览」都点得开：更新前看的是线上内容，更新后刷新
 * 就是候选池里的新内容，发布后又变回（新的）线上版本。改完数据刷新即生效，
 * 不需要为预览等一次整站构建。
 *
 * 只在后台内部使用：站点 Worker 对 /preview/* 统一校验管理员会话后才放行，
 * Base 里非白名单路径自动 noindex，sitemap 也不收录。
 */
export const prerender = false;

import Base from "../../../layouts/Base.astro";
import TrendBody from "../../../components/detail/TrendBody.astro";
import { env } from "cloudflare:workers";

/**
 * 哪些状态值得预览。
 *
 * `candidate` 必须在内：采集落库后 stage 就是 candidate，只收 enriched 的话
 * 「刚采完 → 点预览」永远打不开，而审核员恰恰在这一步判断要不要继续富化。
 * `rejected` 排除（判定不收录的没有预览价值），`published` 也排除
 * （已发布的直接看线上页，那里才是读者最终看到的形态）。
 */
const PREVIEW_STAGES = new Set(["candidate", "enriched", "enriching", "enrich_failed"]);

const STAGE_LABEL: Record<string, string> = {
  candidate: "刚采集完，内容字段还没富化",
  enriched: "富化完成，等待发布",
  enriching: "富化进行中，部分字段还会变",
  enrich_failed: "富化失败，下面可能是残缺数据",
  published: "当前线上版本",
};

interface D1Like {
  prepare(sql: string): {
    bind(...values: unknown[]): {
      first<T = Record<string, unknown>>(): Promise<T | null>;
    };
  };
}

interface BoardRow {
  card?: string | Record<string, unknown> | null;
  status?: string;
  version?: string;
}

const { slug } = Astro.params;
const db = (env as { DB?: D1Like }).DB;

/** 预览数据出处：候选池里的新版优先，没有再看线上版本 */
let source: "staging" | "listed" = "staging";
let trend: Record<string, any> | null = null;
let stage = "enriched";

function parseCard(raw: string | Record<string, unknown> | null | undefined): Record<string, any> | null {
  if (!raw) return null;
  try {
    return typeof raw === "string" ? (JSON.parse(raw) as Record<string, any>) : (raw as Record<string, any>);
  } catch {
    return null;
  }
}

if (slug && db) {
  /*
   * 候选池的 item_key 是「关键词小写」（采集时用它做去重），而详情页的
   * canonical 是 slug，两者不一定相同（关键词带空格/大写）。
   * 所以按卡片里的 slug 查，而不是按主键。
   */
  const row = await db
    .prepare(
      `SELECT card, status FROM board_items
       WHERE board = 'trends' AND json_extract(card, '$.slug') = ?
       LIMIT 1`,
    )
    .bind(slug)
    .first<BoardRow>()
    .catch(() => null);

  const status = String(row?.status ?? "");
  if (row?.card && PREVIEW_STAGES.has(status)) {
    const card = parseCard(row.card);
    if (card) {
      trend = card;
      stage = status;
    }
  }

  /*
   * 候选池没有（或状态不预览）时回落到当前线上版本。
   *
   * 线上数据在 board_listed（名次 + 卡片）与 board_listed_details（完整对象）里，
   * 版本指针取 app_config 的 config.current_version —— 和 hydrate 脚本
   * 还原榜单文件时用的是同一条链路。这样「更新前先看看现在长什么样」不用再另开页面。
   */
  if (!trend) {
    const listed = await db
      .prepare(
        `SELECT d.detail AS card, l.version AS version
           FROM board_listed l
           JOIN board_listed_details d
             ON d.version = l.version AND d.board = l.board AND d.item_key = l.item_key
          WHERE l.board = 'trends'
            AND l.version = (SELECT val FROM app_config WHERE key = 'config.current_version')
            AND (json_extract(l.card, '$.slug') = ? OR l.item_key = ?)
          LIMIT 1`,
      )
      .bind(slug, slug)
      .first<BoardRow>()
      .catch(() => null);

    const card = parseCard(listed?.card);
    if (card) {
      trend = card;
      stage = "published";
      source = "listed";
    }
  }
}

/*
 * 候选池和线上版本都没有才 404：slug 写错，或这个词从没进过榜。
 */
if (!trend) {
  return new Response("预览不存在：候选池与线上榜单都没有这个词，或 slug 有误。", {
    status: 404,
    headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" },
  });
}

const data = trend;
---
<Base
  title={`[预览] ${data.normalizedName ?? data.keyword} 趋势分析`}
  description={data.why ?? `「${data.keyword}」的趋势预览`}
  noindex={true}
>
  {/* 预览条：一眼看出这不是线上页面，并且能直接跳回后台 */}
  <div class="border-b border-primary/30 bg-primary-soft">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-xs text-primary sm:px-6">
      <span class="rounded-full bg-primary px-2 py-0.5 font-semibold text-white">预览</span>
      <span class="font-medium">{data.keyword}</span>
      <span class="text-primary/80">· {STAGE_LABEL[stage] ?? stage}</span>
      {
        source === "listed" ? (
          <span class="text-primary/60">· 与外网当前内容一致 · 候选池有新版时优先显示新版</span>
        ) : (
          <span class="text-primary/60">· 尚未发布到榜单 · 仅管理员可见</span>
        )
      }
      <a href="/admin" class="ml-auto font-medium underline underline-offset-2 hover:no-underline">返回后台</a>
    </div>
  </div>

  <TrendBody trend={data} related={[]} dataMode="live" snapshot={data.updatedAt} />
</Base>