---
/**
 * 历史机会归档：只承接「非最新批次」。
 * 最新一批留在 /opportunity，保证首页注意力集中；归档页只做回看，不抢主榜。
 * 版式按「时间轴」组织：左侧批次坐标，右侧该批 5 条的索引。
 */
import Base from "../../layouts/Base.astro";
import { gradeTone, scoreTone } from "../../lib/opportunity";
import {
  archivedOpportunityRows,
  opportunityBatches,
  opportunityIndex,
} from "../../lib/dataset";

const currentBatch = opportunityBatches.find((b) => b.isLatest);
const pastBatches = opportunityBatches.filter((b) => !b.isLatest);
const total = archivedOpportunityRows.length;

const title = "历史机会 · 机会榜 · Horizons";
const description =
  "往期机会批次归档：按周回看过去的机会判断、评分与失效条件。窗口有明显时效，越早的批次越可能已经过期，请结合发布周与失效条件一起读。";
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <nav class="text-[11px] text-ink-muted">
      <a href="/opportunity" class="transition hover:text-ink">机会榜</a>
      <span class="mx-1.5 text-border">/</span>
      <span class="text-ink-secondary">历史归档</span>
    </nav>

    <header class="mt-4">
      <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-ink-muted">
        <span class="inline-flex items-center gap-1.5 font-medium text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary" />
          归档
        </span>
        <span class="text-ink-secondary">{pastBatches.length} 批 · {total} 条</span>
        <span class="text-border">·</span>
        <span>当前最新 {currentBatch?.label ?? "—"}</span>
      </p>

      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-[2.25rem]">
        历史机会
      </h1>
      <p class="mt-4 max-w-2xl text-[15px] leading-7 text-ink-secondary">
        每周一批 5 条，主榜只保留最新一批，更早的批次收在这里。
        机会有时效：窗口多在 6–12 个月，越早的批次越可能已经被填上或被证伪，读的时候请连同时效条件一起看。
      </p>
    </header>

    {pastBatches.length === 0 ? (
      <div class="mt-8 overflow-hidden rounded-2xl border border-dashed border-border">
        <div class="px-6 py-10 text-center">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-2 px-2.5 py-1 text-[11px] text-ink-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink-muted/50" />
            下周开始累积
          </span>
          <p class="mt-4 text-sm font-semibold text-ink">还没有更早的批次</p>
          <p class="mx-auto mt-2 max-w-sm text-xs leading-6 text-ink-muted">
            当前只有 {currentBatch?.label ?? "最新一批"}（{opportunityIndex.latestBatch}）。下一批上线时，这一批 5 条会整体移到此处，按周向下累积。
          </p>
        </div>
        <div class="flex flex-col items-center gap-3 border-t border-border bg-surface-2/40 px-6 py-4 sm:flex-row sm:justify-between">
          <span class="text-[11px] text-ink-muted">归档只保留发布时的判断与证据，不再更新预算与价格。</span>
          <a
            href="/opportunity"
            class="shrink-0 rounded-lg border border-primary/40 bg-primary/10 px-3.5 py-2 text-xs font-medium text-primary transition hover:border-primary/70 hover:bg-primary/15"
          >
            ← 返回本期 5 条
          </a>
        </div>
      </div>
    ) : (
      <div class="mt-12 space-y-12">
        {pastBatches.map((batch) => (
          <section class="grid gap-4 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-8">
            <!-- 批次坐标 -->
            <div class="sm:sticky sm:top-24 sm:self-start">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-ink-muted/50" />
                <h2 class="text-sm font-semibold text-ink">{batch.label}</h2>
              </div>
              <p class="mt-1 pl-3.5 font-mono text-[11px] tabular-nums text-ink-muted">{batch.range}</p>
              <p class="mt-0.5 pl-3.5 text-[11px] text-ink-muted">
                {batch.count} 条 · 均分 {batch.avgOverall.toFixed(1)}
              </p>
              <div class="ml-3.5 mt-2 h-1 w-16 overflow-hidden rounded-full bg-surface-2">
                <div class="h-full rounded-full bg-ink-muted/40" style={`width: ${batch.avgOverall}%`} />
              </div>
            </div>

            <!-- 该批索引 -->
            <ul class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
              {archivedOpportunityRows
                .filter((r) => r.batch === batch.batch)
                .map((row) => (
                  <li>
                    <a
                      href={`/opportunity/${row.slug}`}
                      class="group grid gap-1.5 px-4 py-3.5 transition hover:bg-surface-2/40 sm:grid-cols-[2rem_minmax(0,1fr)_auto] sm:items-center sm:gap-4 sm:px-5"
                    >
                      <span class="font-mono text-xs tabular-nums text-ink-muted">
                        {String(row.rank).padStart(2, "0")}
                      </span>

                      <span class="min-w-0">
                        <span class="flex items-center gap-2">
                          <span class="truncate text-sm font-medium text-ink transition group-hover:text-primary">
                            {row.title}
                          </span>
                          <span
                            class:list={[
                              "shrink-0 rounded border px-1 py-px text-[10px] font-bold leading-tight",
                              gradeTone[row.grade],
                            ]}
                          >
                            {row.grade}
                          </span>
                        </span>
                        <span class="mt-1 block truncate text-[11px] text-ink-muted">
                          一个人 {row.solo.weeks} 周 · {row.money.price} · 窗口 {row.window}
                        </span>
                      </span>

                      <span class="flex items-center gap-3 sm:justify-end">
                        <span class="text-[11px] text-ink-muted">
                          {row.boardCount} 榜 · {row.evidenceCount} 证据
                        </span>
                        <span
                          class:list={[
                            "font-mono text-sm font-semibold tabular-nums",
                            scoreTone(row.overall),
                          ]}
                        >
                          {row.overall.toFixed(1)}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))}
      </div>
    )}

    <div class="mt-10 border-t border-border pt-5">
      <p class="max-w-2xl text-xs leading-6 text-ink-muted">
        窗口已经关闭的机会仍然可读：知道自己错过了什么、为什么错过，比再多看五条新机会更有用。
        <a href="/opportunity#policy" class="ml-1 font-medium text-primary hover:underline">收录原则 →</a>
      </p>
    </div>
  </div>
</Base>