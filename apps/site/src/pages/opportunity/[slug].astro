---
/**
 * 机会详情：证据、路径、效果全部来自构建期产物；
 * 每条证据带榜单主键与实时数值，可点回原榜单条目。
 *
 * 页面主体在 components/detail/OpportunityBody.astro —— 后台的候选预览
 * （/preview/opp/[slug]）用的是同一个组件，评审看到的就是发布后的样子。
 */
import Base from "../../layouts/Base.astro";
import OpportunityBody from "../../components/detail/OpportunityBody.astro";
import type { OpportunityDetail } from "../../lib/opportunity";
import { allOpportunities } from "../../lib/dataset";

export function getStaticPaths() {
  const all = allOpportunities();
  return all.map((opp, i) => ({
    params: { slug: opp.slug },
    props: { opp, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { opp, prev, next } = Astro.props as {
  opp: OpportunityDetail;
  prev: OpportunityDetail | null;
  next: OpportunityDetail | null;
};

const title = `${opp.title} · 机会榜`;
const description = opp.oneLiner;
---

<Base title={title} description={description}>
  <OpportunityBody opp={opp} prev={prev} next={next} />
</Base>