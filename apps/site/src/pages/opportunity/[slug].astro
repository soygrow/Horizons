---
/**
 * 机会详情：证据、路径、效果全部来自构建期产物；
 * 每条证据带榜单主键与实时数值，可点回原榜单条目。
 */
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/detail/SectionHeader.astro";
import Stat from "../../components/detail/Stat.astro";
import {
  BOARD_LABELS,
  OPPORTUNITY_WEIGHTS,
  gradeTone,
  scoreTone,
} from "../../lib/opportunity";
import type { BoardKey, OpportunityDetail } from "../../lib/opportunity";
import { allOpportunities } from "../../lib/dataset";

export function getStaticPaths() {
  const all = allOpportunities();
  return all.map((opp, i) => ({
    params: { slug: opp.slug },
    props: { opp, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { opp, prev, next } = Astro.props as {
  opp: OpportunityDetail;
  prev: OpportunityDetail | null;
  next: OpportunityDetail | null;
};

const BOARD_ORDER: BoardKey[] = ["trends", "tools", "github", "models"];
const grouped = BOARD_ORDER.map((board) => ({
  board,
  label: BOARD_LABELS[board],
  items: opp.evidence.filter((e) => e.board === board),
})).filter((g) => g.items.length);

/** 章节导航：只放七个主体章节，侧栏与页脚不进目录 */
const toc = [
  { id: "where", no: "01", label: "机会在哪里" },
  { id: "solo", no: "02", label: "一个人怎么干" },
  { id: "evidence", no: "03", label: "四榜证据" },
  { id: "build", no: "04", label: "怎么做" },
  { id: "path", no: "05", label: "实施路径" },
  { id: "outcome", no: "06", label: "效果" },
  { id: "risks", no: "07", label: "风险" },
];

const firstAction = opp.path[0]?.actions[0];
const leverageLabels = opp.build.leverage.map(
  (l) => opp.build.leverageLabels.find((x) => x.kind === l.kind)?.label ?? l.kind,
);

const title = `${opp.title} · 机会榜`;
const description = opp.oneLiner;
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 pb-16 pt-6 sm:px-6">
    <nav class="flex min-w-0 items-center gap-1.5 text-[11px] text-ink-muted">
      <a href="/opportunity" class="shrink-0 transition hover:text-ink">机会榜</a>
      <span class="shrink-0 text-border">/</span>
      {!opp.isLatest && (
        <>
          <a href="/opportunity/archive" class="shrink-0 transition hover:text-ink">历史</a>
          <span class="shrink-0 text-border">/</span>
        </>
      )}
      <span class="truncate text-ink-secondary">{opp.title}</span>
    </nav>

    {!opp.isLatest && (
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 border-l-2 border-amber-500/60 bg-amber-500/5 px-4 py-2.5 text-[11px] leading-5 text-ink-secondary">
        <span class="font-medium text-amber-500">历史批次</span>
        <span>发布于 {opp.batchLabel}（{opp.batchRange}），窗口与价格可能已变化，请结合「什么条件下不成立」一起读。</span>
        <a href="/opportunity" class="ml-auto shrink-0 text-primary hover:underline">看本期 5 条 →</a>
      </div>
    )}

    <!-- 首屏：标题 + 事实 + 评分卡，我在做并入页脚 -->
    <header class="mt-4 overflow-hidden rounded-2xl border border-border bg-surface">
      <div class="grid gap-7 p-6 sm:p-7 lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-10">
        <div class="min-w-0">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px]">
            <span class="font-mono font-semibold text-primary">NO.{String(opp.rank).padStart(2, "0")}</span>
            <span class:list={["rounded border px-1.5 py-px text-[10px] font-bold leading-tight", gradeTone[opp.grade]]}>
              {opp.grade} 级
            </span>
            <span class="h-3 w-px bg-border" />
            <span class="text-ink-secondary">
              {opp.entryLabel} · 窗口 {opp.window}
            </span>
            <span class="h-3 w-px bg-border" />
            <span class="font-mono text-ink-muted">{opp.batchLabel} · 快照 {opp.updatedShort}</span>
          </p>

          <h1 class="mt-3 text-2xl font-bold leading-snug tracking-tight text-ink sm:text-[1.9rem]">
            {opp.title}
          </h1>
          <p class="mt-3 text-[15px] leading-7 text-ink-secondary">{opp.oneLiner}</p>

          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-border pt-4 sm:grid-cols-3">
            <div>
              <dt class="text-[11px] text-ink-muted">一个人</dt>
              <dd class="mt-0.5 text-sm font-medium text-ink">{opp.solo.weeks} 周可交付</dd>
            </div>
            <div>
              <dt class="text-[11px] text-ink-muted">启动与持有</dt>
              <dd class="mt-0.5 text-sm font-medium text-ink">{opp.solo.budget}</dd>
            </div>
            <div>
              <dt class="text-[11px] text-ink-muted">定价</dt>
              <dd class="mt-0.5 text-sm font-medium text-ink">{opp.money.price}</dd>
            </div>
          </dl>

          <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-ink-muted">
            <span>适合</span>
            {opp.audience.map((a) => (
              <span class="text-ink-secondary">{a}</span>
            ))}
          </p>
        </div>

        <!-- 评分卡：整体 + 五维，后续不再重复 -->
        <div class="rounded-xl border border-border bg-canvas/40 p-5">
          <div>
            <div class="text-[11px] text-ink-muted">综合分</div>
            <div class="mt-1 flex items-baseline gap-2.5">
              <span class:list={["font-mono text-4xl font-bold leading-none tabular-nums", scoreTone(opp.overall)]}>
                {opp.overall.toFixed(1)}
              </span>
              <span class:list={["rounded border px-1.5 py-0.5 text-xs font-bold leading-none", gradeTone[opp.grade]]}>
                {opp.grade} 级
              </span>
            </div>
          </div>
          <div class="mt-4 space-y-2">
            {OPPORTUNITY_WEIGHTS.map((w) => (
              <div>
                <div class="flex items-baseline justify-between">
                  <span class="text-[11px] text-ink-muted">{w.label}</span>
                  <span class="text-[11px] font-medium tabular-nums text-ink-secondary">
                    {opp.scores[w.key]}
                  </span>
                </div>
                <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-surface-2">
                  <div class="h-full rounded-full bg-primary/70" style={`width: ${opp.scores[w.key]}%`} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {firstAction && (
        <div class="flex flex-col gap-2 border-t border-border bg-primary/[0.04] px-6 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
          <p class="text-xs leading-6 text-ink-secondary">
            <span class="font-medium text-ink">第一步：</span>
            {firstAction}
          </p>
          <a href="#path" class="shrink-0 text-[11px] font-medium text-primary hover:underline">
            查看完整路径 →
          </a>
        </div>
      )}

      <!-- 我在做：参与名单 + 留言入口，并入页脚，不单独占一节 -->
      <div
        data-doing
        data-doing-slug={opp.slug}
        class="border-t border-border bg-surface-2/40 px-6 py-3.5 sm:px-7"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="flex min-w-0 flex-wrap items-center gap-2">
            <h2 class="text-xs font-semibold text-ink">谁在做</h2>
            <span
              data-doing-count
              class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] text-ink-muted"
            >
              读取中…
            </span>
            <div data-doing-avatars class="hidden flex flex-wrap items-center gap-1"></div>
            <p data-doing-empty class="hidden text-[11px] text-ink-muted">
              还没有人动手。第一个标记的人会出现在这里。
            </p>
          </div>
          <button
            type="button"
            data-doing-join
            class="ml-auto shrink-0 rounded-lg border border-primary/40 bg-primary/10 px-3 py-1.5 text-[11px] font-medium text-primary transition hover:border-primary/70 hover:bg-primary/15"
          >
            <span data-doing-join-label>我在做</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 章节导航：长页面的方向感 -->
    <nav class="sticky top-16 z-20 -mx-4 mt-6 border-y border-border bg-canvas/90 px-4 backdrop-blur sm:-mx-6 sm:px-6">
      <ol class="flex gap-1 overflow-x-auto py-2">
        {toc.map((t) => (
          <li class="shrink-0">
            <a
              href={`#${t.id}`}
              class="flex items-baseline gap-1.5 rounded-md px-2 py-1 text-xs text-ink-secondary transition hover:bg-surface-2 hover:text-primary"
            >
              <span class="font-mono text-[10px] tabular-nums text-ink-muted">{t.no}</span>
              <span class="whitespace-nowrap">{t.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

  <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-12">
      <div class="min-w-0 space-y-12">
        <!-- 01 机会在哪里 -->
        <section id="where" class="scroll-mt-28">
          <SectionHeader
            no="01"
            title="机会在哪里"
            desc="缺口的位置、为什么是现在，以及最容易走错的那一步。"
          />
          <div class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface">
            <div class="grid gap-1.5 border-b border-border px-5 py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
              <h3 class="text-xs font-semibold text-ink">缺口</h3>
              <p class="text-sm leading-7 text-ink-secondary">{opp.thesis.where}</p>
            </div>
            <div class="grid gap-1.5 border-b border-border px-5 py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
              <h3 class="text-xs font-semibold text-ink">为什么是现在</h3>
              <p class="text-sm leading-7 text-ink-secondary">{opp.thesis.whyNow}</p>
            </div>
            <div class="grid gap-1.5 bg-amber-500/[0.05] px-5 py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
              <h3 class="text-xs font-semibold text-amber-500">不要做什么</h3>
              <p class="text-sm leading-7 text-ink-secondary">{opp.thesis.dont}</p>
            </div>
          </div>
        </section>

        <!-- 02 一个人怎么干 -->
        <section id="solo" class="scroll-mt-28">
          <SectionHeader
            no="02"
            title="一个人怎么干"
            desc="成本、时间、获客、收钱——四件事都落到一个人身上，才叫能开工。"
          />
          <div class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface">
            <dl class="grid gap-px bg-border sm:grid-cols-3">
              <div class="bg-surface px-5 py-4">
                <dt class="text-[11px] text-ink-muted">启动与持有</dt>
                <dd class="mt-1 text-sm leading-6 text-ink">{opp.solo.budget}</dd>
              </div>
              <div class="bg-surface px-5 py-4">
                <dt class="text-[11px] text-ink-muted">做出能收费的版本</dt>
                <dd class="mt-1 font-mono text-xl font-bold leading-none text-primary">
                  {opp.solo.weeks} 周
                </dd>
              </div>
              <div class="bg-surface px-5 py-4">
                <dt class="text-[11px] text-ink-muted">自己能触发的渠道</dt>
                <dd class="mt-1.5 flex flex-wrap gap-1">
                  {opp.solo.channels.map((c) => (
                    <span class="rounded border border-border bg-surface-2 px-1.5 py-0.5 text-[11px] text-ink-secondary">
                      {c}
                    </span>
                  ))}
                </dd>
              </div>
            </dl>

            <div class="border-t border-border bg-emerald-500/[0.04] px-5 py-4">
              <h3 class="flex items-center gap-1.5 text-xs font-semibold text-ink">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                收入结构
              </h3>
              <dl class="mt-2.5 grid gap-3 text-xs sm:grid-cols-3">
                <div>
                  <dt class="text-[10px] uppercase tracking-wide text-ink-muted">定价</dt>
                  <dd class="mt-0.5 text-sm font-medium text-ink">{opp.money.price}</dd>
                </div>
                <div>
                  <dt class="text-[10px] uppercase tracking-wide text-ink-muted">谁自己刷卡</dt>
                  <dd class="mt-0.5 leading-6 text-ink-secondary">{opp.money.payer}</dd>
                </div>
                <div>
                  <dt class="text-[10px] uppercase tracking-wide text-ink-muted">前 10 个付费用户</dt>
                  <dd class="mt-0.5 leading-6 text-ink-secondary">{opp.money.first10}</dd>
                </div>
              </dl>
            </div>

            <div class="border-t border-border px-5 py-4">
              <h3 class="flex flex-wrap items-center gap-2 text-xs font-semibold text-ink">
                第一周就做这三件事
                <span class="rounded border border-border bg-surface-2 px-1.5 py-px text-[10px] font-normal text-ink-muted">
                  不需要完整产品
                </span>
              </h3>
              <ol class="mt-2.5 space-y-2">
                {opp.solo.firstWeek.map((s, i) => (
                  <li class="flex gap-2.5 text-sm leading-6 text-ink-secondary">
                    <span class="mt-0.5 font-mono text-[11px] font-semibold tabular-nums text-primary/70">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>

        <!-- 03 四榜证据 -->
        <section id="evidence" class="scroll-mt-28">
          <SectionHeader
            no="03"
            title="四榜证据"
            desc="每条证据都指向榜单中的具体条目，数值由构建期从榜单注入，可点回原条目核对。"
          />
          <div class="mt-5 space-y-6">
            {grouped.map((g) => (
              <div>
                <div class="flex items-baseline gap-2">
                  <h3 class="text-xs font-semibold text-ink">{g.label}</h3>
                  <span class="font-mono text-[11px] text-ink-muted">{g.items.length} 条</span>
                  <span class="ml-auto hidden truncate text-[11px] text-ink-muted sm:block">
                    {g.items[0].boardHint}
                  </span>
                </div>

                <ul class="mt-2 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
                  {g.items.map((e) => (
                    <li class="px-5 py-4">
                      <a href={e.href} class="group flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <span class="min-w-0">
                          <span class="block truncate text-sm font-medium text-ink transition group-hover:text-primary">
                            {e.title}
                          </span>
                          <span class="mt-0.5 block truncate text-[11px] text-ink-muted">{e.subtitle}</span>
                        </span>
                        <span class="shrink-0 text-[11px] text-ink-muted transition group-hover:text-primary">
                          核对 →
                        </span>
                      </a>

                      <div class="mt-3 flex flex-wrap gap-x-7 gap-y-2">
                        {e.metrics.map((m) => (
                          <div>
                            <div class="text-[10px] text-ink-muted">{m.label}</div>
                            <div class:list={["mt-0.5 text-xs font-medium tabular-nums", m.tone ?? "text-ink"]}>
                              {m.value}
                            </div>
                          </div>
                        ))}
                      </div>

                      <p class="mt-2.5 border-l-2 border-primary/25 pl-3 text-[11px] leading-6 text-ink-secondary">
                        {e.note}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- 04 怎么做 -->
        <section id="build" class="scroll-mt-28">
          <SectionHeader
            no="04"
            title="怎么做"
            desc="产品形态、最小可用范围，以及可以直接复用的开源件与模型。"
          />
          <div class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface">
            <div class="px-5 py-4">
              <h3 class="text-xs font-semibold text-ink">产品形态</h3>
              <p class="mt-1.5 text-sm leading-7 text-ink-secondary">{opp.build.form}</p>
            </div>
            <div class="border-t border-border px-5 py-4">
              <h3 class="text-xs font-semibold text-ink">最小可用范围（MVP）</h3>
              <ul class="mt-2.5 space-y-2">
                {opp.build.mvpScope.map((s, i) => (
                  <li class="flex gap-2.5 text-sm leading-6 text-ink-secondary">
                    <span class="mt-0.5 font-mono text-[11px] tabular-nums text-ink-muted">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="border-t border-border px-5 py-4">
              <h3 class="text-xs font-semibold text-ink">技术栈</h3>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {opp.build.stack.map((s) => (
                  <span class="rounded border border-border bg-surface-2 px-2 py-0.5 text-[11px] text-ink-secondary">
                    {s}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-4">
            <h3 class="text-xs font-semibold text-ink">可以直接利用的东西</h3>
            <ul class="mt-2 grid gap-2 sm:grid-cols-2">
              {opp.build.leverage.map((l, i) => (
                <li class="rounded-xl border border-border bg-surface px-4 py-3">
                  <div class="flex items-center gap-2">
                    <span class="rounded border border-primary/25 bg-primary/10 px-1.5 py-px text-[10px] font-medium text-primary">
                      {leverageLabels[i]}
                    </span>
                    <span class="truncate text-xs font-medium text-ink">{l.ref}</span>
                  </div>
                  <p class="mt-1.5 text-[11px] leading-6 text-ink-secondary">{l.how}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- 05 实施路径 -->
        <section id="path" class="scroll-mt-28">
          <SectionHeader
            no="05"
            title="实施路径"
            desc="每个阶段都有通过标准：达不到就停，不继续投入。"
          />
          <ol class="mt-5 space-y-6 border-l border-border pl-5">
            {opp.path.map((p) => (
              <li class="relative">
                <span class="absolute -left-[26px] top-1 h-3 w-3 rounded-full border-2 border-primary bg-canvas" />
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  <span class="font-mono text-[11px] font-semibold text-primary">P{p.phase}</span>
                  <h3 class="text-sm font-semibold text-ink">{p.name}</h3>
                  <span class="text-[11px] text-ink-muted">{p.weeks}</span>
                </div>

                <ul class="mt-2 space-y-1.5">
                  {p.actions.map((a) => (
                    <li class="flex gap-2 text-xs leading-6 text-ink-secondary">
                      <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-ink-muted/60" />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] leading-6">
                  <span class="shrink-0 rounded bg-surface-2 px-1.5 py-0.5 text-ink-muted">交付物</span>
                  <span class="text-ink-secondary">{p.deliverable}</span>
                  <span class="ml-2 shrink-0 rounded bg-emerald-500/10 px-1.5 py-0.5 font-medium text-emerald-500">通过标准</span>
                  <span class="text-ink-secondary">{p.gate}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- 06 效果 -->
        <section id="outcome" class="scroll-mt-28">
          <SectionHeader
            no="06"
            title="可以达到什么效果"
            desc="目标数字、天花板，以及这些数字在什么条件下不成立。"
          />
          <div class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface">
            <dl class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
              {opp.outcome.targets.map((t) => (
                <div class="bg-surface px-4 py-3.5">
                  <dt class="text-[11px] text-ink-muted">{t.metric}</dt>
                  <dd class="mt-1 font-mono text-lg font-semibold leading-none tabular-nums text-ink">
                    {t.value}
                  </dd>
                </div>
              ))}
            </dl>
            <div class="grid border-t border-border sm:grid-cols-2 sm:divide-x sm:divide-border">
              <div class="px-5 py-4">
                <h3 class="flex items-center gap-1.5 text-xs font-semibold text-ink">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                  天花板
                </h3>
                <p class="mt-1.5 text-xs leading-6 text-ink-secondary">{opp.outcome.ceiling}</p>
              </div>
              <div class="border-t border-border px-5 py-4 sm:border-t-0">
                <h3 class="flex items-center gap-1.5 text-xs font-semibold text-ink">
                  <span class="h-1.5 w-1.5 rounded-full bg-rose-400" />
                  现实边界
                </h3>
                <p class="mt-1.5 text-xs leading-6 text-ink-secondary">{opp.outcome.reality}</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 07 风险 -->
        <section id="risks" class="scroll-mt-28">
          <SectionHeader
            no="07"
            title="风险与失效条件"
            desc="每条风险都配一个应对方式；没有应对的风险说明判断还不成熟。"
          />
          <div class="mt-5 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
            {opp.risks.map((r, i) => (
              <div class="grid gap-1 px-5 py-4 sm:grid-cols-[2rem_minmax(0,1fr)] sm:gap-4">
                <span class="font-mono text-[11px] font-semibold text-amber-500">R{i + 1}</span>
                <div class="min-w-0">
                  <p class="text-sm font-medium leading-6 text-ink">{r.risk}</p>
                  <p class="mt-1 text-xs leading-6 text-ink-secondary">
                    <span class="font-medium text-emerald-500">应对 </span>
                    {r.mitigation}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 上下条：读完之后自然流转 -->
        <nav class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5 text-xs" aria-label="同批次内的上一条与下一条">
          {prev ? (
            <a href={`/opportunity/${prev.slug}`} class="group max-w-[46%] text-ink-secondary transition hover:text-primary">
              <span class="text-[11px] text-ink-muted">← 上一条</span>
              <span class="ml-1.5 font-medium transition group-hover:text-primary">
                {prev.title}
              </span>
            </a>
          ) : (
            <a href="/opportunity" class="text-ink-secondary transition hover:text-primary">
              <span class="text-[11px] text-ink-muted">←</span>
              <span class="ml-1.5">返回机会榜</span>
            </a>
          )}
          {next && (
            <a href={`/opportunity/${next.slug}`} class="group ml-auto max-w-[46%] text-right text-ink-secondary transition hover:text-primary">
              <span class="font-medium transition group-hover:text-primary">{next.title}</span>
              <span class="ml-1.5 text-[11px] text-ink-muted">下一条 →</span>
            </a>
          )}
        </nav>
      </div>



      <!-- 右侧栏：只留三块，分数与依据合并，原则压缩成三行 -->
      <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex items-baseline justify-between">
            <h2 class="text-xs font-semibold text-ink">分项依据</h2>
            <span class="font-mono text-[11px] tabular-nums text-ink-muted">综合 {opp.overall.toFixed(1)}</span>
          </div>
          <ul class="mt-3 space-y-3">
            {OPPORTUNITY_WEIGHTS.map((w) => (
              <li>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-xs font-medium text-ink">{w.label}</span>
                  <span class="font-mono text-xs tabular-nums text-ink-secondary">
                    {opp.scores[w.key]}
                    <span class="ml-1 text-[10px] text-ink-muted">×{Math.round(w.weight * 100)}%</span>
                  </span>
                </div>
                <p class="mt-1 text-[11px] leading-6 text-ink-muted">{opp.scoreBasis[w.key]}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="text-xs font-semibold text-ink">证据来源</h2>
          <ul class="mt-3 space-y-2">
            {opp.banners.map((b) => (
              <li class="flex items-center justify-between gap-2">
                <a href={`/${b.board}`} class="text-xs text-ink-secondary transition hover:text-primary">
                  {b.label}
                </a>
                <span class="font-mono text-[11px] tabular-nums text-ink-muted">{b.count} 条</span>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 border-t border-border pt-3 text-[11px]">
            <a href="/trends" class="text-ink-muted transition hover:text-primary">趋势词</a>
            <a href="/tools" class="text-ink-muted transition hover:text-primary">AI 工具</a>
            <a href="/github" class="text-ink-muted transition hover:text-primary">开源仓库</a>
            <a href="/models" class="text-ink-muted transition hover:text-primary">AI 模型</a>
          </div>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="text-xs font-semibold text-ink">入榜条件</h2>
          <ul class="mt-2.5 space-y-1.5 text-[11px] leading-6 text-ink-muted">
            {["一个人 6 周内能做出收费版", "至少跨 3 个榜单且含趋势词", "必须写明效果不成立的条件"].map((c) => (
              <li class="flex gap-2">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-ink-muted/50" />
                <span>{c}</span>
              </li>
            ))}
          </ul>
          <a href="/opportunity#policy" class="mt-2 inline-block text-[11px] font-medium text-primary hover:underline">
            完整原则 →
          </a>
        </div>
      </aside>


    </div>
  </div>

  <!-- 我在做：提交进展 -->
  <dialog
    data-doing-dialog
    class="fixed inset-0 m-auto max-h-[85vh] w-[min(36rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-border bg-surface p-0 text-ink backdrop:bg-black/50"
  >
    <form data-doing-form class="p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 data-doing-title class="text-base font-semibold text-ink">标记我在做</h2>
          <p class="mt-1 text-[11px] leading-relaxed text-ink-muted">
            留言会公开显示你的头像和名字。随时可以再回来更新，之前的记录都保留。
          </p>
        </div>
        <button type="button" data-doing-close class="text-ink-muted transition hover:text-ink" aria-label="关闭">✕</button>
      </div>

      <div class="mt-4" data-doing-status>
        <div class="text-[11px] text-ink-muted">进展到哪一步</div>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" data-status="doing" class="rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-[11px] font-medium text-primary">在做</button>
          <button type="button" data-status="shipped" class="rounded-full border border-border bg-surface px-2.5 py-1 text-[11px] text-ink-secondary transition hover:border-primary/40 hover:text-ink">已上线</button>
          <button type="button" data-status="paused" class="rounded-full border border-border bg-surface px-2.5 py-1 text-[11px] text-ink-secondary transition hover:border-primary/40 hover:text-ink">暂停了</button>
          <button type="button" data-status="dropped" class="rounded-full border border-border bg-surface px-2.5 py-1 text-[11px] text-ink-secondary transition hover:border-primary/40 hover:text-ink">放弃了</button>
        </div>
      </div>

      <label class="mt-4 block">
        <span class="text-[11px] text-ink-muted">说两句（可留空）</span>
        <textarea
          data-doing-text
          rows="4"
          maxlength="280"
          placeholder="比如：第 3 周，已经做出能收费的版本，第一笔来自一个做播客的朋友；坑是转写准确率在方言上掉得厉害。"
          class="mt-1.5 w-full resize-none rounded-xl border border-border bg-canvas/60 px-3 py-2 text-sm leading-relaxed text-ink outline-none transition placeholder:text-ink-muted/60 focus:border-primary/50"
        ></textarea>
      </label>
      <div class="mt-1 flex items-center justify-between text-[10px] text-ink-muted">
        <span data-doing-error class="hidden text-rose-500"></span>
        <span data-doing-counter class="ml-auto">0 / 280</span>
      </div>

      <div data-doing-history class="mt-3 hidden max-h-48 space-y-2 overflow-y-auto"></div>

      <div class="mt-4 flex items-center justify-between gap-3">
        <button type="button" data-doing-leave class="hidden text-[11px] text-ink-muted transition hover:text-rose-500">
          取消参与
        </button>
        <div class="ml-auto flex items-center gap-2">
          <button type="button" data-doing-close class="rounded-lg border border-border px-3 py-1.5 text-xs text-ink-secondary transition hover:border-primary/40 hover:text-ink">
            关闭
          </button>
          <button
            type="submit"
            data-doing-submit
            class="rounded-lg border border-primary/30 bg-primary px-3.5 py-1.5 text-xs font-medium text-canvas transition hover:bg-primary/90 disabled:opacity-60"
          >
            发布
          </button>
        </div>
      </div>
    </form>
  </dialog>

  <!-- 我在做：某人的留言 -->
  <dialog
    data-doing-viewer
    class="fixed inset-0 m-auto max-h-[85vh] w-[min(34rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-border bg-surface p-0 text-ink backdrop:bg-black/50"
  >
    <div class="p-5">
      <div class="flex items-start justify-between gap-4">
        <div data-viewer-head class="flex items-center gap-3"></div>
        <button type="button" data-viewer-close class="text-ink-muted transition hover:text-ink" aria-label="关闭">✕</button>
      </div>
      <div data-viewer-body class="mt-4 max-h-[60vh] overflow-y-auto"></div>
    </div>
  </dialog>

  <script>
    import { initDoing } from "../../scripts/doing";
    initDoing();

    document.querySelectorAll<HTMLButtonElement>("[data-doing-close]").forEach((btn) => {
      btn.addEventListener("click", () => btn.closest("dialog")?.close());
    });
    document.querySelector<HTMLButtonElement>("[data-viewer-close]")?.addEventListener("click", () => {
      document.querySelector<HTMLDialogElement>("[data-doing-viewer]")?.close();
    });
  </script>
</Base>