---
/**
 * 定价页：单档 Pro（月付 / 年付，自动续费，随时可取消）。
 * 结算走 Paddle（Merchant of Record），CTA 指向账户页，由账户页发起下单。
 * 定价口径：美元为主价，人民币为支付宝通道价（支付宝要求 CNY 定价商品）。
 */
import Base from "../layouts/Base.astro";

const plans = [
  {
    key: "month",
    name: "Pro 月付",
    price: "$20",
    unit: "/ 月",
    oncePrice: "$23",
    onceUnit: "30 天",
    alt: "中国用户 ¥149 / 月（一次性 ¥169）",
    original: "",
    note: "自动续费，随时可取消",
    featured: false,
    badge: "",
    community: { text: "30 天访问期，不含年付优惠", included: false },
  },
  {
    key: "year",
    name: "Pro 年付",
    price: "$160",
    unit: "/ 年",
    oncePrice: "$180",
    onceUnit: "365 天",
    alt: "中国用户 ¥1,099 / 年（一次性 ¥1,299）",
    original: "$240",
    note: "早期用户价，折合 $13.3 / 月",
    featured: true,
    badge: "省 33%",
    community: { text: "365 天访问期，含订阅期内全部更新", included: true },
  },
];

const benefits = [
  "解锁机会榜",
  "解锁 AI 工具榜",
  "解锁 GitHub 榜",
  "解锁 AI 模型榜",
  "解锁 AI 趋势词榜",
  "全部筛选条件与交叉排序维度",
  "机会榜完整证据链与评分拆解",
  "工具与仓库详情扩展字段：技术栈、定价、留存、相似产品",
];

const explainers = [
  {
    title: "数据范围",
    body: "各榜全量条目，含未进入首页分区的长尾工具、仓库与趋势词；机会榜给出完整证据链，而不是一句结论。",
  },
  {
    title: "分析能力",
    body: "多维筛选与交叉排序、趋势词评分拆解、机会评分权重明细，一眼看清每个结论是怎么来的。",
  },
  {
    title: "来源与时点",
    body: "每条记录保留来源网址与采集日期，订阅期内可随时回查。数据新旧由页面标注的采集时间决定，不做模糊承诺。",
  },
];

// 交付说明：回答「付了钱具体拿到什么、多久更新一次」，不承诺做不到的频率。
const deliverables = [
  {
    title: "六份数据集",
    body: "每日情报、AI 工具榜、GitHub 榜、AI 模型榜、AI 趋势词榜、机会榜。每份都是全量条目，包含未进入首页分区的长尾部分。",
  },
  {
    title: "每条记录的字段",
    body: "名称、来源网址、所属品类、评分（热度 / 趋势 / 机会）、首次收录时间与最近采集时间。机会榜另附评分权重明细与证据链。",
  },
  {
    title: "来源可追溯",
    body: "数据来自官方公开接口与人工整理，每条记录都保留来源网址和采集日期，可以回到原始页面自行核对。",
  },
  {
    title: "更新节奏",
    body: "各榜数据源不同，更新频率也不同：工具榜、GitHub 榜随抓取批次更新，模型榜与机会榜在评分重算后更新，趋势词榜按周采集。我们不承诺固定频率，但每份榜单顶部都标注最近一次采集时间。",
  },
  {
    title: "交付形式",
    body: "网页形式，登录后即时可读，不需要安装客户端，也没有额外的下载或激活步骤。订阅有效期内不限次数访问。",
  },
  {
    title: "计费与退款",
    body: "月付或年付，自动续费可随时在账户页自行取消，取消后已付有效期不缩短。付款、发票与退款由 Paddle 作为 Merchant of Record 处理。",
  },
];

const faqs = [
  {
    q: "现在可以直接付款吗？",
    a: "可以。登录后在账户页选方案与付款方式，会跳转到 Paddle 的结算页完成付款，付款成功后 Pro 权益自动开通，不需要人工确认。",
  },
  {
    q: "自动续费和一次性买断有什么区别？",
    a: "自动续费单价更低（月付 $20、年付 $160），按周期自动扣款，随时可在账户页取消，取消后当期权益保留到期日；一次性多付一点（$23 / $180），买 30 天或 365 天，不产生订阅、不会自动扣款，到期后回到免费版。两种方式权益完全一样。",
  },
  {
    q: "免费版和 Pro 看到的数据一样吗？",
    a: "不一样。免费版只看得到各榜的一部分条目，Pro 解锁机会榜与四份榜单的全量数据，另有全部筛选与排序维度、机会榜的完整证据链与评分拆解。这些能力会随版本陆续补齐。",
  },
  {
    q: "会自动续费吗？怎么取消？",
    a: "取决于你选哪种：选自动续费则按周期扣款，直到你在账户页一键取消（取消后当期权益保留到期日，之后不再扣款，也可以随时恢复）；选一次性则完全不产生订阅，到期自动回到免费版，不会有任何扣款。",
  },
  {
    q: "支持哪些支付方式？国内可以用支付宝吗？",
    a: "信用卡/借记卡、PayPal、Apple Pay、Google Pay 全球可用；中国用户在结算页可选择支付宝（人民币价格），欧洲有 iDEAL、Bancontact、BLIK，巴西有 Pix，印度有 UPI，韩国有 KakaoPay 等本地方式。具体以结算页展示为准。",
  },
  {
    q: "权益还没有全部上线，现在买会不会亏？",
    a: "不会。当前是早期用户价（月付 $20 / 年付 $160，年付原价 $240），后续涨价不影响已订阅用户，续费也按你下单时的价格。权益上线前如有调整，按实际交付情况顺延使用期。",
  },
  {
    q: "可以开发票吗？团队采购怎么算？",
    a: "付款成功后 Paddle 会发送带 invoice 的收据邮件，可直接下载用于报销。三人以上的团队采购、学生与非营利折扣，请邮件说明使用场景，我们按实际情况报价。",
  },
];

const title = "定价 · Horizons";
const description =
  "Horizons Pro：解锁机会榜、AI 工具榜、GitHub 榜、AI 模型榜与 AI 趋势词榜，含全部筛选维度与机会证据链。自动续费月付 $20 / 年付 $160，或一次性 $23 / $180 买断，不自动扣款。";
---

<Base title={title} description={description}>
  <section class="relative overflow-hidden border-b border-border/60">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_50%_-8%,rgba(8,102,250,0.10),transparent)]"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-16">
      <!-- 页头 -->
      <header class="text-center">
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">定价</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
          地平线上，我们把散落在各处的数据整理清楚，用数据分析出哪些方向有机会。它能帮你省掉一些摸索的时间，但成不成，还是看有没有真的动手。
        </p>
        <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
          最重要的是<strong class="font-medium text-ink">不断尝试</strong>——在尝试中获得新的想法。<strong
            class="font-medium text-ink">只要开始做，就离成功越来越近。</strong
          >
        </p>
      </header>

      <!-- 当前阶段提示 -->
      <div
        class="mx-auto mt-9 flex max-w-3xl items-start gap-3 rounded-xl border border-border bg-surface-2 px-4 py-3"
      >
        <svg
          class="mt-0.5 h-4 w-4 shrink-0 text-primary"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v4.5a.75.75 0 001.5 0v-4.5zM10 14a1 1 0 100-2 1 1 0 000 2z"
            clip-rule="evenodd"></path>
        </svg>
        <p class="text-xs leading-relaxed text-ink-secondary">
          两种买法任选：<strong class="font-medium text-ink">自动续费</strong>按月/年扣款，随时可取消，单价最低；
          <strong class="font-medium text-ink">一次性</strong>多付一点，买多久用多久，不会自动扣款。
          结算由 Paddle 完成（Merchant of Record），支持信用卡、PayPal、Apple Pay、Google Pay，中国用户可用支付宝。
        </p>
      </div>

      <!-- 价格卡 -->
      <div class="mx-auto mt-8 grid max-w-3xl gap-5 md:grid-cols-2">
        {
          plans.map((p) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl bg-surface p-6",
                p.featured
                  ? "border-2 border-primary shadow-[0_0_0_1px_rgba(8,102,250,0.08)]"
                  : "border border-border",
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-base font-semibold text-ink">{p.name}</h2>
                {p.badge ? (
                  <span class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent">
                    {p.badge}
                  </span>
                ) : (
                  <span class="text-xs text-ink-muted">灵活</span>
                )}
              </div>

              <div class="mt-4 flex items-baseline gap-2">
                <span class="text-5xl font-bold tracking-tight text-ink tabular-nums">{p.price}</span>
                <span class="text-sm text-ink-muted">{p.unit}</span>
                {p.original ? (
                  <span class="text-sm text-ink-muted line-through">{p.original}</span>
                ) : null}
              </div>
              <p class="mt-1 text-xs text-ink-muted">{p.alt}</p>
              <p class="mt-2 text-xs text-ink-muted">{p.note}</p>

              <div class="mt-5 space-y-2">
                <button
                  type="button"
                  data-checkout-plan={p.key}
                  data-autorenew="1"
                  class:list={[
                    "block w-full rounded-lg px-4 py-2.5 text-center text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-60",
                    p.featured
                      ? "bg-primary text-white hover:bg-primary-hover"
                      : "border-2 border-primary text-ink hover:bg-primary-soft",
                  ]}
                >
                  自动续费 · {p.price}{p.unit}
                </button>
                <button
                  type="button"
                  data-checkout-plan={p.key}
                  data-autorenew="0"
                  class="block w-full rounded-lg border border-border px-4 py-2.5 text-center text-sm font-medium text-ink-secondary transition hover:border-primary/40 hover:text-ink disabled:cursor-not-allowed disabled:opacity-60"
                >
                  一次性 · {p.oncePrice} / {p.onceUnit}
                </button>
              </div>

              <p class="mt-2 text-center text-[11px] text-ink-muted">
                一次性不自动扣款，到期不续费
              </p>

              <ul class="mt-6 space-y-2.5 border-t border-border pt-5">
                {benefits.map((b) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-ink-secondary">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{b}</span>
                  </li>
                ))}
                <li
                  class:list={[
                    "flex gap-2.5 text-sm leading-relaxed",
                    p.community.included ? "text-ink-secondary" : "text-ink-muted",
                  ]}
                >
                  {p.community.included ? (
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  ) : (
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 1a4 4 0 00-4 4v2H5a2 2 0 00-2 2v7a2 2 0 002 2h10a2 2 0 002-2V9a2 2 0 00-2-2h-1V5a4 4 0 00-4-4zm2 6V5a2 2 0 10-4 0v2h4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}
                  <span>{p.community.text}</span>
                </li>
              </ul>
            </div>
          ))
        }
      </div>

      <p class="mt-4 text-center text-xs text-ink-muted">
        价格以美元标注，中国用户按人民币结算。税费由 Paddle 按账单地址计算，最终金额以结算页为准。
      </p>

      <p
        id="pricing-notice"
        class="mx-auto mt-4 hidden max-w-3xl rounded-lg border border-warning/30 bg-warning-soft px-4 py-3 text-center text-sm leading-relaxed text-ink-secondary"
      >
      </p>

      <!-- 交付说明 -->
      <section class="mx-auto mt-16 max-w-3xl">
        <h2 class="text-center text-xl font-semibold tracking-tight text-ink">你订阅后实际拿到什么</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-sm leading-relaxed text-ink-secondary">
          付费解锁的是数据库的读取权限，不是一次性的报告。下面是具体交付内容。
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            deliverables.map((d) => (
              <div class="rounded-xl border border-border bg-surface p-5">
                <h3 class="text-sm font-semibold text-ink">{d.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-ink-secondary">{d.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 权益说明 -->
      <section class="mx-auto mt-16 max-w-3xl">
        <h2 class="text-center text-xl font-semibold tracking-tight text-ink">Pro 包含什么</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            explainers.map((e) => (
              <div class="rounded-xl border border-border bg-surface p-5">
                <h3 class="text-sm font-semibold text-ink">{e.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-ink-secondary">{e.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- FAQ -->
      <section class="mx-auto mt-16 max-w-3xl">
        <h2 class="text-center text-xl font-semibold tracking-tight text-ink">关于付费的常见问题</h2>
        <div class="mt-6 space-y-3">
          {
            faqs.map((item) => (
              <details class="group rounded-xl border border-border bg-surface">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-ink">
                  {item.q}
                  <svg
                    class="h-4 w-4 shrink-0 text-ink-muted transition group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <p class="px-5 pb-4 text-sm leading-relaxed text-ink-secondary">{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- 底部 CTA -->
      <section
        class="mx-auto mt-16 max-w-3xl rounded-2xl border border-border bg-surface-2 px-6 py-10 text-center"
      >
        <h2 class="text-lg font-semibold tracking-tight text-ink">先看数据，再决定要不要付费</h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-ink-secondary">
          榜单现在完全免费。等你确认这些信号对自己的决策有用，再考虑订阅也不迟。
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/tools"
            class="rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-white transition hover:bg-primary-hover"
          >
            浏览 AI 工具榜
          </a>
          <a
            href="/opportunity"
            class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-ink-secondary transition hover:border-primary/40 hover:text-ink"
          >
            看机会榜
          </a>
        </div>
      </section>
    </div>
  </section>
</Base>

<script>
  import { initPricingCheckout } from "../scripts/pricing-checkout";
  initPricingCheckout();
</script>