---
/**
 * AI 趋势词详情（构建期预渲染）。
 *
 * 页面主体在 components/detail/TrendBody.astro，和后台预览页共用同一份标记，
 * 这里只负责取数据与外壳（title / canonical）。
 */
import Base from "../../layouts/Base.astro";
import TrendBody from "../../components/detail/TrendBody.astro";
import { getRelatedTrends, trendDataMode, trendKeywords } from "../../lib/trends";

export function getStaticPaths() {
  return trendKeywords.map((t) => ({ params: { slug: t.slug }, props: { trend: t } }));
}

const { trend } = Astro.props as { trend: any };
const related = getRelatedTrends(trend, 4);
---

<Base
  title={`${trend.normalizedName} 趋势分析`}
  description={`「${trend.keyword}」的搜索趋势证据、升温原因、搜索意图与可执行的机会方向。`}
  canonicalPath={trend.variantOf ? `/trends/${trend.variantOf}` : undefined}
>
  <TrendBody trend={trend} related={related} dataMode={trendDataMode} />
</Base>