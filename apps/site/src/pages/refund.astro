---
/**
 * 退款与取消政策。
 * 与《服务条款》中的「订阅与退款」章节保持一致；改计费规则时两处同步修改。
 * Paddle 是 Merchant of Record：付款、发票、退款都由 Paddle 处理。
 */
import Base from "../layouts/Base.astro";

const updated = "2026-11-06";
const contact = "woshizhanghao1125@gmail.com";

const sections: Array<{
  id: string;
  title: string;
  paragraphs: string[];
  items?: string[];
  after?: string[];
}> = [
  {
    id: "scope",
    title: "适用范围",
    paragraphs: [
      "本政策适用于在 horizons.tools 上购买 Horizons Pro 的全部订单，包括自动续费订阅与一次性购买。",
      "本站的支付、发票开具与退款由 Paddle.com 作为记录商户（Merchant of Record）代为处理。你的银行账单与发票上显示的是 Paddle，退款也会由 Paddle 原路退回。",
    ],
  },
  {
    id: "subscription",
    title: "订阅的取消与续费",
    paragraphs: [
      "自动续费订阅可以随时在账户页取消，无需说明理由，也不必联系客服。取消后不会再产生新的扣款。",
    ],
    items: [
      "取消后，已支付的当前计费周期继续有效，权益保留至该周期结束日，不会按剩余天数退费。",
      "取消操作不会自动触发退款；如需退款，请参见下文「可以退款的情形」。",
      "如果在取消后仍被扣款，通常是因为取消发生在扣款之后，请邮件联系我们核实并处理。",
    ],
  },
  {
    id: "onetime",
    title: "一次性购买",
    paragraphs: [
      "一次性购买分为 30 天与 365 天两种，支付成功后立即开通，不产生订阅、不会自动扣款，到期后自动回到免费版。",
      "由于属于即时交付的数字内容服务，一次性购买原则上不支持退款，但在下文列明的情形下仍可申请。",
    ],
  },
  {
    id: "refundable",
    title: "可以退款的情形",
    paragraphs: ["出现以下情况时，我们会在核实后办理退款或补足相应权益："],
    items: [
      "同一笔订单被重复扣款，或你被扣款的金额与页面显示不符。",
      "未经你授权的扣款，例如账户凭据被他人使用。",
      "支付成功但权益未开通，且我们在收到反馈后 7 天内无法修复。",
      "因本站服务中断导致你在整个计费周期内无法使用已付费功能，且未能提供等效补偿。",
      "你所在地区的消费者保护法律赋予你额外的退款权利。",
    ],
    after: [
      "除上述情形外，已实际使用的付费周期不予退款。若你对服务不满意，仍欢迎邮件说明情况，我们会尽量给出合理方案。",
    ],
  },
  {
    id: "withdrawal",
    title: "部分地区消费者的撤回权",
    paragraphs: [
      "欧盟、英国等地区的消费者在远程交易中通常享有 14 天撤回权。对于以数字形式即时交付的内容，在交付开始前需取得你的明确同意并确认放弃撤回权。",
      "本站的付费内容在支付成功后立即开通，下单页面会提示你确认即时交付。若你所在地区的法律不允许放弃该权利，或赋予你更强的保护，则以当地法律为准，我们不会以本政策排除你的法定权利。",
    ],
  },
  {
    id: "howto",
    title: "如何申请退款",
    paragraphs: [
      "请在扣款发生后的 30 天内发送邮件至下方邮箱，并尽量附上以下信息，以便我们快速定位订单：",
    ],
    items: [
      "注册时使用的邮箱地址。",
      "订单号或 Paddle 发票号（发票邮件中可见），或扣款日期与金额。",
      "退款原因，以及能说明问题的截图（如有）。",
    ],
    after: ["我们不会要求你提供任何支付卡号、密码或验证码，请勿在邮件中发送此类信息。"],
  },
  {
    id: "timeline",
    title: "处理时限",
    paragraphs: [
      "我们会在收到申请后 3 个工作日内答复。审核通过后，退款由 Paddle 提交至原支付渠道，通常需要 5 至 10 个工作日到账，具体时间取决于发卡行或支付机构。",
    ],
  },
  {
    id: "pricing",
    title: "价格、货币与税费",
    paragraphs: [
      "页面展示的价格可能为未含税金额，结算时会根据你的账单地址与当地税率计算税费，最终金额以结账页为准。",
      "我们可能调整售价，但已生效的订阅按其下单时的价格续费，调整不会追溯适用于已完成的订单。",
    ],
  },
  {
    id: "contact",
    title: "联系我们",
    paragraphs: ["对本政策有疑问，或需要申请退款，请邮件联系管理员。"],
  },
];
---

<Base
  title="退款与取消政策 · Horizons"
  description="地平线（horizons.tools）退款与取消政策：订阅取消、一次性购买、可退款情形、撤回权、申请方式与处理时限。"
>
  <article class="relative">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_50%_-8%,rgba(8,102,250,0.09),transparent)]"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-4 pb-24 pt-14 sm:px-6 sm:pt-16">
      <header class="border-b border-border pb-8">
        <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">退款与取消政策</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
          订阅如何取消、什么情况下可以退款，以及申请流程与处理时限
        </p>
        <p
          class="mt-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-ink-muted"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
          最后更新 {updated}
        </p>
      </header>

      {
        sections.map((s, i) => (
          <section
            id={s.id}
            class="grid gap-3 border-b border-border py-10 last:border-0 md:grid-cols-[190px_1fr] md:gap-10"
          >
            <div>
              <span class="font-mono text-[11px] tracking-widest text-ink-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h2 class="mt-1 text-sm font-semibold text-ink md:text-base">{s.title}</h2>
            </div>

            <div class="space-y-3">
              {s.paragraphs.map((p) => (
                <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">{p}</p>
              ))}

              {s.items && (
                <ul class="space-y-3">
                  {s.items.map((it) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/70" aria-hidden="true" />
                      <span class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">
                        {it}
                      </span>
                    </li>
                  ))}
                </ul>
              )}

              {s.after?.map((p) => (
                <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">{p}</p>
              ))}

              {s.id === "contact" && (
                <a
                  href={`mailto:${contact}`}
                  class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-medium text-ink transition hover:border-primary/40 hover:text-primary"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M3 5a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H3zm0 1.5h14a.5.5 0 01.32.12L10 11.2 2.68 6.62A.5.5 0 013 6.5z" />
                  </svg>
                  {contact}
                </a>
              )}

              {s.id === "scope" && (
                <p class="text-sm leading-relaxed text-ink-secondary sm:text-[15px] sm:leading-7">
                  另请参阅《<a
                    href="/terms"
                    class="text-primary underline-offset-4 hover:underline">服务条款</a
                  >》与《<a
                    href="/privacy"
                    class="text-primary underline-offset-4 hover:underline">隐私政策</a
                  >》。
                </p>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>