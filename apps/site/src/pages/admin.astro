---
/**
 * 后台管理页（/admin）：登录 + 数据大盘 + 用户/付费列表。
 *
 * 这是一个静态壳：HTML 里没有任何业务数据，所有数字都靠 /api/admin/* 带登录态拉取，
 * 未登录只会看到登录框，因此页面本身可以被公开请求，但拿不到任何敏感信息。
 * 不引用 NavBar / Footer / 统计脚本，避免出现在站点导航与 GA4 里。
 */
import "../styles/globals.css";

const meta = {
  title: "管理后台 · Horizons",
  description: "",
  canonical: "",
  robots: "noindex, nofollow",
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="robots" content={meta.robots} />
    <meta name="referrer" content="same-origin" />
    <!-- 图标与 Base.astro 保持一致；public 下没有 favicon.svg，路径写错会退回浏览器默认图标 -->
    <link rel="icon" href="/favicon.ico?v=4" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png?v=4" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d12" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        var stored = localStorage.getItem("theme");
        var dark = stored ? stored === "dark" : false;
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <!-- ------------------------------- 登录 ------------------------------- -->
    <main id="login-view" class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12">
      <div class="mb-7 flex flex-col items-center text-center">
        <img src="/brand/mark.png" alt="Horizons" width="239" height="112" class="h-14 w-auto" />
        <h1 class="mt-4 text-xl font-semibold tracking-tight">管理后台</h1>
        <p class="mt-1.5 text-sm text-ink-secondary">仅限站主本人登录</p>
      </div>

      <form id="login-form" class="rounded-2xl border border-border bg-surface p-6 shadow-sm sm:p-7" novalidate>
        <label class="block text-sm font-medium text-ink-secondary" for="login-username">用户名</label>
        <input
          id="login-username"
          name="username"
          type="text"
          autocomplete="username"
          autocapitalize="off"
          spellcheck="false"
          required
          class="mt-1.5 w-full rounded-xl border border-border bg-surface-2 px-3.5 py-2.5 text-[15px] text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
        />

        <label class="mt-4 block text-sm font-medium text-ink-secondary" for="login-password">密码</label>
        <div class="relative mt-1.5">
          <input
            id="login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="w-full rounded-xl border border-border bg-surface-2 py-2.5 pl-3.5 pr-11 text-[15px] text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
          />
          <button
            id="toggle-password"
            type="button"
            aria-label="显示密码"
            aria-pressed="false"
            class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-xl text-ink-muted transition hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
          >
            <svg id="icon-eye" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <svg id="icon-eye-off" class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
          </button>
        </div>

        <p id="login-error" class="mt-3 hidden rounded-lg bg-danger-soft px-3 py-2 text-xs text-danger" role="alert"></p>

        <button
          id="login-submit"
          type="submit"
          class="mt-5 w-full rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-white transition hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          登录
        </button>

        <p class="mt-4 text-center text-[11px] leading-relaxed text-ink-muted">
          会话 8 小时后自动失效；同一 IP 连续 5 次失败会锁定 15 分钟
        </p>
      </form>
    </main>

    <!-- ------------------------------- 后台 ------------------------------- -->
    <div id="app-view" hidden>
      <header class="sticky top-0 z-20 border-b border-border bg-canvas/90 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6">
          <div class="flex min-w-0 items-center gap-2.5">
            <img src="/brand/mark.png" alt="" width="239" height="112" class="h-7 w-auto shrink-0" />
            <span class="truncate text-sm font-semibold">管理后台</span>
            <span id="who" class="hidden rounded-full bg-surface-2 px-2 py-0.5 text-[11px] text-ink-muted sm:inline"></span>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span id="updated-at" class="hidden text-[11px] text-ink-muted md:inline"></span>
            <button
              id="refresh"
              type="button"
              class="rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-ink-secondary transition hover:border-border-strong hover:text-ink"
            >
              刷新
            </button>
            <button
              id="logout"
              type="button"
              class="rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-ink-secondary transition hover:border-danger hover:text-danger"
            >
              退出
            </button>
          </div>
        </div>

        <nav class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 sm:px-6">
          <button type="button" data-tab="overview" data-active="true" class="admin-tab">概览</button>
          <button type="button" data-tab="users" class="admin-tab">注册用户</button>
          <button type="button" data-tab="payments" class="admin-tab">付费记录</button>
          <button type="button" data-tab="tools" class="admin-tab">工具榜</button>
          <button type="button" data-tab="trends" class="admin-tab">趋势榜</button>
          <button type="button" data-tab="github" class="admin-tab">GitHub 榜</button>
          <button type="button" data-tab="models" class="admin-tab">模型榜</button>
          <button type="button" data-tab="opps" class="admin-tab">机会榜</button>
          <button type="button" data-tab="boards" class="admin-tab">榜单版本</button>
          <button type="button" data-tab="daily" class="admin-tab">每日情报</button>
          <button type="button" data-tab="fields" class="admin-tab">数据字段</button>
        </nav>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
        <p id="load-error" class="mb-4 hidden rounded-lg bg-danger-soft px-3 py-2 text-xs text-danger" role="alert"></p>

        <!-- 概览 -->
        <section id="tab-overview" class="space-y-6">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="text-xs font-medium text-ink-muted">注册用户</div>
              <div id="kpi-users" class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">—</div>
              <div id="kpi-users-sub" class="mt-2 text-xs text-ink-secondary">—</div>
            </article>

            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="text-xs font-medium text-ink-muted">付费用户</div>
              <div id="kpi-pro" class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">—</div>
              <div id="kpi-pro-sub" class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-secondary"></div>
            </article>

            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="text-xs font-medium text-ink-muted">累计收款</div>
              <div id="kpi-total" class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">—</div>
              <div id="kpi-total-sub" class="mt-2 text-xs text-ink-secondary">—</div>
            </article>

            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="text-xs font-medium text-ink-muted">本月收款</div>
              <div id="kpi-month" class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">—</div>
              <div id="kpi-month-sub" class="mt-2 text-xs text-ink-secondary">—</div>
            </article>
          </div>

          <div class="grid gap-4 lg:grid-cols-[1.6fr_1fr]">
            <article class="rounded-2xl border border-border bg-surface p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h2 class="text-sm font-semibold">近 12 个月收入</h2>
                  <p class="mt-1 text-xs text-ink-muted">按支付时间统计，仅计成功订单（不含退款）</p>
                </div>
                <div id="chart-currencies" class="flex gap-1"></div>
              </div>
              <div id="chart" class="mt-6 flex h-48 items-end gap-1.5 sm:gap-2.5"></div>
              <div id="chart-months" class="mt-2 flex gap-1.5 sm:gap-2.5"></div>
            </article>

            <article class="rounded-2xl border border-border bg-surface p-5">
              <h2 class="text-sm font-semibold">订阅与退款</h2>
              <dl id="side-facts" class="mt-4 space-y-3 text-sm"></dl>
            </article>
          </div>
        </section>

        <!-- 注册用户 -->
        <section id="tab-users" hidden>
          <div class="rounded-2xl border border-border bg-surface">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4">
              <div>
                <h2 class="text-sm font-semibold">注册用户</h2>
                <p id="users-total" class="mt-1 text-xs text-ink-muted">—</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <select id="users-type" class="rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary">
                  <option value="all">全部用户</option>
                  <option value="pro">仅付费用户</option>
                  <option value="free">仅免费用户</option>
                </select>
                <input
                  id="users-search"
                  type="search"
                  placeholder="搜索邮箱或昵称"
                  class="w-44 rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary sm:w-56"
                />
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="bg-surface-2/60 text-xs text-ink-muted">
                  <tr>
                    <th class="px-4 py-2.5 font-medium">用户</th>
                    <th class="px-4 py-2.5 font-medium">注册时间</th>
                    <th class="px-4 py-2.5 font-medium">类型</th>
                    <th class="px-4 py-2.5 font-medium">Pro 到期</th>
                    <th class="px-4 py-2.5 text-right font-medium">累计支付</th>
                  </tr>
                </thead>
                <tbody id="users-body" class="divide-y divide-border"></tbody>
              </table>
            </div>
            <div id="users-pager" class="flex items-center justify-between gap-3 border-t border-border px-4 py-3 text-xs text-ink-muted"></div>
          </div>
        </section>

        <!-- 付费记录 -->
        <section id="tab-payments" hidden class="space-y-4">
          <!-- 付费按钮点击 -->
          <div class="rounded-2xl border border-border bg-surface">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4">
              <div class="min-w-0">
                <h2 class="text-sm font-semibold">付费按钮点击</h2>
                <p class="mt-1 text-xs text-ink-muted">
                  只统计登录后的点击；匿名点击会先跳登录，不计入
                </p>
              </div>
              <div class="flex items-center gap-2">
                <select
                  id="paywall-days"
                  class="rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary"
                >
                  <option value="7">近 7 天</option>
                  <option value="30" selected>近 30 天</option>
                  <option value="90">近 90 天</option>
                  <option value="0">全部</option>
                </select>
                <button
                  id="paywall-refresh"
                  type="button"
                  class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-ink-secondary transition hover:border-primary hover:text-primary disabled:cursor-not-allowed disabled:opacity-60"
                >
                  刷新
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
              <div class="bg-surface p-4">
                <div class="text-[11px] text-ink-muted">总点击次数</div>
                <div id="paywall-kpi-clicks" class="mt-1 text-2xl font-semibold tabular-nums">—</div>
              </div>
              <div class="bg-surface p-4">
                <div class="text-[11px] text-ink-muted">点击人数</div>
                <div id="paywall-kpi-people" class="mt-1 text-2xl font-semibold tabular-nums">—</div>
              </div>
              <div class="bg-surface p-4">
                <div class="text-[11px] text-ink-muted">其中已付费</div>
                <div id="paywall-kpi-paid" class="mt-1 text-2xl font-semibold tabular-nums">—</div>
              </div>
              <div class="bg-surface p-4">
                <div class="text-[11px] text-ink-muted">最近点击</div>
                <div id="paywall-kpi-last" class="mt-1 text-sm font-medium text-ink">—</div>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full min-w-[720px] text-left text-sm">
                <thead class="bg-surface-2/60 text-xs text-ink-muted">
                  <tr>
                    <th class="px-4 py-2.5 font-medium">按钮</th>
                    <th class="px-4 py-2.5 font-medium">点击次数</th>
                    <th class="px-4 py-2.5 text-right font-medium">人数</th>
                    <th class="px-4 py-2.5 font-medium">最近一次</th>
                  </tr>
                </thead>
                <tbody id="paywall-buttons-body" class="divide-y divide-border"></tbody>
              </table>
            </div>
          </div>

          <!-- 点击过的人 -->
          <div class="rounded-2xl border border-border bg-surface">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4">
              <div>
                <h2 class="text-sm font-semibold">点击过的人</h2>
                <p id="paywall-people-total" class="mt-1 text-xs text-ink-muted">—</p>
              </div>
              <input
                id="paywall-people-search"
                type="search"
                placeholder="搜索邮箱或昵称"
                class="w-44 rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary sm:w-56"
              />
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[980px] text-left text-sm">
                <thead class="bg-surface-2/60 text-xs text-ink-muted">
                  <tr>
                    <th class="px-4 py-2.5 font-medium">人</th>
                    <th class="px-4 py-2.5 font-medium">身份</th>
                    <th id="paywall-col-month-auto" class="px-4 py-2.5 text-right font-medium">月付 · 自动续费</th>
                    <th id="paywall-col-month-once" class="px-4 py-2.5 text-right font-medium">月付 · 一次性</th>
                    <th id="paywall-col-year-auto" class="px-4 py-2.5 text-right font-medium">年付 · 自动续费</th>
                    <th id="paywall-col-year-once" class="px-4 py-2.5 text-right font-medium">年付 · 一次性</th>
                    <th class="px-4 py-2.5 text-right font-medium">合计</th>
                    <th class="px-4 py-2.5 font-medium">最近</th>
                  </tr>
                </thead>
                <tbody id="paywall-people-body" class="divide-y divide-border"></tbody>
              </table>
            </div>
            <div
              id="paywall-people-pager"
              class="flex items-center justify-between gap-3 border-t border-border px-4 py-3 text-xs text-ink-muted"
            ></div>
          </div>

          <div class="rounded-2xl border border-border bg-surface">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4">
              <div>
                <h2 class="text-sm font-semibold">付费记录</h2>
                <p id="payments-total" class="mt-1 text-xs text-ink-muted">—</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <select id="payments-status" class="rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary">
                  <option value="">全部状态</option>
                  <option value="paid">已支付</option>
                  <option value="refunded">已退款</option>
                  <option value="failed">支付失败</option>
                </select>
                <input
                  id="payments-search"
                  type="search"
                  placeholder="搜索邮箱或订单号"
                  class="w-44 rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary sm:w-56"
                />
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[880px] text-left text-sm">
                <thead class="bg-surface-2/60 text-xs text-ink-muted">
                  <tr>
                    <th class="px-4 py-2.5 font-medium">用户</th>
                    <th class="px-4 py-2.5 font-medium">方案</th>
                    <th class="px-4 py-2.5 text-right font-medium">金额</th>
                    <th class="px-4 py-2.5 font-medium">状态</th>
                    <th class="px-4 py-2.5 font-medium">时间</th>
                    <th class="px-4 py-2.5 font-medium">订单号</th>
                  </tr>
                </thead>
                <tbody id="payments-body" class="divide-y divide-border"></tbody>
              </table>
            </div>
            <div id="payments-pager" class="flex items-center justify-between gap-3 border-t border-border px-4 py-3 text-xs text-ink-muted"></div>
          </div>
        </section>

        <!-- 每日情报 -->
        <section id="tab-daily" hidden class="space-y-4">
          <div class="rounded-2xl border border-border bg-surface p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h2 class="text-sm font-semibold">采集与成稿</h2>
                <p class="mt-1 text-xs leading-relaxed text-ink-secondary">
                  全部在 GitHub Actions 上执行，本地不跑。本机到 reddit、bbc 等源不通，采出来会悄悄少几十条，而且不报错，只体现为当天头条变差。
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <input
                  id="daily-date"
                  type="date"
                  class="rounded-lg border border-border bg-surface px-2 py-1.5 text-xs text-ink"
                  aria-label="期号，留空为今天"
                />
                <button type="button" id="daily-run-fetch" class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium">采集</button>
                <button type="button" id="daily-run-build" class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium">成稿</button>
                <button type="button" id="daily-run-publish" class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium">采集→成稿→入库</button>
                <button type="button" id="daily-refresh" class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium">刷新</button>
              </div>
            </div>
            <p id="daily-status" class="mt-3 text-xs text-ink-muted">最近一次运行：读取中…</p>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-border bg-surface">
            <table class="w-full min-w-[720px]">
              <thead class="bg-muted text-xs text-ink-muted">
                <tr>
                  <th class="px-2 py-2 text-left font-medium">期号</th>
                  <th class="px-2 py-2 font-medium">头条</th>
                  <th class="px-2 py-2 font-medium">能用</th>
                  <th class="px-2 py-2 font-medium">钱</th>
                  <th class="px-2 py-2 font-medium">能做</th>
                  <th class="px-2 py-2 font-medium">合计</th>
                  <th class="px-2 py-2 text-left font-medium">头条两条</th>
                </tr>
              </thead>
              <tbody id="daily-list">
                <tr><td colspan="7" class="px-3 py-6 text-center text-xs text-ink-muted">读取中…</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- 榜单版本 -->
        <section id="tab-boards" hidden class="space-y-4">
          <div class="rounded-2xl border border-border bg-surface p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h2 class="text-sm font-semibold">数据源</h2>
                <p class="mt-1 text-xs leading-relaxed text-ink-secondary">
