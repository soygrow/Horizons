                    <th class="px-3 py-2 font-medium">模型</th>
                    <th class="px-3 py-2 font-medium">厂商</th>
                    <th class="px-3 py-2 text-right font-medium">能力分</th>
                    <th class="px-3 py-2 text-right font-medium">综合分</th>
