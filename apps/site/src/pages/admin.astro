        <!-- 模型榜：采集完整榜发布，没有候选池，只有线上明细 + 触发同步 -->
        <section id="tab-models" hidden class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
