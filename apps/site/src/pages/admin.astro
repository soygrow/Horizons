              <div id="mdl-kpi-total" class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">—</div>
              <div id="mdl-kpi-total-sub" class="mt-2 text-xs text-ink-secondary">—</div>
            </article>

            <article class="rounded-2xl border border-border bg-surface p-5">
