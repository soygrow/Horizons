                <p id="gh-staging-meta" class="mt-1 text-xs text-ink-muted">—</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <select id="gh-staging-filter" class="rounded-lg border border-border bg-surface-2 px-2.5 py-1.5 text-xs text-ink outline-none focus:border-primary">
                  <option value="all">全部</option>
                  <option value="new">新候选</option>
                  <option value="board">在榜刷新</option>
                  <option value="rejected">已拒绝</option>
                </select>
                <input
                  id="gh-staging-search"
