---
import Base from "../layouts/Base.astro";
import SearchInput from "../components/SearchInput.astro";
import BoardSection from "../components/BoardSection.astro";
import ToolRowCompact from "../components/ToolRowCompact.astro";
import RepoRowCompact from "../components/RepoRowCompact.astro";
import TrendRowCompact from "../components/TrendRowCompact.astro";
import { homeData, toolRows, repoRows, trendRows, trendFilters } from "../lib/dataset";
import { homePicks, ROTATION_DAYS, PICKS_PER_BOARD } from "../lib/home-picks";
import { formatDateShort } from "../lib/format";

const { stats } = homeData;

// 三个板块直接吃同一份榜单数据：数据一变，下面的数字与抽样结果同步变化
const picks = homePicks({ tools: toolRows, repos: repoRows, trends: trendRows });

const toolsUpdatedAt = toolRows
  .map((r) => r.collectedAt)
  .sort()
  .at(-1);
const githubUpdatedAt = stats.githubUpdatedAt;
const trendsUpdatedAt = trendFilters.updatedAt;

/** 首屏三张榜单的规模（数值全部来自榜单数据本身） */
const boards = [
  {
    label: "AI 工具榜",
    href: "/tools",
    count: stats.tools,
    unit: "个 AI 工具",
    updated: toolsUpdatedAt,
  },
  {
    label: "GitHub 榜",
    href: "/github",
    count: stats.repos,
    unit: "个开源项目",
    updated: githubUpdatedAt,
  },
  {
    label: "AI 趋势词榜",
    href: "/trends",
    count: stats.trends,
    unit: "个趋势词",
    updated: trendsUpdatedAt,
  },
];

/** 趋势词名次：trendRows 已按趋势强度排序，下标 + 1 即真实名次 */
const trendRank = new Map(trendRows.map((r, i) => [r.slug, i + 1]));

const sampleNote = `名次 10 名以后随机抽样 ${PICKS_PER_BOARD} 条 · 每 ${ROTATION_DAYS} 天换一批`;

const title = "Horizons — 越过地平线，找到还没被抢走的机会";
const description =
  "地平线之外，藏着还没被抢走的机会。Horizons 把正在升温的 AI 工具、开源项目与趋势词整理成可追溯的榜单——先看见，再落地。";
---

<Base title={title} description={description}>
  <!-- Hero：地平线 -->
  <section class="relative overflow-hidden border-b border-border/60">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(72%_62%_at_50%_-6%,rgba(8,102,250,0.12),transparent)]"
    >
    </div>
    <!-- 装饰：极淡网格（向四周淡出，给大字留出呼吸感） -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(to right, rgba(12,31,80,0.055) 1px, transparent 1px), linear-gradient(to bottom, rgba(12,31,80,0.055) 1px, transparent 1px); background-size: 76px 76px; mask-image: radial-gradient(56% 52% at 50% 34%, black, transparent 76%); -webkit-mask-image: radial-gradient(56% 52% at 50% 34%, black, transparent 76%);"
    >
    </div>
    <!-- 装饰：同心圆，圆心落在标题上方，营造「地平线」纵深 -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-[-15rem] -translate-x-1/2 sm:top-[-19rem]"
    >
      <div class="aspect-square w-[62rem] rounded-full border border-primary/[0.05]"></div>
      <div
        class="absolute inset-0 m-auto aspect-square w-[42rem] rounded-full border border-primary/[0.055]"
      >
      </div>
      <div
        class="absolute inset-0 m-auto aspect-square w-[26rem] rounded-full border border-primary/[0.06]"
      >
      </div>
    </div>
    <!-- 地平线：底部光带 + 品牌渐变亮线（与 logo 穹顶同色） -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-[linear-gradient(to_top,rgba(112,63,244,0.10),transparent)]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px]"
      style="background-image: var(--brand-gradient); mask-image: linear-gradient(to right, transparent, black 22%, black 78%, transparent);"
    >
    </div>

    <div
      class="relative mx-auto flex min-h-[calc(100svh-4rem)] max-w-6xl flex-col justify-center px-4 pb-12 pt-10 text-center sm:px-6"
    >
      <h1
        class="mx-auto max-w-4xl text-[1.75rem] font-bold leading-[1.2] tracking-tight text-ink sm:text-[3.25rem] sm:leading-[1.18]"
      >
        越过地平线，<br />
        <span
          class="bg-clip-text text-transparent"
          style="background-image: linear-gradient(100deg, #0866fa 0%, #5b3cf3 55%, #703ff4 100%);"
          >看见还没被抢走的机会</span
        >
      </h1>

      <p
        class="mx-auto mt-7 max-w-2xl text-sm leading-[1.8] text-ink-secondary sm:mt-8 sm:text-[17px]"
      >
        地平线之外，藏着还没被抢走的机会。Horizons 把正在升温的 AI 工具、开源项目与趋势词整理成可追溯的榜单——先看见，再落地。
      </p>

      <div class="mt-8 flex justify-center sm:mt-10">
        <SearchInput
          size="lg"
          value=""
          placeholder="地平线之外，有什么正在升温？例如：AI 视频生成"
        />
      </div>

      <!-- 从看见到落地 -->
      <ol
        class="mx-auto mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[10px] text-ink-muted sm:mt-9 sm:gap-x-7 sm:text-xs"
      >
        {
          [
            ["01", "看见正在升温的热点"],
            ["02", "找到已被验证的点"],
            ["03", "按方向落地执行"],
          ].map(([no, text], i) => (
            <>
              <li class="flex items-center gap-1.5">
                <span class="font-mono text-[9px] text-ink-muted/70 sm:text-[10px]">{no}</span>
                {text}
              </li>
              {i < 2 && (
                <li aria-hidden="true" class="hidden text-ink-muted/40 sm:block">
                  →
                </li>
              )}
            </>
          ))
        }
      </ol>

      <!-- 三张榜单的实时规模（榜单数据变化 → 这里同步变化） -->
      <div class="mx-auto mt-10 flex items-start justify-center divide-x divide-border sm:mt-12">
        {
          boards.map((b) => (
            <a
              href={b.href}
              aria-label={`${b.label}：${b.count} ${b.unit}`}
              class="group px-5 text-center sm:px-11"
            >
              <div class="text-[1.75rem] font-bold leading-none tracking-tight text-ink tabular-nums transition duration-200 group-hover:text-primary sm:text-[2.25rem]">
                {b.count}
              </div>
              <div class="mt-2 whitespace-nowrap text-[11px] text-ink-secondary sm:mt-2.5 sm:text-xs">
                {b.unit}
              </div>
              <div class="mt-1 text-[10px] tabular-nums text-ink-muted/80 sm:text-[11px]">
                {formatDateShort(b.updated)}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="mt-8 text-center text-xs text-ink-muted sm:text-left">{sampleNote}</p>

    <!-- 榜单顺序 = 导航栏顺序：AI 工具榜 → GitHub 榜 → AI 趋势词榜 -->
    <BoardSection
      title="AI 工具榜"
      subtitle="按综合得分排序：热度、流量、增长与付费能力加权，每条都能追到数据来源与采集日期"
      meta={`共 ${stats.tools} 个工具`}
      viewAllHref="/tools"
    >
      {
        picks.tools.map((tool) => (
          <ToolRowCompact tool={tool} rank={tool.rank} />
        ))
      }
    </BoardSection>

    <BoardSection
      title="GitHub 榜"
      subtitle="按「做成一款有收益产品的可能性」排序：不看 star 数量堆叠，只看能不能变成生意"
      meta={`共 ${stats.repos} 个开源项目`}
      viewAllHref="/github"
    >
      {picks.repos.map((repo) => <RepoRowCompact repo={repo} />)}
    </BoardSection>

    <BoardSection
      title="AI 趋势词榜单"
      subtitle="按趋势强度排序：标注为什么在升温、可信度多高、现在可以做哪个方向"
      meta={`共 ${stats.trends} 个趋势词`}
      viewAllHref="/trends"
    >
      {
        picks.trends.map((trend, i) => (
          <TrendRowCompact trend={trend} rank={trendRank.get(trend.slug) ?? i + 1} />
        ))
      }
    </BoardSection>
  </div>
</Base>