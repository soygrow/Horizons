---
/**
 * 新采集结果页：一次采集的全部字段（docs/18-AI工具字段采集方案.md）。
 *
 * 故意做成独立页面而不是塞进后台 tab：
 *   1. 这是一张「对表」用的验收单，72 行 + 两张截图，塞进 tab 里既挤又慢；
 *   2. 采集是异步的（GitHub Actions 跑 2~5 分钟），单独一页可以只在需要时打开、并自己轮询；
 *   3. 这个页面不依赖后台其余面板的状态，删掉整条新采集链路时只需删这一个页面。
 *
 * 数据来自 /api/fc/:id（公开只读，见 apps/api/src/routes/fc.ts）：这个链接要能直接
 * 复制出去、换个浏览器或手机打开；早前只走 /api/admin/... 时，Cookie 一过期就只剩
 * 「需要先登录后台」，看上去就像「点了查看字段什么也没有」。取不到时仍回退一次后台接口。
 * 页面本身静态，所以 build 阶段不会去读 D1，采集记录晚于部署上线也不影响。
 */
import Base from "../layouts/Base.astro";

const title = "新采集结果 · Horizons";
const description = "按 docs/18-AI工具字段采集方案.md 采集的单个网站字段明细，用于验证采集方案覆盖度。";
---

<Base {title} {description} noindex>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-medium tracking-[0.2em] text-ink-muted">新采集 · 字段采集验证</p>
        <h1 id="fc-name" class="mt-2 truncate text-xl font-semibold tracking-tight text-ink sm:text-2xl">加载中…</h1>
        <p id="fc-url" class="mt-1 truncate text-xs text-ink-muted"></p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button
          id="fc-reload"
          type="button"
          class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-ink-secondary transition hover:border-primary hover:text-primary"
        >
          刷新
        </button>
        <a
          href="/admin#newcollect"
          class="rounded-lg bg-primary px-3 py-1.5 text-xs font-medium text-white transition hover:opacity-90"
        >
          回到新采集
        </a>
      </div>
    </div>

    <div id="fc-message" class="mt-6 rounded-xl border border-border bg-surface p-4 text-sm text-ink-secondary"></div>

    <div id="fc-content" class="mt-6 hidden space-y-6">
      <div class="rounded-2xl border border-border bg-surface p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-baseline gap-2">
            <span id="fc-filled" class="text-2xl font-semibold text-ink">—</span>
            <span id="fc-total" class="text-sm text-ink-muted">/ —</span>
            <span id="fc-state" class="ml-2 rounded-full bg-surface-2 px-2 py-0.5 text-[11px] text-ink-secondary"></span>
          </div>
          <div id="fc-meta" class="text-[11px] leading-relaxed text-ink-muted"></div>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-surface-2">
          <div id="fc-bar" class="h-full rounded-full bg-primary transition-all" style="width: 0%"></div>
        </div>
        <div id="fc-groups" class="mt-3 flex flex-wrap gap-2 text-[11px] text-ink-muted"></div>
        <p id="fc-step" class="mt-3 hidden text-xs text-primary"></p>
      </div>

      <div id="fc-shots" class="grid gap-4 sm:grid-cols-2"></div>

      <div id="fc-fields" class="space-y-4"></div>

      <div id="fc-sources" class="hidden rounded-2xl border border-border bg-surface">
        <div class="border-b border-border p-4">
          <h2 class="text-sm font-semibold">数据源执行情况</h2>
          <p class="mt-1 text-xs text-ink-muted">失败的数据源只影响它负责的字段；这里列出耗时与错误原文。</p>
        </div>
        <div id="fc-sources-body" class="divide-y divide-border/60"></div>
      </div>

      <details class="rounded-2xl border border-border bg-surface p-4">
        <summary class="cursor-pointer text-sm font-medium text-ink-secondary">原始 JSON（字段值 + 抓取快照）</summary>
        <pre
          id="fc-raw"
          class="mt-3 max-h-[480px] overflow-auto rounded-lg bg-surface-2 p-3 text-[11px] leading-relaxed text-ink-secondary"
        ></pre>
      </details>
    </div>
  </section>

  <script>
    type FieldStatus = "ok" | "missing" | "error";

    interface FieldResult {
      key: string;
      label: string;
      group: string;
      method: string;
      api: string;
      paid: boolean;
      value: unknown;
      display: string;
      status: FieldStatus;
      actualSource?: string;
      note?: string;
    }

    interface GroupSummary {
      key: string;
      name: string;
      total: number;
      filled: number;
    }

    interface Payload {
      url: string;
      domain: string;
      requestedAt: string;
      collectedAt: string;
      durationMs: number;
      fields: FieldResult[];
      coverage: { total: number; filled: number; missing: number; error: number; groups: GroupSummary[] };
      screenshots: { desktop: string | null; mobile: string | null };
      sources: { name: string; ok: boolean; ms: number; error?: string }[];
      raw?: unknown;
    }

    interface RunDetail {
      id: string;
      url: string;
      domain: string;
      status: string;
      step: string | null;
      filled: number;
      total: number;
      error: string | null;
      createdAt: number;
      updatedAt: number;
      runUrl: string | null;
      result: Payload | null;
    }

    const STATUS_TEXT: Record<string, string> = {
      queued: "排队中",
      running: "采集中",
      success: "已完成",
      failure: "采集失败",
      cancelled: "已取消",
    };

    const GROUP_ORDER = ["basic", "launch", "traffic", "channels", "seo", "product"];

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

    function esc(value: unknown): string {
      return String(value ?? "").replace(/[&<>"']/g, (ch) =>
        ch === "&" ? "&amp;" : ch === "<" ? "&lt;" : ch === ">" ? "&gt;" : ch === '"' ? "&quot;" : "&#39;",
      );
    }

    function fmtTime(v: string | number | null | undefined): string {
      const t = typeof v === "string" ? Date.parse(v) : v;
      if (typeof t !== "number" || !Number.isFinite(t) || t <= 0) return "—";
      const d = new Date(t);
      const p = (n: number) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
    }

    function fmtDuration(ms: number): string {
      if (!Number.isFinite(ms) || ms <= 0) return "—";
      const s = Math.round(ms / 1000);
      return s < 60 ? `${s} 秒` : `${Math.floor(s / 60)} 分 ${s % 60} 秒`;
    }

    function showMessage(text: string, tone: "muted" | "error" = "muted"): void {
      const el = $("fc-message");
      if (!el) return;
      el.hidden = false;
      el.textContent = text;
      el.className =
        tone === "error"
          ? "mt-6 rounded-xl border border-danger/40 bg-danger-soft p-4 text-sm text-danger"
          : "mt-6 rounded-xl border border-border bg-surface p-4 text-sm text-ink-secondary";
    }

    const id = new URLSearchParams(location.search).get("id");
    let timer: number | null = null;

    function stopPoll(): void {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function statusCell(f: FieldResult): string {
      if (f.status === "ok") return `<span class="text-success">已采到</span>`;
      if (f.status === "error") return `<span class="text-danger">采集失败</span>`;
      return `<span class="text-ink-muted">未采集</span>`;
    }

    function fieldRow(f: FieldResult): string {
      const valueText =
        f.status === "ok"
          ? `<span class="break-words text-ink">${esc(f.display)}</span>`
          : `<span class="text-ink-muted">—</span>`;
      const note = f.note ? `<div class="mt-1 text-[11px] leading-relaxed text-ink-muted">${esc(f.note)}</div>` : "";
      const source = f.actualSource
        ? `<div class="text-[11px] text-ink-secondary">${esc(f.actualSource)}</div>`
        : `<div class="text-[11px] text-ink-muted">按文档来源</div>`;
      const paid = f.paid ? `<span class="ml-1 rounded bg-surface-2 px-1 text-[10px] text-ink-muted">付费</span>` : "";

      return `<tr class="border-t border-border/60 align-top">
        <td class="w-[168px] px-3 py-2">
          <div class="text-xs font-medium text-ink-secondary">${esc(f.label)}</div>
          <div class="mt-0.5 break-all text-[10px] text-ink-muted">${esc(f.api)}${paid}</div>
        </td>
        <td class="px-3 py-2 text-sm">${valueText}${note}</td>
        <td class="w-[200px] px-3 py-2">
          ${source}
          <div class="mt-0.5 text-[10px] text-ink-muted">文档来源：${esc(f.method)}</div>
        </td>
        <td class="w-[84px] px-3 py-2 text-right text-xs">${statusCell(f)}</td>
      </tr>`;
    }

    function groupCard(g: GroupSummary, fields: FieldResult[]): string {
      const pct = g.total ? Math.round((g.filled / g.total) * 100) : 0;
      const rows = fields.filter((f) => f.group === g.key);
      return `<div class="rounded-2xl border border-border bg-surface">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border p-4">
          <h2 class="text-sm font-semibold">${esc(g.name)}</h2>
          <span class="text-xs text-ink-muted">
            <span class="${pct === 100 ? "text-success" : pct === 0 ? "text-danger" : "text-ink"} font-medium">${g.filled}/${g.total}</span>
            · ${pct}%
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] text-left">
            <thead class="bg-surface-2/60 text-[11px] uppercase tracking-wide text-ink-muted">
              <tr>
                <th class="px-3 py-2 font-medium">字段</th>
                <th class="px-3 py-2 font-medium">采集值</th>
                <th class="px-3 py-2 font-medium">实际来源</th>
                <th class="px-3 py-2 text-right font-medium">状态</th>
              </tr>
            </thead>
            <tbody>${rows.map(fieldRow).join("")}</tbody>
          </table>
        </div>
      </div>`;
    }

    function shotCard(label: string, hint: string, src: string | null): string {
      const inner = src
        ? `<a href="${esc(src)}" target="_blank" rel="noreferrer">
             <img src="${esc(src)}" alt="${esc(label)}" loading="lazy"
                  class="max-h-[420px] w-full rounded-lg border border-border object-cover object-top" />
           </a>`
        : `<div class="flex h-[220px] items-center justify-center rounded-lg border border-dashed border-border text-xs text-ink-muted">未生成截图</div>`;
      return `<div class="rounded-2xl border border-border bg-surface p-4">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-sm font-semibold">${esc(label)}</h2>
          <span class="text-[11px] text-ink-muted">${esc(hint)}</span>
        </div>
        ${inner}
      </div>`;
    }

    function render(run: RunDetail): void {
      const payload = run.result;
      const name = $("fc-name");
      const urlEl = $("fc-url");
      if (name) name.textContent = payload?.domain || run.domain;
      if (urlEl) urlEl.textContent = payload?.url || run.url;

      const content = $("fc-content");
      if (content) content.hidden = false;

      if (!payload) {
        showMessage(
          run.status === "failure"
            ? `采集失败：${run.error ?? "未知错误"}${run.runUrl ? `（日志：${run.runUrl}）` : ""}`
            : `采集${STATUS_TEXT[run.status] ?? run.status}…${run.step ? ` 当前步骤：${run.step}` : ""}`,
          run.status === "failure" ? "error" : "muted",
        );
        return;
      }

      showMessage("");
      const msg = $("fc-message");
      if (msg) msg.hidden = true;

      const cov = payload.coverage;
      $("fc-filled")!.textContent = String(cov.filled);
      $("fc-total")!.textContent = `/ ${cov.total}`;
      $("fc-state")!.textContent = STATUS_TEXT[run.status] ?? run.status;
      $("fc-bar")!.style.width = `${cov.total ? Math.round((cov.filled / cov.total) * 100) : 0}%`;
      $("fc-meta")!.innerHTML = [
        `采集耗时 ${fmtDuration(payload.durationMs)}`,
        `完成于 ${fmtTime(payload.collectedAt)}`,
        `缺失 ${cov.missing} · 失败 ${cov.error}`,
      ]
        .map((t) => `<div>${esc(t)}</div>`)
        .join("");

      $("fc-groups")!.innerHTML = cov.groups
        .map(
          (g) =>
            `<span class="rounded-full bg-surface-2 px-2 py-0.5">${esc(g.name)} <span class="${g.filled === g.total ? "text-success" : g.filled === 0 ? "text-danger" : "text-ink"}">${g.filled}/${g.total}</span></span>`,
        )
        .join("");

      // 采集中：把当前步骤挂出来，人不用去 Actions 日志里翻
      const stepEl = $("fc-step");
      if (stepEl) {
        if (run.status === "running" || run.status === "queued") {
          stepEl.hidden = false;
          stepEl.textContent = `采集中：${run.step ?? "排队中"}`;
        } else {
          stepEl.hidden = true;
        }
      }

      $("fc-shots")!.innerHTML =
        shotCard("PC 截图", "1280 × 800", payload.screenshots.desktop) +
        shotCard("手机截图", "390 × 844", payload.screenshots.mobile);

      const fieldsEl = $("fc-fields")!;
      fieldsEl.innerHTML = [...cov.groups]
        .sort((a, b) => GROUP_ORDER.indexOf(a.key) - GROUP_ORDER.indexOf(b.key))
        .map((g) => groupCard(g, payload.fields))
        .join("");

      const failed = payload.sources.filter((s) => !s.ok);
      const sourcesBox = $("fc-sources");
      if (sourcesBox && payload.sources.length) {
        sourcesBox.hidden = false;
        $("fc-sources-body")!.innerHTML = payload.sources
          .map(
            (s) => `<div class="flex flex-wrap items-start justify-between gap-2 px-4 py-2 text-xs">
              <div class="min-w-0">
                <span class="${s.ok ? "text-success" : "text-danger"}">${s.ok ? "OK" : "FAIL"}</span>
                <span class="ml-2 text-ink-secondary">${esc(s.name)}</span>
                ${s.error ? `<div class="mt-1 break-words text-[11px] text-ink-muted">${esc(s.error)}</div>` : ""}
              </div>
              <span class="shrink-0 text-ink-muted">${s.ms} ms</span>
            </div>`,
          )
          .join("");
        if (!failed.length) $("fc-sources-body")!.insertAdjacentHTML("afterbegin", "");
      }

      $("fc-raw")!.textContent = JSON.stringify(payload, null, 2);
    }

    async function load(): Promise<void> {
      if (!id) {
        showMessage("缺少采集 ID。请从后台「新采集」里点「查看字段」进入本页。");
        return;
      }
      // 先打公开只读接口（不依赖后台登录态，链接可以直接分享/换浏览器打开）；
      // 老链接如果还指着后台接口，下面就回退一次。
      let res: Response | null = null;
      try {
        res = await fetch(`/api/fc/${encodeURIComponent(id)}`, { cache: "no-store" });
      } catch {
        res = null;
      }
      if (!res || res.status >= 500) {
        try {
          res = await fetch(`/api/admin/field-collect/${encodeURIComponent(id)}`, {
            credentials: "same-origin",
            cache: "no-store",
          });
        } catch (e) {
          showMessage(`读取失败：${e instanceof Error ? e.message : String(e)}`, "error");
          return;
        }
      }

      try {
        if (res.status === 401) {
          showMessage("需要先登录后台。登录后回到本页刷新即可。", "error");
          return;
        }
        if (res.status === 404) {
          showMessage("没有这条采集记录（可能已被清理）。", "error");
          return;
        }
        if (!res.ok) {
          showMessage(`读取失败：HTTP ${res.status}`, "error");
          return;
        }
        const data = (await res.json()) as { run: RunDetail };
        if (!data.run) {
          showMessage("接口没有返回采集记录。", "error");
          return;
        }
        if (!data.run.result) {
          showMessage(
            data.run.status === "queued" || data.run.status === "running"
              ? "采集还在进行，完成后本页会自动刷新。"
              : `该记录没有字段结果${data.run.error ? `：${data.run.error}` : "（可能采集在写回前中断）"}`,
            data.run.error ? "error" : "muted",
          );
          return;
        }

        try {
          render(data.run);
        } catch (e) {
          // 渲染炸了就把原因显示出来，别留一个空白页让人猜
          showMessage(`字段渲染失败：${e instanceof Error ? e.message : String(e)}`, "error");
          const raw = $("fc-raw");
          if (raw) raw.textContent = JSON.stringify(data.run.result, null, 2);
          const content = $("fc-content");
          if (content) content.hidden = false;
          return;
        }

        stopPoll();
        if (data.run.status === "queued" || data.run.status === "running") {
          timer = window.setInterval(() => void load(), 5000);
        }
      } catch (e) {
        showMessage(`读取失败：${e instanceof Error ? e.message : String(e)}`, "error");
      }
    }

    $("fc-reload")?.addEventListener("click", () => void load());
    void load();
  </script>
</Base>