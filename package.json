{
  "name": "horizons",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @horizons/site dev",
    "dev:site": "pnpm --filter @horizons/site dev",
    "dev:api": "pnpm --filter @horizons/api dev",
    "build": "pnpm --filter @horizons/site run data && pnpm --filter @horizons/site build",
    "deploy": "bash scripts/deploy.sh",
    "deploy:site": "bash scripts/deploy.sh site",
    "deploy:api": "bash scripts/deploy.sh api",
    "d1": "pnpm --filter @horizons/api exec wrangler d1",
    "r2": "pnpm --filter @horizons/api exec wrangler r2",
    "wrangler": "pnpm --filter @horizons/api exec wrangler",
    "local": "bash scripts/serve-local.sh",
    "local:restart": "bash scripts/serve-local.sh --no-build",
    "local:stop": "bash scripts/serve-local.sh --stop",
    "fetch": "tsx scripts/admin/fetch-staging.ts",
    "fetch:dry": "tsx scripts/admin/fetch-staging.ts --dry",
    "audit": "tsx scripts/admin/audit-existing.ts",
    "audit:full": "tsx scripts/admin/audit-existing.ts --traffic --probe",
    "refresh": "tsx scripts/fetch/refresh.ts",
    "enrich": "tsx scripts/fetch/enrich.ts",
    "enrich:dry": "tsx scripts/fetch/enrich.ts --dry",
    "enrich:llm": "tsx scripts/fetch/enrich-llm.ts",
    "zh:staging": "tsx scripts/admin/translate-staging.ts",
    "enrich:models:zh": "tsx scripts/fetch/enrich-models-zh.ts",
    "screenshot": "tsx scripts/fetch/screenshot.ts",
    "ph:oauth": "tsx scripts/fetch/ph-oauth.ts",
    "trends:collect": "tsx scripts/fetch/trends/run.ts",
    "trends:probe": "tsx scripts/fetch/trends/run.ts --probe",
    "trends:dry": "tsx scripts/fetch/trends/run.ts --dry",
    "trends:rescore": "tsx scripts/fetch/trends/run.ts --rescore",
    "models:collect": "node scripts/collect/index.mjs",
    "models:dry": "node scripts/collect/index.mjs --dry",
    "models:list": "node scripts/collect/index.mjs --list",
    "models:refresh": "node scripts/collect/index.mjs && pnpm --filter @horizons/site data",
    "fetch:daily": "tsx scripts/fetch/daily/run.ts",
    "fetch:daily:dry": "tsx scripts/fetch/daily/run.ts --dry",
    "digest:daily": "tsx scripts/fetch/daily/build.ts",
    "digest:daily:dry": "tsx scripts/fetch/daily/build.ts --dry",
    "trends:enrich": "tsx scripts/admin/enrich-trends.ts",
    "trends:revert": "tsx scripts/admin/revert-trends.ts",
    "board:stats": "tsx scripts/admin/board-stats.ts",
    "board:stats:d1": "tsx scripts/admin/board-stats.ts --d1",
    "hydrate:models": "tsx scripts/admin/hydrate-models.ts",
    "hydrate:github": "tsx scripts/admin/hydrate-github.ts",
    "backfill:boards": "tsx scripts/admin/backfill-board-columns.ts"
  },
  "devDependencies": {
    "@horizons/shared": "workspace:*",
    "playwright": "^1.64.1",
    "tldts": "^7.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
