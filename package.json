{
  "name": "horizons",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @horizons/site dev",
    "dev:site": "pnpm --filter @horizons/site dev",
    "dev:web": "pnpm --filter @horizons/web dev",
    "build": "pnpm --filter @horizons/web build",
    "start": "pnpm --filter @horizons/web start",
    "lint": "pnpm --filter @horizons/web lint",
    "dev:api": "pnpm --filter @horizons/api dev",
    "deploy": "bash scripts/deploy.sh",
    "deploy:web": "bash scripts/deploy.sh web",
    "deploy:api": "bash scripts/deploy.sh api",
    "local": "bash scripts/serve-local.sh",
    "local:restart": "bash scripts/serve-local.sh --no-build",
    "local:stop": "bash scripts/serve-local.sh --stop",
    "fetch": "tsx scripts/fetch/index.ts",
    "fetch:dry": "tsx scripts/fetch/index.ts --dry",
    "refresh": "tsx scripts/fetch/refresh.ts",
    "enrich": "tsx scripts/fetch/enrich.ts",
    "enrich:dry": "tsx scripts/fetch/enrich.ts --dry",
    "enrich:llm": "tsx scripts/fetch/enrich-llm.ts",
    "screenshot": "tsx scripts/fetch/screenshot.ts",
    "ph:oauth": "tsx scripts/fetch/ph-oauth.ts",
    "trends:collect": "tsx scripts/fetch/trends/run.ts",
    "trends:dry": "tsx scripts/fetch/trends/run.ts --dry",
    "trends:rescore": "tsx scripts/fetch/trends/run.ts --rescore",
    "models:collect": "node scripts/collect/index.mjs",
    "models:dry": "node scripts/collect/index.mjs --dry",
    "models:list": "node scripts/collect/index.mjs --list",
    "models:refresh": "node scripts/collect/index.mjs && pnpm --filter @horizons/site data",
    "fetch:daily": "tsx scripts/fetch/daily/run.ts",
    "fetch:daily:dry": "tsx scripts/fetch/daily/run.ts --dry",
    "digest:daily": "tsx scripts/fetch/daily/build.ts",
    "digest:daily:dry": "tsx scripts/fetch/daily/build.ts --dry"
  },
  "devDependencies": {
    "@horizons/shared": "workspace:*",
    "playwright": "^1.64.1",
    "tldts": "^7.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
