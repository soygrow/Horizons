# 数据采集凭据（仅本地 / CI 抓取脚本使用，生产渲染不依赖）

# ---- Product Hunt ----
# Developer Token（可选，OAuth token 更优，能解析真实域名）
PH_TOKEN=
# OAuth 应用凭据（走授权码流程换取真实 website 域名）
PH_API_KEY=
PH_API_SECRET=
PH_REDIRECT_URI=

# ---- DataForSEO（流量估算 + 关键词，按次计费）----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- LLM 增强（DeepSeek：中文描述 / 分类 / 定价提取）----
DEEPSEEK_API_KEY=

# ---- AI 趋势词榜单采集（全部免费来源，仅本地运行）----
# 每次运行最多联网验证多少个词（采集频率开关，默认 80）
TRENDS_DAILY_BUDGET=80
# 同一个词至少间隔多少天才重新抓曲线（避免重复消耗限流额度）
TRENDS_REFRESH_DAYS=3
# 主地区；RSS 发现会额外扫描多地区
TRENDS_GEO=US
TRENDS_RSS_GEOS=US,GB,IN,CA,AU
# 可选：GitHub Token 可把搜索配额从 10 次/分提到 30 次/分
GITHUB_TOKEN=

# ---- Paddle 计费（apps/api 运行时；生产用 wrangler secret put 写入，不要提交真实值）----
# 环境：sandbox | production（拼错会静默回落到 sandbox）
# 生产部署时 wrangler.jsonc 的 vars 与 wrangler secret 都必须是 production 对应的值
PADDLE_ENV=sandbox
# Sandbox: pdl_sdbx_apikey_... / Live: pdl_live_apikey_...
PADDLE_API_KEY=
# 前端 Paddle.js 初始化用的 client-side token（Sandbox: test_... / Live: live_...）
# 两套环境不通用；未配置时 checkout 退化为跳转 checkout.url
PADDLE_CLIENT_TOKEN=
# Webhook 通知目标的 secret（pdl_ntfset_...），不是 API key
PADDLE_WEBHOOK_SECRET=
# Catalog 里的周期型价格 ID（pri_...），订阅必须用 recurring price
# 美元价：$20/月、$160/年（早期用户价，原价 $240/年）
PADDLE_PRICE_MONTH_USD=
PADDLE_PRICE_YEAR_USD=
# 人民币价：¥149/月、¥1,099/年；支付宝只对「CNY 定价商品 + 中国地址」展示，
# 这两个不配的话中国用户只能用卡/PayPal 付美元价。年付金额须 ≤ 1,600 CNY（Paddle 对支付宝订阅的上限）
PADDLE_PRICE_MONTH_CNY=
PADDLE_PRICE_YEAR_CNY=

# 一次性（不自动续费）价格 ID，必须是非循环 price（one-time）：
# $23（30 天）/ $180（365 天）/ ¥169 / ¥1,299
# 不配的话，页面上的「一次性」按钮会自动置灰，只能走自动续费
PADDLE_PRICE_MONTH_ONCE_USD=
PADDLE_PRICE_YEAR_ONCE_USD=
PADDLE_PRICE_MONTH_ONCE_CNY=
PADDLE_PRICE_YEAR_ONCE_CNY=

# ---- 工具榜抓取（本地 / GitHub Actions 运行；CI 里配 Repository secrets）----
# Apify Token：Similarweb 流量富化（近乎免费），未配置则跳过流量步骤
APIFY_TOKEN=
# 流量来源 actor：lergassy（默认，免费额度）| vortex
APIFY_PRIMARY=lergassy

# ---- 后台管理（/admin，仅站主本人；生产用 wrangler secret put 写入）----
# 密码哈希用 node apps/api/scripts/admin-password.mjs 生成，格式 pbkdf2$sha256$...
# 迭代次数必须 ≤ 100000（Cloudflare Workers WebCrypto 上限），脚本已固定
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
