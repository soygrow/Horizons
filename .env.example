# 数据采集凭据（仅本地 / CI 抓取脚本使用，生产渲染不依赖）

# ---- Product Hunt ----
# Developer Token（可选，OAuth token 更优，能解析真实域名）
PH_TOKEN=
# OAuth 应用凭据（走授权码流程换取真实 website 域名）
PH_API_KEY=
PH_API_SECRET=
PH_REDIRECT_URI=

# ---- DataForSEO（流量估算 + 关键词，按次计费）----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- LLM 增强（DeepSeek：中文描述 / 分类 / 定价提取）----
DEEPSEEK_API_KEY=

# ---- AI 趋势词榜单采集（全部免费来源，仅本地运行）----
# 每次运行最多联网验证多少个词（采集频率开关，默认 80）
TRENDS_DAILY_BUDGET=80
# 同一个词至少间隔多少天才重新抓曲线（避免重复消耗限流额度）
TRENDS_REFRESH_DAYS=3
# 主地区；RSS 发现会额外扫描多地区
TRENDS_GEO=US
TRENDS_RSS_GEOS=US,GB,IN,CA,AU
# 可选：GitHub Token 可把搜索配额从 10 次/分提到 30 次/分
GITHUB_TOKEN=
